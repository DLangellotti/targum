{%- set heading = {
  "texts": t("yours.page.your-targums", "Your targums"),
  "words": t("yours.page.your-words", "Your Words"),
  "phrases": t("yours.page.your-phrases", "Your Phrases"),
}[which] -%}
<!doctype html>
<html lang="{{ page_language|default('en') }}">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>{{ heading }} — targum</title>
{% include '_icons.html.j2' %}
<style>{{ asset('tokens.css') }}{{ asset('shared.css') }}{{ asset('chrome.css') }}{{ asset('words.css') }}{{ asset('library.css') }}{{ asset('yours.css') }}{% if which == 'texts' %}{{ asset('home.css') }}{{ asset('subs.css') }}{% endif %}</style>
{{ hebrew_face() }}
<script>{{ asset('keep.js') }}</script>
{#- The key, before anything that reads it (targum-internal#343). `building.js`, and
    the conversation's pill, the followed series and the palette in the nav, each read `window.TARGUM_KEY`
    once as they load; it was set in a script at the foot of the body, so on a local serve
    they held an empty key for the life of the page and the bell, the followed series and
    the chat list were refused. The hosted box has no key and was never affected. -#}
<script>window.TARGUM_KEY = "{{ token }}";</script>
</head>
{#- The lists, whole. `texts` is the shelf, which Learn holds the top of; `words` is
    Your Words, behind the account since 2026-09-11 — the words, the commonest words you
    may already know, and the phrases, on one page — and `phrases` the phrases alone.
    Same markup and the same scripts as anywhere else a row is drawn, so a row here and a
    row there cannot drift. -#}
<body class="yours">
{#- Your targums has its own place in the nav since 2026-09-24 (design.md §12, "The shelf
    says what a text is at a glance"). Your words and phrases are reached from the
    account, and a nav that lit Learn on them said the reader was somewhere they were not
    (2026-09-14). -#}
{% set here = 'texts' if which == 'texts' else 'yours' %}{% set title = heading %}
{% include '_nav.html.j2' %}
<script>{{ asset('building.js') }}</script>

<main id="page" hidden>
  {%- if which == 'texts' %}
  {#- Home (design.md §12, "Home is Your targums, and Continue leads it", 2026-10-08).
      Learn is gone and this is the first page after signing in: Continue at the top, the
      shelf under it in its tabs, and beside the shelf one text to try next and the way
      to upload. `home.js` draws the head, `yours.js` the shelf. -#}
  <section class="continue" id="continue" aria-labelledby="continue-head" hidden>
    <div class="continue-top">
      <h2 id="continue-head">{{ t("home.continue.head", "Continue") }}</h2>
      <p class="continue-note">{{ t("home.continue.note", "What you opened or uploaded, newest first") }}</p>
    </div>
    <ul class="continue-cards" id="continue-cards"></ul>
  </section>

  {#- A reader with nothing yet (the FirstRun boards): what will appear here, and under it
      the one to start with and the upload. -#}
  <p class="first-home" id="first-home" hidden>{{ t("home.empty", "Nothing here yet. What you open or upload appears here.") }}</p>

  <div class="home-grid">
  <div class="home-shelf">
  {#- The tabs, then the shelf (design.md §12, "Your targums has tabs", 2026-09-26). -#}
  {% set tab = 'recent' %}{% include '_yours_tabs.html.j2' %}

  <section class="panel" id="shelf-panel">
    {#- Sifting (2026-09-26): drawn by `yours.js` only on a shelf of six or more. -#}
    <div class="sift-shelf" id="sift-shelf" hidden>
      <div class="chips" id="status-chips" role="group" aria-label="{{ t("yours.sift.status", "Show") }}"></div>
      <input type="search" class="find" id="shelf-find" dir="auto" autocomplete="off" spellcheck="false"
        placeholder="{{ t("yours.sift.search", "Search your targums") }}" aria-label="{{ t("yours.sift.search", "Search your targums") }}">
      <label class="pick"><span>{{ t("yours.sift.order", "Order") }}</span>
        <select id="shelf-order">
          <option value="read">{{ t("yours.sift.by-read", "Last read") }}</option>
          <option value="added">{{ t("yours.sift.by-added", "Recently added") }}</option>
          <option value="easy">{{ t("yours.sift.by-easy", "Easiest") }}</option>
          <option value="known">{{ t("yours.sift.by-known", "Words you know") }}</option>
        </select>
      </label>
    </div>
    {#- Inside a series (2026-09-26): its name and the way back to the whole shelf. -#}
    <p class="in-series" id="in-series" hidden>
      <button type="button" class="series-back" id="series-back">{{ t("yours.series.back", "← All") }}</button>
      <bdi class="series-name" id="series-name"></bdi>
    </p>
    <p class="note" id="shelf-note"></p>
    <ul class="books shelf-rows shelf-cards" id="library-list"></ul>
    <p class="empty" id="shelf-empty" hidden></p>
  </section>

  {#- Subscriptions (design.md §12, "A subscription is the account's", 2026-10-09; board
      SubsTab): every subscription as a row, sorted into chips, the month's credits for the
      ones that build, and the series not yet taken under them. Drawn by `subs.js` when the
      tab is pressed; signed out, `follow.js` draws the browser's own list as before. -#}
  <section class="panel subs" id="subs-panel" hidden>
    <div class="sub-top">
      <div class="chips" id="subs-chips" role="group" aria-label="{{ t("subs.chips", "Show") }}" hidden></div>
      <p class="sub-credits" id="subs-credits" hidden></p>
    </div>
    <div class="sub-table" role="table" aria-label="{{ t("yours.tabs.subscriptions", "Subscriptions") }}">
      <div class="sub-head-row" id="subs-head" role="row" hidden>
        <span role="columnheader">{{ t("subs.col.name", "Subscribed to") }}</span>
        <span role="columnheader">{{ t("subs.col.latest", "Latest") }}</span>
        <span role="columnheader">{{ t("subs.col.every", "Comes out") }}</span>
        <span role="columnheader">{{ t("subs.col.month", "This month") }}</span>
      </div>
      <ul class="sub-rows" id="subs-rows"></ul>
    </div>
    <ul class="series" id="home-series" hidden></ul>
    <p class="empty" id="subs-empty" hidden>{{ t("subs.none", "You haven't subscribed to anything yet.") }}</p>
    <p class="said" id="subs-said" role="status" hidden></p>
    <div id="subs-offer"></div>
    <p class="note sub-foot">{{ t("subs.foot", "New ones go under Continue and come in one mail a day.") }} <a href="/library" data-home-link>{{ t("subs.foot.library", "Find more to subscribe to in the Library") }}</a></p>
  </section>
  </div>

  {#- One text to try next — or, for a reader with nothing yet, one to start with — and the
      way to upload. Learn's suggestion, kept when the rest of Learn went (2026-10-08). On
      a phone the upload stands under Continue and the suggestion under the shelf. -#}
  <aside class="home-side" aria-label="{{ t("home.side", "Something new") }}">
    <section class="try-next" id="try-next" hidden></section>
    <a class="upload-card" href="/add" data-home-link>
      <span class="upload-card-head"><svg class="upload-glyph" viewBox="0 0 16 16" aria-hidden="true" focusable="false"><path d="M8 3.5v9M3.5 8h9"/></svg>{{ t("home.upload.head", "Upload something to read") }}</span>
      <span class="upload-card-says">{{ t("home.upload.says", "Paste a link, drop a file, or bring a post") }}</span>
    </a>
  </aside>
  </div>

  <section class="panel trash" id="trash-panel" hidden>
    <h2>{{ t("yours.page.trash", "Trash") }}</h2>
    <p class="note">{{ t("yours.page.we-keep-these-for-seven-days", "We keep these for seven days.") }}</p>
    <ul class="books" id="trash-list"></ul>
  </section>
  {%- endif %}

  {%- if which in ('words', 'phrases') %}
  {#- The head of Your Words (board WordsDesk, 2026-10-08; design.md §12, "Your Words is
      reached from Your Progress, by stage", 2026-10-09): the way back to Your Progress,
      what the list adds up to in this language, and Words and Phrases as tabs. Filled by
      `lists.js` for the language the menu is on. -#}
  <div class="words-head">
    <a class="words-back" href="/progress" data-back>← {{ t("you.page.your-progress", "Your Progress") }}</a>
    <p class="words-summary" id="words-summary"></p>
    <nav class="tabs list-tabs" aria-label="{{ t("lists.work.words-or-phrases", "Words or phrases") }}">
      <a class="tab" href="/words" data-back{% if which == 'words' %} aria-current="page"{% endif %}>{{ t("lists.work.words", "Words") }} <span class="tab-count" id="count-words"></span></a>
      <a class="tab" href="/phrases" data-back{% if which == 'phrases' %} aria-current="page"{% endif %}>{{ t("lists.work.phrases", "Phrases") }} <span class="tab-count" id="count-phrases"></span></a>
    </nav>
  </div>
  {%- endif %}

  {%- if which == 'words' %}
  {#- What to work on (targum-internal#103). The words the reader flagged and never came
      back to: still learning, oldest first, twenty at most.

      Dmitry Z, 2026-09-16, on why a list like this is the thing worth paying for: "anki
      requires bookkeeping and discipline that I lack", and "anki srs is kinda dumb in the
      sense it doesnt really know what you get wrong beyond what you tell it". And, three
      minutes later, the constraint: "if smth gonna ping me or bother me like duolingo
      I'll fucking delete it".

      So it is pull and never push. Nothing here is scheduled, nothing is due, nothing is
      counted and nothing is sent. It is a view of rows that already exist, waiting when
      the reader arrives and silent when they do not.

      A reader with nothing to work on sees no fold at all — not an empty state and not an
      invitation. `lists.js` hides the section, which is why it starts hidden here. -#}
  <section class="panel work" id="work-on" hidden>
    <h2>{{ t("yours.page.what-to-work-on", "What to work on") }}</h2>
    {#- Two halves, one question (2026-09-18): the words, and the phrases — the ones kept
        from a text and the lines the conversation corrected, oldest first across both.
        The tabs are drawn only when both have rows. -#}
    <div class="tabs work-tabs" id="work-tabs" role="tablist" aria-label="{{ t("lists.work.words-or-phrases", "Words or phrases") }}" hidden>
      <button type="button" class="tab" role="tab" id="work-tab-words" data-work="words" aria-controls="work-rows" aria-selected="true">{{ t("lists.work.words", "Words") }}</button>
      <button type="button" class="tab" role="tab" id="work-tab-phrases" data-work="phrases" aria-controls="work-phrase-rows" aria-selected="false" tabindex="-1">{{ t("lists.work.phrases", "Phrases") }}</button>
    </div>
    <ul class="work-rows" id="work-rows" role="tabpanel" aria-labelledby="work-tab-words"></ul>
    <ul class="work-rows" id="work-phrase-rows" role="tabpanel" aria-labelledby="work-tab-phrases" hidden></ul>

    {#- One door out of the fold, at its foot (targum-internal#103).

        The rows have two answers each and no third: a row is where the reader says what
        they know, and twenty of anything else on it makes the list a console. This is
        the other thing a reader looking at these words might want — to meet them in a
        sentence rather than in a list — and one control for the sitting is the size that
        thought actually is.

        It opens the conversation with a line written and unsent. The press is not a
        send: the reader reads the line, edits it or does not, and presses Send with
        their own hand, which is the same rule every other door in the product obeys.
        Nothing here spends. -#}
    <p class="work-foot" id="work-foot" hidden>
      <button type="button" id="work-talk">{{ t("lists.work.talk-words", "Practise these words") }}</button>
        <button type="button" class="work-more" id="work-more" hidden><svg viewBox="0 0 16 16" width="14" height="14" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"><path d="M13 8a5 5 0 1 1-1.6-3.7"/><path d="M13 2.5v2.6h-2.6"/></svg> {{ t("lists.work.more", "Show others") }}</button>
    </p>
  </section>

  <section class="panel">
    <div class="list-controls">
      <h2><span id="words-title">{{ t("yours.page.your-words", "Your Words") }}</span></h2>
      {#- Which language the meanings are in. Drawn only for somebody who has meanings in
          more than one, the same way the language switcher is: a control with one answer
          in it is only a question nobody asked. -#}
      <div class="langs quiet" id="meaning-langs" role="tablist"
           aria-label="{{ t("yours.page.translations-in", "Translations in") }}" hidden></div>
      <input type="search" id="search" dir="auto" placeholder="{{ t("yours.page.search-a-word-or-a-meaning", "Search a word or a meaning") }}" spellcheck="false">
      {#- Which stage, as chips (board WordsDesk): to work on — steps 1 to 3 — then each
          step, known, and everything. They were a select. -#}
      <div class="chips stage-chips" id="stage-chips" role="group" aria-label="{{ t("yours.page.filter-by-how-well-you-know-them", "Filter by how well you know them") }}"></div>
      {#- Hidden until sync says there is an account to export from. Named by what
          comes out rather than "Export": two buttons that both said Export would have
          left the reader to find out which was which by pressing one. -#}
      <button type="button" id="export-words" hidden>{{ t("yours.page.csv", "CSV") }}</button>
      <button type="button" id="export-anki" hidden>{{ t("yours.page.anki", "Anki") }}</button>
    </div>
    <div class="table-wrap">
      <table class="rows" id="word-table">
        <thead>
          <tr>
            <th scope="col">{{ t("yours.page.word", "Word") }}</th>
            <th scope="col">{{ t("yours.page.meaning", "Meaning") }}</th>
            <th scope="col">{{ t("lists.column.stage", "Stage") }}</th>
            <th scope="col">{{ t("yours.page.kept", "Kept") }}</th>
          </tr>
        </thead>
        <tbody id="word-rows"></tbody>
      </table>
    </div>
    <p class="empty" id="words-empty" hidden></p>
    <button type="button" class="more" id="more" hidden></button>
  </section>

  {#- Words you may already know (targum-internal#245): the commonest words of modern
      Hebrew not on the ledger, a checkbox on each and one at the head, every check a real
      known word. It is the conversation's first exchange on a first visit (2026-09-11);
      afterwards it lives here. Drawn by `claim.js`, hidden until it has rows. -#}
  <section class="panel claim" id="claim-panel" hidden>
    <h2>{{ t("yours.page.words-you-may-already-know", "Words you may already know") }}</h2>
    <p class="note">{{ t("yours.page.the-commonest-words-of-modern-hebrew-that", "The most common Hebrew words not on your list yet. Check the ones you know and we'll show the next fifty.") }}</p>
    <div id="claim-body"></div>
  </section>
  {%- endif %}

  {#- Phrases are their own tab since Your Words has a head (§12, 2026-10-09); they stood
      under the words on this page too until then. -#}
  {%- if which == 'phrases' %}
  <section class="panel">
    <div class="list-controls">
      <h2><span id="phrases-title">{{ t("yours.page.your-phrases", "Your Phrases") }}</span></h2>
      <button type="button" id="export-phrases" hidden>{{ t("yours.page.csv", "CSV") }}</button>
    </div>
    <p class="note">{{ t("yours.page.phrases-stay-with-their-text", "Phrases stay with their text.") }}</p>
    <div id="phrase-list"></div>
    <p class="empty" id="phrases-empty" hidden>{{ t("yours.page.nothing-yet-drag-across-words-while-you", "Nothing yet. Drag across words to save a phrase.") }}</p>

    {#- The lines the conversation corrected (targum-internal#290), every one, newest
        first: the record, so no control on a row. The ones still to go over are in What
        to work on. Drawn by `lists.js`, hidden until there is one. -#}
    <h3 class="work-heading" id="rewrote-heading" hidden>{{ t("yours.page.lines-corrected-in-conversation", "Corrected in chat") }}</h3>
    <ul class="work-rows rewrote" id="rewrote-rows"></ul>
  </section>
  {%- endif %}

  {#- Your targums is a place in the nav since 2026-09-24; a way back to Learn at its foot
      was left from when it hung off Learn. The lists behind the account keep theirs. -#}
  {%- if which not in ('texts', 'words', 'phrases') %}
  <p><a class="back" href="/" data-back>{{ t("yours.page.your-targums", "Your targums") }}</a></p>
  {%- endif %}
</main>

{%- if which == 'texts' %}
{#- While the shelf is asked for, and when it could not be (2026-09-14): a page that stood
    blank until `/readers` answered, or said "Nothing here yet" to a reader with a shelf
    whose connection dropped, was saying the wrong thing. -#}
<p class="learn-waiting" id="home-waiting" role="status">{{ t("learn.page.opening-your-texts", "Opening your texts…") }}</p>
<section class="nothing" id="nothing" role="alert" hidden>
  <p class="lede">{{ t("learn.page.we-couldn-t-load-your-texts", "We couldn't load your texts.") }}</p>
  <p>{{ t("learn.page.reload-the-page-to-try-again-everything", "Reload the page to try again. Everything you've read is still here.") }}</p>
</section>
{%- else %}
<section class="nothing" id="nothing" hidden>
  <p class="lede">{{ t("yours.page.nothing-here-yet", "Nothing here yet.") }}</p>
  <p><a href="/library">{{ t("yours.page.find-something-in-the-library", "Find something in the Library.") }}</a></p>
</section>
{%- endif %}

{% include '_foot.html.j2' %}

<script>
window.TARGUM_KEY = "{{ token }}";
window.TARGUM_LANGUAGES = { {% for code, name in languages %}"{{ code }}": "{{ name }}"{% if not loop.last %}, {% endif %}{% endfor %} };
window.TARGUM_LIST = "{{ which }}";
{% if strings %}window.TARGUM_STRINGS = {{ strings|tojson }};
{% endif %}</script>
<script>{{ asset('strings.js') }}</script>
<script>{{ asset('charts.js') }}</script>
<script>{{ asset('lang.js') }}</script>
<script>{{ asset('vocab.js') }}</script>
<script>{{ asset('lists.js') }}</script>
<script>{{ asset('sync.js') }}</script>
<script>{{ asset('account.js') }}</script>
<script>{{ asset('covers.js') }}</script>
<script>{{ asset('playlist-menu.js') }}</script>
{%- if which == 'texts' %}
<script>{{ asset('subs.js') }}</script>
{%- endif %}
<script>{{ asset('shelf.js') }}</script>
{%- if which == 'words' %}
<script>{{ asset('claim.js') }}</script>
{%- endif %}
{%- if which == 'texts' %}
<script>{{ asset('home.js') }}</script>
{%- endif %}
<script>{{ asset('yours.js') }}</script>
</body>
</html>
