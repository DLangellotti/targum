<!doctype html>
<html lang="{{ source_language }}" dir="{{ page_direction }}">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ title }}</title>
{% include '_icons.html.j2' %}
<style>{{ asset('reader.css') }}</style>
{{ hebrew_face() }}
<script>{{ asset('theme.js') }}</script>
</head>
<body class="contents">
<header class="bar">
  {#- The mark holds the corner on its own: at this size the identity is the monogram,
      not the lockup, and the bar already carries the title beside it. -#}
  {#- The mark is the way back, the same as in a reader. -#}
  <a class="bar-brand" id="home" href="/" title="Your Learn page" aria-label="targum — Learn" hidden>
    <svg viewBox="20 12 56 72" aria-hidden="true" focusable="false">
      <rect x="20" y="12" width="22" height="62" rx="5" fill="currentColor"></rect>
      <rect x="54" y="22" width="22" height="62" rx="5" fill="var(--mark-accent)"></rect>
    </svg>
  </a>
  <span class="bar-brand" id="home-plain" role="img" aria-label="targum">
    <svg viewBox="20 12 56 72" aria-hidden="true" focusable="false">
      <rect x="20" y="12" width="22" height="62" rx="5" fill="currentColor"></rect>
      <rect x="54" y="22" width="22" height="62" rx="5" fill="var(--mark-accent)"></rect>
    </svg>
  </span>
  <div class="bar-title">
    <span>{{ title }}</span>
  </div>
  <div class="controls" dir="ltr">
    {%- if siblings %}
    {#- The same news at another level. One press, and the reader keeps their place in
        the issue rather than being sent back to the library to find the easy one. -#}
    <div class="group levels" role="group" aria-label="Level">
      {%- for other in siblings %}
      {%- if other.current %}
      <span class="level here" aria-current="page" title="Written for {{ other.figure }}">{{ other.name }}</span>
      {%- else %}
      <a class="level" href="../../{{ other.folder }}/reader/{{ sections[0].filename }}" title="Written for {{ other.figure }}">{{ other.name }}</a>
      {%- endif %}
      {%- endfor %}
    </div>
    {%- endif %}
    <div class="group">
      <button type="button" data-theme-toggle aria-label="Switch theme"></button>
    </div>
  </div>
</header>
<main id="reader">
  {#- The cover, where one has been drawn. This is the page somebody lands on when they
      open a book, and the one place in a reader with room for it. Inlined rather than
      fetched: a reader off a disk has nowhere to fetch from. -#}
  {% if cover %}<figure class="cover"><img src="{{ cover }}" alt=""></figure>{% endif %}
  <h1 class="heading" lang="{{ source_language }}" dir="{{ source_direction }}">{{ title|isolate(source_direction) }}</h1>
  {% if english %}<p class="english" lang="en" dir="ltr">{{ english }}</p>{% endif %}
  {% if document.author %}<p class="byline">{{ document.author }}</p>{% endif %}
  {#- The one primary action on the page, and until now there was none: a list of
      chapter titles with no verb on it, which the first alpha reader opened and then
      had "NO IDEA what to do next". The first chapter, or the one last opened. -#}
  <p class="start"><a id="start" href="{{ sections[0].filename }}" data-first="{{ sections[0].filename }}">Start reading</a></p>
  <ol class="toc" dir="{{ source_direction }}" data-document="{{ document.content_hash }}">
    {% for section in sections %}
    <li data-chapter="{{ section.number }}"><a href="{{ section.filename }}">{{ section.title }}</a> <span class="count">{{ counts[section.number] }} {{ 'sentence' if counts[section.number] == 1 else 'sentences' }}</span></li>
    {% endfor %}
  </ol>
  {#- For somebody about to lose their connection. A reader off a disk is the promise
      this product makes, and half a translated book is not that. -#}
  <p class="whole" hidden><button type="button" id="prepare">Prepare all</button></p>
</main>
<script>{{ asset('contents.js') }}</script>
</body>
</html>
