{#- Where a subscription is confirmed (design.md §12, "A monthly cap is the second press
    that lasts", 2026-10-09; boards SubConfirm and ConnConfirm).

    A conversation, the connector, a series' page or a Library row hands over the link;
    the reader presses here, on a page of ours, and nothing else can. For a YouTube
    channel or a podcast the month's cap is chosen here too — 60 credits unless they
    choose otherwise — and it is the consent for every new item that gets ready by itself
    inside it.

    In the app's shell since 2026-10-09 (design.md §12, "The boards are the desk"; board
    SubConfirmDesk): the bar, and the card in the column on the desk. It wore
    `press.html.j2`'s furniture — the lockup, one card, no navigation — until then. The
    press itself needs no script: the cap is a radio and the press a form post; the bar's
    scripts only draw the bar. -#}
<!doctype html>
<html lang="{{ page_language|default('en') }}">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>targum</title>
{% include '_icons.html.j2' %}
<style>{{ asset('tokens.css') }}{{ asset('shared.css') }}{{ asset('chrome.css') }}{{ asset('signin.css') }}{{ asset('subs.css') }}</style>
{{ hebrew_face() }}
<script>{{ asset('keep.js') }}</script>
<script>window.TARGUM_KEY = "{{ token }}";</script>
</head>
<body class="subscribe">
{% set here = 'subscribe' %}
{% include '_nav.html.j2' %}
<script>{{ asset('building.js') }}</script>
<main class="gate sub-gate">
  <div class="door subscribe-door">
  {%- if offer is none %}
    <h1>{{ t("subscribe.page.cant", "We can't subscribe you to this") }}</h1>
    <p class="said" role="alert">{{ refused }}</p>
    <p class="aside"><a href="/?show=subscriptions">{{ t("subscribe.page.your-subscriptions", "Your subscriptions") }}</a></p>
  {%- else %}
    {%- set name = offer.name if offer.kind != 'topic' else t("subs.topic." ~ offer.key, offer.key) %}
    {%- set language_name = languages.get(offer.language, offer.language) %}
    {%- if via in ('chat', 'connector') %}
    <p class="sub-via">{{ t("subscribe.page.asked-in-a-conversation", "Asked for in a conversation") }}</p>
    {%- endif %}
    <h1>{{ t("subscribe.page.subscribe-to", "Subscribe to {name}", name="") }}<bdi dir="auto"{% if offer.kind != 'series' %} lang="{{ offer.language }}"{% endif %}>{{ name }}</bdi></h1>
    {%- if offer.hebrew %}<p class="said"><bdi lang="he" dir="rtl">{{ offer.hebrew }}</bdi></p>{% endif %}
    {%- if refused %}<p class="said" role="alert">{{ refused }}</p>{% endif %}

    {%- if already %}
    <p class="said">{{ t("subscribe.page.already", "You're subscribed to this already.") }}</p>
    <form method="get" action="/subscriptions/{{ already.id }}">
      <button class="btn filled go" type="submit">{{ t("subscribe.page.manage", "Manage") }}</button>
    </form>
    {%- else %}
    <form method="post" action="/subscribe" class="subscribe-form">
      <input type="hidden" name="kind" value="{{ offer.kind }}">
      <input type="hidden" name="{{ 'source' if offer.kind in ('channel', 'podcast') else 'key' }}" value="{{ offer.source if offer.kind in ('channel', 'podcast') else offer.key }}">
      <input type="hidden" name="language" value="{{ offer.language }}">
      {%- if via %}<input type="hidden" name="via" value="{{ via }}">{% endif %}
      <dl class="sub-facts">
        <dt>{{ t("subscribe.page.what-it-is", "What it is") }}</dt>
        <dd>
          {%- if offer.kind == 'channel' %}{{ t("subscribe.page.a-channel", "A YouTube channel in {language}.", language=language_name) }}
          {%- elif offer.kind == 'podcast' %}{{ t("subscribe.page.a-podcast", "A podcast in {language}.", language=language_name) }}
          {%- elif offer.kind == 'topic' %}{{ tn("subscribe.page.a-topic", offer.outlets, "News on this, from {n} outlet in {language}.", "News on this, from {n} outlets in {language}.", language=language_name) }}
          {%- elif offer.kind == 'outlet' %}{{ t("subscribe.page.an-outlet", "News from one outlet, in {language}.", language=language_name) }}
          {%- else %}{{ offer.what }}{% endif %}
          {%- if offer.builds and per_week %} {{ tn("subscribe.page.per-week", per_week, "About {n} new one a week.", "About {n} new ones a week.") }}
          {%- elif offer.builds and per_month %} {{ tn("subscribe.page.per-month", per_month, "About {n} new one a month.", "About {n} new ones a month.") }}{% endif %}
        </dd>
        <dt>{{ t("subscribe.page.what-a-new-one-uses", "What a new one uses") }}</dt>
        <dd>
          {%- if offer.builds and offer.creditsEach %}{{ tn("subscribe.page.about-credits", offer.creditsEach, "About {n} credit. A credit is a minute of audio or video.", "About {n} credits. A credit is a minute of audio or video.") }}
          {%- elif offer.builds %}{{ t("subscribe.page.credits-a-minute", "A credit for every minute. A credit is a minute of audio or video.") }}
          {%- elif offer.kind == 'series' %}{{ t("subscribe.page.series-free", "Nothing. Series are free.") }}
          {%- else %}{{ t("subscribe.page.news-free", "Nothing. New articles come as links, and you choose which to read.") }}{% endif %}
        </dd>
        {%- if offer.builds %}
        <dt id="cap-head">{{ t("subscribe.page.cap", "Spend up to this many credits a month") }}</dt>
        <dd>
          <div class="cap-choices" role="radiogroup" aria-labelledby="cap-head">
          {%- for one in caps %}
            <label class="cap-choice">
              <input type="radio" name="cap" value="{{ one.cap }}"{% if one.cap == chosen %} checked{% endif %}{% if not allowed %} disabled{% endif %}>
              <span class="cap-number">{{ one.cap }}</span>
              {%- if one.about %}<span class="cap-about">{{ tn("subscribe.page.about-items", one.about, "about {n} new one", "about {n} new ones") }}</span>{% endif %}
            </label>
          {%- endfor %}
          </div>
          {%- if credits.left is not none and credits.left is defined %}
          <p class="cap-left">{{ tn("subscribe.page.left", credits.left, "{n} credit left in your plan this month. They come back on {date}.", "{n} credits left in your plan this month. They come back on {date}.", date=credits.back) }}</p>
          {%- endif %}
        </dd>
        <dt>{{ t("subscribe.page.when-cap", "When the cap is reached") }}</dt>
        <dd>{{ t("subscribe.page.when-cap-says", "The next one waits until the 1st of the month, or until you raise the cap. We tell you once when one is waiting.") }}</dd>
        {%- endif %}
        <dt>{{ t("subscribe.page.where", "Where new ones come") }}</dt>
        <dd>{{ t("subscribe.page.where-says", "Under Continue in Your targums, and in one mail a day. Every mail has a link to unsubscribe.") }}</dd>
      </dl>
      {%- if offer.builds and not allowed %}
      <p class="said">{{ t("subscribe.page.plan", "Channels and podcasts come with a plan. Series and news are free.") }}</p>
      <button class="btn filled go" type="submit" disabled>{{ t("subscribe.page.subscribe", "Subscribe") }}</button>
      {%- else %}
      <button class="btn filled go" type="submit">{{ t("subscribe.page.subscribe", "Subscribe") }}</button>
      {%- endif %}
    </form>
    <p class="aside">
      {%- if offer.builds %}{{ t("subscribe.page.starts-next", "It starts with the next new one. Change the cap, pause or unsubscribe any time in Subscriptions.") }}
      {%- else %}{{ t("subscribe.page.starts-free", "Pause or unsubscribe any time in Subscriptions.") }}{% endif %}
    </p>
    {%- endif %}
  {%- endif %}
  </div>
</main>
{% include '_foot.html.j2' %}
<script>window.TARGUM_LANGUAGES = { {% for code, name in names %}"{{ code }}": "{{ name }}"{% if not loop.last %}, {% endif %}{% endfor %} };</script>
{% if strings %}<script>window.TARGUM_STRINGS = {{ strings|tojson }};</script>
{% endif %}<script>{{ asset('strings.js') }}</script>
<script>{{ asset('lang.js') }}</script>
<script>{{ asset('sync.js') }}</script>
<script>{{ asset('account.js') }}</script>
</body>
</html>
