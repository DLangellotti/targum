<!doctype html>
<html lang="{{ page_language|default('en') }}">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>{{ t("progress.page.your-progress-targum", "Your Progress — targum") }}</title>
{% include '_icons.html.j2' %}
<style>{{ asset('tokens.css') }}{{ asset('shared.css') }}{{ asset('chrome.css') }}{{ asset('words.css') }}{{ asset('library.css') }}{{ asset('progress.css') }}</style>
{{ hebrew_face() }}
<script>{{ asset('keep.js') }}</script>
{#- The key, before anything that reads it (targum-internal#343). `building.js`, and
    the conversation's pill, the followed series and the palette in the nav, each read `window.TARGUM_KEY`
    once as they load; it was set in a script at the foot of the body, so on a local serve
    they held an empty key for the life of the page and the bell, the followed series and
    the chat list were refused. The hosted box has no key and was never affected. -#}
<script>window.TARGUM_KEY = "{{ token }}";</script>
</head>
{#- `words` as well as `progress`, for the same reason Learn carries it: the chart
    palette (--step-1..4) is defined on `.words`, and the tiles, the growth line and the
    stacked bar are all drawn with that kit. -#}
<body class="progress">
{#- No `title` for the bar: the board stands the page's title on the desk, under the bar,
    in the column below (design.md §12, "The mockups win on Your Progress", 2026-10-09). -#}
{% set here = 'progress' %}
{% include '_nav.html.j2' %}
<script>{{ asset('building.js') }}</script>

{#- Outside `main`, which stays hidden for a reader with nothing yet: the title is there
    either way. -#}
<h1 class="page-title">{{ t("you.page.your-progress", "Your Progress") }}</h1>
<main id="page" hidden>
  {#- A story in three parts under the totals (design.md §12, "Your Progress is a story in
      three parts", 2026-10-09): where you are, how you got here, what next. -#}
  {#- The one block on this page that inverts. §9 allows a screen a single one and calls
      it the wake-up move — spent on one it is striking, spent on three it is a dark
      theme — so everything below here stays paper and ink. It is also the only surface
      the bright set is legal on: --leaf-bright does not reach 3:1 against paper. -#}
  <section class="ledger" id="ledger" aria-label="{{ t("progress.page.what-you-have-built", "What you have built") }}">
    <div class="counts" id="counts"></div>
  </section>

  {#- 1 · Where you are: the touchstones, a ladder of kinds of text from the language's
      own library, each a link to its shelf; then what you knew of what you read. -#}
  <section class="panel story" id="where" aria-labelledby="where-title">
    <p class="story-step">{{ t("progress.story.where", "1 · Where you are") }}</p>
    <h2 id="where-title" class="story-head"></h2>
    <ol class="touchstones" id="touchstones" aria-label="{{ t("progress.touch.ladder", "Kinds of text, easiest first") }}" hidden></ol>
    <p class="note" id="where-note" hidden></p>

    {#- What the reader knew of what they read, a point a month (targum-internal#291): the
        share of the running words in each finished section that were marked known on the
        day it was finished, kept then and never recomputed. The one figure here allowed to
        fall, said as a count in ten and never a percentage (§6, §12 2026-09-27). Read from
        the account, so absent signed out. Drawn by `progress.js`. -#}
    <div class="reading" id="reading" hidden>
      <h3 class="story-sub" title="{{ t("progress.reading.note", "We measure each section you finish against the words you'd marked known that day. Sections finished before we began measuring aren't in it.") }}">{{ t("progress.reading.title", "How much of what you read you knew, month by month") }}</h3>
      <div id="reading-line"></div>
      <div class="reading-words" id="reading-said"></div>
    </div>
  </section>

  {#- 2 · How you got here. Time and words (targum-internal#339), read off the account's
      record of what happened in each text (#127), filtered by period; then the words
      taken up week by week. -#}
  <section class="panel story" id="how" aria-labelledby="how-title">
    <p class="story-step">{{ t("progress.story.how", "2 · How you got here") }}</p>
    <h2 id="how-title" class="story-head"></h2>
    <div class="spent" id="spent" hidden>
      <div class="chips" id="spent-period" role="group" aria-label="{{ t("progress.spent.when", "When") }}"></div>
      {#- What counts as read rides on the figures as a title: the board has no line under
          them (§12, "The mockups win on Your Progress", 2026-10-09). -#}
      <div class="spent-figures" id="spent-figures" title="{{ t("progress.spent.note", "A word counts as read when you turn past its page or mark its section done.") }}"></div>
    </div>
    <p class="note" id="spent-off" hidden>{{ t("progress.spent.off", "Time and words aren't shown because recording is stopped. You can start it again on your account page.") }}</p>
    <h3 class="story-sub" id="weeks-title">{{ t("progress.weeks.title", "The words you took up, week by week") }}</h3>
    <div id="weeks"></div>
  </section>

  {#- 3 · What next: the words still being learned that keep coming round, and texts at
      the reader's level now. -#}
  <section class="panel story" id="next" aria-labelledby="next-title">
    <p class="story-step">{{ t("progress.story.next", "3 · What next") }}</p>
    <h2 id="next-title" class="story-head">{{ t("progress.next.title", "The words and texts that would help most") }}</h2>
    <div class="next-halves">
      <div class="next-half" id="next-words">
        <h3 class="story-sub" id="next-words-title">{{ t("progress.next.words", "Words you keep meeting and haven't learned") }}</h3>
        <ul class="next-rows" id="met-rows"></ul>
        <p class="quiet-line" id="met-empty" hidden></p>
        <a class="next-more" id="practise" href="/words">{{ t("progress.next.practise", "Practise these words") }} →</a>
      </div>
      <div class="next-half" id="next-texts">
        <h3 class="story-sub" id="next-texts-title">{{ t("progress.next.texts", "Texts at your level now") }}</h3>
        <ul class="next-rows" id="level-rows"></ul>
        <p class="note" id="level-empty" hidden></p>
        <a class="next-more" id="more-texts" href="/library">{{ t("progress.next.library", "More in the Library") }} →</a>
      </div>
    </div>
  </section>
</main>

{#- Before the foot, not after it: it was drawn under the foot, so a reader with
    nothing yet saw the site's foot and then the page's one line (2026-09-28). -#}
<p class="nothing" id="nothing" hidden>
  {#- "your library" meant the catalogue and the reader's own shelf at once, and the
      link went to the upload page, which was neither. Both have their own page now. -#}
  {{ t("progress.page.nothing-yet", "Your progress starts with the first word you mark.") }} <a id="library-link" href="/library">{{ t("progress.page.open-something-from-the-library", "Open something from the Library.") }}</a>
</p>
{% include '_foot.html.j2' %}


<script>
window.TARGUM_KEY = "{{ token }}";
window.TARGUM_LANGUAGES = { {% for code, name in languages %}"{{ code }}": "{{ name }}"{% if not loop.last %}, {% endif %}{% endfor %} };
{% if strings %}window.TARGUM_STRINGS = {{ strings|tojson }};
{% endif %}</script>
<script>{{ asset('strings.js') }}</script>
<script>{{ asset('charts.js') }}</script>
<script>{{ asset('lang.js') }}</script>
<script>{{ asset('vocab.js') }}</script>
<script>{{ asset('sync.js') }}</script>
<script>{{ asset('account.js') }}</script>
<script>{{ asset('progress.js') }}</script>
</body>
</html>
