<!doctype html>
<html lang="{{ page_language|default('en') }}">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>{{ t("progress.page.your-progress-targum", "Your Progress — targum") }}</title>
{% include '_icons.html.j2' %}
<style>{{ asset('reader.css') }}{{ asset('chrome.css') }}{{ asset('words.css') }}{{ asset('library.css') }}{{ asset('progress.css') }}</style>
{{ hebrew_face() }}
<script>{{ asset('keep.js') }}</script>
</head>
{#- `words` as well as `progress`, for the same reason Learn carries it: the chart
    palette (--step-1..4) is defined on `.words`, and the tiles, the growth line and the
    stacked bar are all drawn with that kit. -#}
<body class="words progress">
{% set here = 'progress' %}{% set title = t("you.page.your-progress", "Your Progress") %}
{% include '_nav.html.j2' %}
<script>{{ asset('building.js') }}</script>

<main id="page" hidden>
  {#- The one block on this page that inverts. §9 allows a screen a single one and calls
      it the wake-up move — spent on one it is striking, spent on three it is a dark
      theme — so everything below here stays paper and ink. It is also the only surface
      the bright set is legal on: --leaf-bright does not reach 3:1 against paper. -#}
  {#- Four numbers, not seven. What a reader wants from this block is the feeling of
      having got somewhere, and a row of everything countable is a row nobody reads. -#}
  <section class="ledger" id="ledger" aria-label="{{ t("progress.page.what-you-have-built", "What you have built") }}">
    <div class="counts" id="counts"></div>
  </section>
  {#- The month's hours, under the ledger and not in it: a real count, but of an
      allowance rather than of anything the reader did, so it is a note beside the
      figures and never a lit one. Filled by `account.js` from who is signed in;
      absent for a visit with no account and where there is no cap (targum-internal#237). -#}
  <p class="note hours-line" id="hours-line" hidden></p>

  {#- Time listened, time watched and words read (targum-internal#339), read off the
      account's record of what happened in each text (#127) — so, unlike everything else
      on this page, not from this browser's own store, and absent where there is no such
      record: signed out, a box that keeps none, a reader who has stopped theirs. The
      filters narrow these figures and nothing else: a day is not in a language, and the
      longest run is not in a medium (§12). Real counts in the ledger's own treatment —
      hours and minutes, words — and no invented unit. Drawn by `progress.js`. -#}
  <section class="panel spent" id="spent" hidden>
    <h2>{{ t("progress.spent.title", "Time and words") }}</h2>
    <div class="spent-filters">
      <div class="chips" id="spent-medium" role="group" aria-label="{{ t("progress.spent.which", "Which") }}"></div>
      <div class="chips" id="spent-period" role="group" aria-label="{{ t("progress.spent.when", "When") }}"></div>
    </div>
    <div class="spent-figures" id="spent-figures"></div>
    <p class="note" id="spent-note">{{ t("progress.spent.note", "A word counts as read when you turn past its page or mark its section done.") }}</p>
  </section>
  <p class="note" id="spent-off" hidden>{{ t("progress.spent.off", "Time and words aren't shown because recording is stopped. You can start it again on your account page.") }}</p>

  {#- The day strip is seven rows tall and the milestones are two, so the milestones
      share their column with the ladder rather than leaving a hole beside it. -#}
  <div class="panels paired">
    <div class="stack">
      <section class="panel">
        <h2>{{ t("progress.page.milestones", "Milestones") }}</h2>
        <p class="note">{{ t("progress.page.counted-from-the-words-you-ve-marked", "Counted from the words you've marked known.") }}</p>
        <div id="milestones"></div>
        {#- The rung and the distance to the next one, for a language with no ulpan ladder
            behind it. Hebrew's is the block under this. -#}
        <div class="standing" id="standing"></div>
      </section>

      {#- For a language with a ladder — the ulpan for Hebrew, the CEFR for French, Russian
          and Italian — and under the milestones because it is the same question asked in
          the language's own units: how far in am I. The heading is the ladder's name. -#}
      <section class="panel" id="rung" hidden>
        <h2 id="rung-title">{{ t("progress.page.ulpan-level", "Ulpan level") }}</h2>
        <div class="standing" id="rung-standing"></div>
        {#- Where the rung comes from, said once. §6 is plain about limits, and
            `annotate/base.py` refuses to call a difficulty band a CEFR level for the same
            reason: frequency data is not a graded syllabus. -#}
        <p class="note basis" id="basis" hidden></p>
      </section>
    </div>

    <section class="panel">
      <h2>{{ t("progress.page.days-reading", "Days on targum") }}</h2>
      <p class="note">{{ t("progress.page.every-language-together-a-day-counts-when", "Every language together. A day counts when you open something.") }}</p>
      <div id="days"></div>
    </section>
  </div>

  <section class="panel">
    <h2>{{ t("progress.page.where-they-are", "Where they are") }}</h2>
    <p class="note" id="progress-note"></p>
    <div id="progress"></div>
  </section>

  <div class="panels">
    <section class="panel">
      <h2>{{ t("progress.page.words-saved-over-time", "Words saved over time") }}</h2>
      <p class="note">{{ t("progress.page.from-when-you-first-marked-each", "From when you first marked each.") }}</p>
      <div id="growth"></div>
    </section>

    <section class="panel">
      <h2>{{ t("progress.page.how-common-they-are", "How common they are") }}</h2>
      <p class="note">{{ t("progress.page.how-often-each-turns-up-in-everyday", "How often each turns up in everyday use.") }}</p>
      <div id="bands"></div>
    </section>
  </div>
</main>
{% include '_foot.html.j2' %}

<p class="nothing" id="nothing" hidden>
  {#- "your library" meant the catalogue and the reader's own shelf at once, and the
      link went to the upload page, which was neither. Both have their own page now. -#}
  {{ t("progress.page.nothing-yet-open-something-from-the", "Nothing yet. Open something from the") }} <a id="library-link" href="/library">{{ t("progress.page.library", "Library") }}</a>.
</p>

<script>
window.TARGUM_KEY = "{{ token }}";
window.TARGUM_LANGUAGES = { {% for code, name in languages %}"{{ code }}": "{{ name }}"{% if not loop.last %}, {% endif %}{% endfor %} };
{% if strings %}window.TARGUM_STRINGS = {{ strings|tojson }};
{% endif %}</script>
<script>{{ asset('strings.js') }}</script>
<script>{{ asset('charts.js') }}</script>
<script>{{ asset('lang.js') }}</script>
<script>{{ asset('vocab.js') }}</script>
<script>{{ asset('sync.js') }}</script>
<script>{{ asset('account.js') }}</script>
<script>{{ asset('progress.js') }}</script>
</body>
</html>
