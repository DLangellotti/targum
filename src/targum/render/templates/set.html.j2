{#- One press for a whole set (targum-internal#365, design.md §12, "A playlist is swiped,
    and one press takes the set").

    A model quoted the set; the reader presses it here, on a page of ours, and the model
    cannot. Every text is listed with what it uses and a tick, the total is said once, and
    the one button claims every ticked text or none of them — David's call on 2026-09-23,
    so a reader is never left holding half of what the page quoted. A refusal comes back
    to this page and says how many credits are left.

    In the app's shell since 2026-10-09, as the press for one text is (design.md §12,
    "The connector's pages are the boards'"; boards ConnConfirm and ConnConfirmPhone): the
    bar, and the board's 640px card. No script of its own: the ticks are checkboxes and
    the press is a form post; the bar's scripts only draw the bar. -#}
<!doctype html>
<html lang="{{ page_language|default('en') }}">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>targum</title>
{% include '_icons.html.j2' %}
<style>{{ asset('tokens.css') }}{{ asset('shared.css') }}{{ asset('chrome.css') }}{{ asset('subs.css') }}</style>
{{ hebrew_face() }}
<script>{{ asset('keep.js') }}</script>
<script>window.TARGUM_KEY = "{{ token }}";</script>
</head>
<body class="press">
{% set here = 'press' %}
{% include '_nav.html.j2' %}
<script>{{ asset('building.js') }}</script>
<main class="sub-gate">
  <div class="card sub-confirm press-confirm">
    <p class="sub-via"><svg viewBox="0 0 16 16" aria-hidden="true" focusable="false"><path d="M2.5 3.5h11v7h-6l-3 2.5v-2.5h-2z"/></svg>{{ t("press.page.from-an-assistant", "From an assistant") }}</p>
    <div class="sub-confirm-head">
      {%- set firsts = (playlist['items'] or [])[:4] %}
      <span class="sub-confirm-tile is-mosaic set-mosaic{% if firsts|length < 2 %} is-one{% endif %}" aria-hidden="true">
        {%- for item in firsts %}<span class="tone-set"><span class="glyph" lang="he">{{ (item.title or "?")[:1] }}</span></span>{% endfor %}</span>
      <div class="sub-confirm-names">
        <p class="sub-confirm-kicker">{{ t("set.page.a-playlist", "A playlist") }}</p>
        <h1 class="sub-confirm-title"><bdi dir="auto">{{ playlist.name }}</bdi></h1>
        <p class="sub-confirm-kicker">{{ tn("set.page.texts", (playlist['items'] or [])|length, "{n} text", "{n} texts") }}</p>
      </div>
    </div>
    {%- if refused %}
    <p class="said" role="alert">{{ refused }}</p>
    {%- endif %}

    {#- What a text in the set is, in words, whichever state the set is in: the list is
        always drawn before anything is pressed (2026-09-24 — a next set said only
        "Ready." and listed nothing). -#}
    {%- macro state(row) -%}
      {%- if row.stage in ('failed', 'blocked') -%}{{ t("set.page.we-can-t-make-this-one", "We can't add this one.") }}
      {%- elif row.job is none -%}{{ t("set.page.on-your-shelf", "Already yours") }}
      {%- elif row.stage == 'done' or row.item.reader -%}{{ t("set.page.ready", "Ready") }}
      {%- else -%}{{ t("set.page.getting-ready", "Getting ready") }}
      {%- endif -%}
    {%- endmacro %}

    {%- if waiting %}
    <form method="post" action="/set/{{ playlist.id }}" id="set-press">
      <ul class="set-rows">
      {%- for row in rows %}
        <li class="set-row">
          {%- set ticks = row.job and row.stage == 'ready' %}
          <label class="set-row-label">
            {%- if ticks %}
            <input type="checkbox" name="keep" value="{{ row.item.position }}" checked>
            {%- else %}
            <input type="checkbox" disabled{% if row.job is none %} checked{% endif %}>
            {%- endif %}
            <span class="thumb is-letter tone-set set-tile" aria-hidden="true"><span class="glyph" lang="he">{{ (row.item.title or "?")[:1] }}</span></span>
            <span class="set-row-names">
              <bdi class="set-title" dir="auto">{{ row.item.title }}</bdi>
              {%- if row.job and row.job.known_line %}<span class="set-meta">{{ row.job.known_line }}</span>{% endif %}
            </span>
            <span class="set-cost">{% if ticks and row.credits %}{{ tn("set.page.uses-credits", row.credits, "{n} credit", "{n} credits") }}{% elif not ticks %}{{ state(row) }}{% endif %}</span>
          </label>
        </li>
      {%- endfor %}
      </ul>
      <div class="press-foot">
        <p class="press-cost">
          <b>{{ tn("set.page.uses-credits-in-all", total, "Uses {n} credit in all", "Uses {n} credits in all") }}</b>
          {%- if credits.left is not none and credits.left is defined %}
          <span>{{ tn("set.page.left-this-month", credits.left, "{n} left this month · resets on {date}", "{n} left this month · resets on {date}", date=credits.back) }}</span>
          {%- endif %}
        </p>
        <button class="btn filled go" type="submit">{{ t("set.page.read-these", "Confirm") }}</button>
      </div>
    </form>
    <p class="aside">{{ t("set.page.you-asked-for-these-somewhere-else", "Untick what you don't want, then press Confirm. Unticked texts come out of the playlist.") }}</p>

    {%- else %}
    <ul class="set-rows">
    {%- for row in rows %}
      <li class="set-row"><span class="set-row-label">
        <span class="thumb is-letter tone-set set-tile" aria-hidden="true"><span class="glyph" lang="he">{{ (row.item.title or "?")[:1] }}</span></span>
        <span class="set-row-names"><bdi class="set-title" dir="auto">{{ row.item.title }}</bdi></span>
        <span class="set-cost">{{ state(row) }}</span>
      </span></li>
    {%- endfor %}
    </ul>
    {%- if making %}
    <p class="said set-total" role="status">{{ tn("set.page.we-re-making-them", making|length, "Preparing {n} text.", "Preparing {n} texts. You can start as soon as the first is ready.") }}</p>
    {%- elif first %}
    <p class="said set-total">{{ t("set.page.they-re-ready", "Ready.") }}</p>
    {%- else %}
    <p class="said set-total">{{ t("set.page.nothing-here-can-be-made", "None of these texts can be added right now.") }}</p>
    {%- endif %}
    {%- if first %}
    {#- Opened as the playlist's first item, so the reader draws Next and the swipe
        (targum-internal#366) — the same address Start on Your playlists builds. Never
        `go`: opening a playlist plays nothing until pressed. -#}
    <form method="get" action="/reader/{{ first.reader }}/reader/index.html">
      <input type="hidden" name="list" value="{{ playlist.id }}">
      <input type="hidden" name="at" value="{{ first.position }}">
      <button class="btn filled go" type="submit">{{ t("set.page.start-with-the-first", "Start") }}</button>
    </form>
    {%- elif making %}
    <form method="get" action="/set/{{ playlist.id }}">
      <button class="btn filled go" type="submit">{{ t("set.page.see-how-it-s-going", "Check progress") }}</button>
    </form>
    {%- endif %}
    {%- if first or making %}
    <p class="aside"><a href="/playlists">{{ t("set.page.go-to-your-playlists", "Your playlists") }}</a></p>
    {%- else %}
    <p class="aside"><a href="/">{{ t("press.page.go-to-your-targums", "Go to Your targums") }}</a></p>
    {%- endif %}
    {%- endif %}
  </div>
</main>
{% include '_foot.html.j2' %}
<script>window.TARGUM_LANGUAGES = { {% for code, name in names %}"{{ code }}": "{{ name }}"{% if not loop.last %}, {% endif %}{% endfor %} };</script>
{% if strings %}<script>window.TARGUM_STRINGS = {{ strings|tojson }};</script>
{% endif %}<script>{{ asset('strings.js') }}</script>
<script>{{ asset('lang.js') }}</script>
<script>{{ asset('sync.js') }}</script>
<script>{{ asset('account.js') }}</script>
</body>
</html>
