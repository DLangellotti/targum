<!doctype html>
<html lang="{{ page_language|default('en') }}">
<head>
{#- Whose work targum uses and under what licence (targum-internal#610; design.md §12,
    "A word is said by a person where one recorded it", 2026-10-31). Read out of the
    manifests kept beside the files, so a recording is credited the day it is served. -#}
{% include '_public_head.html.j2' %}
{{ styles('tokens.css', 'public-page.css', 'about.css') }}
{{ hebrew_face() }}
{{ chrome_face() }}
</head>
<body class="about credits">
<div class="corner">
  <a class="enter" href="/account/signin">{{ t("credits.page.sign-in", "Sign in") }}</a>
</div>

<main class="sheet">
  <a class="brand" href="/" aria-label="targum">
    <svg class="brand-mark" viewBox="20 12 56 72" aria-hidden="true" focusable="false">
      <rect x="20" y="12" width="22" height="62" rx="5" fill="currentColor"></rect>
      <rect x="54" y="22" width="22" height="62" rx="5" fill="var(--mark-accent)"></rect>
    </svg>
    <span>targum</span>
  </a>

  <div class="card">
  <h1>{{ t("credits.page.heading", "Credits") }}</h1>

  <section id="voices">
    <h2>{{ t("credits.page.voices-heading", "Words said by people") }}</h2>
    <p class="lede">{{ t("credits.page.voices-intro", "Where a word card plays a person rather than our voice, the recording is theirs. They made it for Lingua Libre and shared it on Wikimedia Commons. Thank you.") }}</p>
    <p class="lede">{{ t("credits.page.voices-copies", "We play Commons' own MP3 copy of each file. A file under CC BY-SA stays under CC BY-SA, and its page on Commons has the original.") }}</p>
    {% if speakers %}
    <ul class="speakers">
      {% for row in speakers %}
      <li class="speaker">
        <details>
          <summary><b>{{ row.name }}</b> <span class="terms">· <a href="{{ row.licence_url }}" rel="license">{{ row.licence }}</a> · {{ tn("credits.page.words", row.recordings|length, "{n} word", "{n} words") }}</span></summary>
          <ul lang="{{ language }}" dir="rtl">
            {% for one in row.recordings %}
            <li><a href="{{ one.page }}" title="{{ one.attribution }}">{{ one.word }}</a></li>
            {% endfor %}
          </ul>
        </details>
      </li>
      {% endfor %}
    </ul>
    {% else %}
    <p class="lede">{{ t("credits.page.none", "No recordings are kept here yet.") }}</p>
    {% endif %}
  </section>

  {#- The yardsticks' outside corpora (targum-internal#580, #581; LICENSING.md, "The
      yardsticks' outside corpora, counted and never kept", 2026-10-31; design.md §12,
      "The word counts are credited on /credits", 2026-11-01). Only counts are kept. -#}
  <section id="word-counts">
    <h2>{{ t("credits.page.counts-heading", "Word counts") }}</h2>
    <p class="lede">{{ t("credits.page.counts-intro", "How much of everyday conversation, classic literature or the Bible you understand is measured against a list of the commonest words in each. We count those words ourselves from the texts below. Only the counts are kept, never the text.") }}</p>
    <ul class="sources">
      <li class="source">
        <p><b>{{ t("credits.page.counts-conversation-name", "Everyday conversation") }}</b> · {{ t("credits.page.counts-conversation", "OPUS OpenSubtitles, Hebrew. The subtitles belong to the people who wrote them.") }}</p>
        <p class="cite">P. Lison and J. Tiedemann, 2016, “OpenSubtitles2016: Extracting Large Parallel Corpora from Movie and TV Subtitles”, LREC 2016.</p>
        <p><a href="https://www.opensubtitles.org">opensubtitles.org</a></p>
      </li>
      <li class="source">
        <p><b>{{ t("credits.page.counts-literature-name", "Classic literature") }}</b> · {{ t("credits.page.counts-literature", "Project Ben-Yehuda's public-domain library, made by Project Ben-Yehuda volunteers.") }}</p>
        <p><a href="https://benyehuda.org">benyehuda.org</a></p>
      </li>
      <li class="source">
        <p><b>{{ t("credits.page.counts-bible-name", "The Bible") }}</b> · {{ t("credits.page.counts-bible", "The Open Scriptures Hebrew Bible Project's morphology, under CC BY 4.0, of the Westminster Leningrad Codex, which is in the public domain.") }}</p>
        <p><a href="https://github.com/openscriptures/morphhb">github.com/openscriptures/morphhb</a></p>
      </li>
    </ul>
  </section>
  </div>
</main>

{% include '_public_foot.html.j2' %}
</body>
</html>
