<!doctype html>
<html lang="{{ page_language|default('en') }}">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>{{ t("saved.page.title-targum", "Saved on this device — targum") }}</title>
{% include '_icons.html.j2' %}
<style>{{ asset('tokens.css') }}{{ asset('shared.css') }}{{ asset('chrome.css') }}{{ asset('words.css') }}{{ asset('you.css') }}{{ asset('saved.css') }}</style>
{{ hebrew_face() }}
<script>{{ asset('keep.js') }}</script>
<script>window.TARGUM_KEY = "{{ token }}";</script>
</head>
<body class="saved">
{#- Saved on this device (design.md §12, "What is saved is a page of the account's",
    2026-10-09; boards OffSavedDesk and OffSavedPhone). Everything on it is this
    browser's: what is kept, how much room it takes, and what saves itself. Nothing is
    asked of the server, so it opens without a connection once it has been opened with
    one. -#}
{% set here = 'you' %}{% set title = t("saved.page.title", "Saved on this device") %}
{% set crumbs = [(t("saved.page.your-account", "Your account"), "/you")] %}
{% include '_nav.html.j2' %}
<script>{{ asset('building.js') }}</script>

<main class="saved-page">
  <p class="saved-lede">{{ t("saved.page.lede", "These open, play and show their word cards without a connection.") }}</p>
  {#- Where a page that was not saved was asked for with no connection: the worker sends
      the reader here, and this says why (design.md §12, 2026-10-09). -#}
  <p class="saved-away card" id="saved-away" role="status" hidden>{{ t("saved.page.away", "That isn't on this device, so it opens when you're back online.") }}</p>
  <p class="saved-none card" id="saved-cannot" hidden>{{ t("saved.page.cannot", "This browser can't keep texts for offline.") }}</p>

  {#- The board's two columns (OffSavedDesk): what is kept, as two tables, at the left,
      and the room, what saves itself and Remove all at the right. On a phone they are
      one column, the room first (OffSavedPhone). -#}
  <div class="saved-grid">
    <div class="saved-main">
      {#- Nothing saved yet is said inside the card the rows would be in. -#}
      <section class="card saved-group" id="saved-none" hidden>
        <h2 class="section-title">{{ t("saved.page.on-their-own", "Saved automatically") }}</h2>
        <p class="note">{{ t("saved.page.none", "Nothing is saved on this device yet. Before you go, choose Save for offline in a text's ⋯ menu.") }}</p>
      </section>

      <section class="card saved-group" id="saved-auto" aria-labelledby="saved-auto-title" hidden>
        <div class="saved-head">
          <h2 class="section-title" id="saved-auto-title">{{ t("saved.page.on-their-own", "Saved automatically") }}</h2>
          <p class="note" id="saved-auto-says"></p>
        </div>
        <div class="saved-cols" aria-hidden="true">
          <span>{{ t("saved.page.col-title", "Title") }}</span><span>{{ t("saved.page.col-kind", "Kind") }}</span><span>{{ t("saved.page.col-size", "Size") }}</span><span>{{ t("saved.page.col-saved", "Saved") }}</span>
        </div>
        <ul class="saved-rows" id="saved-auto-rows"></ul>
      </section>

      <section class="card saved-group" id="saved-mine" aria-labelledby="saved-mine-title" hidden>
        <div class="saved-head">
          <h2 class="section-title" id="saved-mine-title">{{ t("saved.page.by-you", "Saved by you") }}</h2>
          <p class="note">{{ t("saved.page.by-you-says", "They stay until you remove them.") }}</p>
        </div>
        <div class="saved-cols" aria-hidden="true">
          <span>{{ t("saved.page.col-title", "Title") }}</span><span>{{ t("saved.page.col-kind", "Kind") }}</span><span>{{ t("saved.page.col-size", "Size") }}</span><span>{{ t("saved.page.col-saved", "Saved") }}</span>
        </div>
        <ul class="saved-rows" id="saved-mine-rows"></ul>
      </section>
    </div>

    <div class="saved-aside">
      <section class="card saved-room" id="saved-room" aria-labelledby="saved-room-title" hidden>
        <h2 class="section-title" id="saved-room-title">{{ t("saved.page.room", "Room on this device") }}</h2>
        <p class="saved-used" id="saved-used"></p>
        <span class="meter is-building saved-meter" aria-hidden="true"><span id="saved-meter"></span></span>
        <p class="note">{{ t("saved.page.browser-sets", "This browser sets how much targum can keep.") }}</p>
        <div class="saved-keep" id="saved-persist" hidden>
          <p class="note" id="saved-persist-says">{{ t("saved.page.browser-clears", "Your browser clears saved texts when it runs short of space.") }}</p>
          <button type="button" class="btn ghost outline saved-ask" id="saved-ask">{{ t("saved.page.ask-to-keep", "Ask it to keep them") }}</button>
        </div>
      </section>

      <section class="card saved-choices" id="saved-choices" aria-labelledby="saved-choices-title" hidden>
        <h2 class="section-title" id="saved-choices-title">{{ t("saved.page.saving-on-its-own", "Saving automatically") }}</h2>
        <div class="saved-choice">
          <span class="saved-choice-what">
            <span class="saved-choice-name" id="recent-label">{{ t("saved.page.recent", "Recent texts") }}</span>
            <span class="note">{{ t("saved.page.recent-says", "The ones you opened last") }}</span>
          </span>
          <span class="seg saved-segment" role="radiogroup" aria-labelledby="recent-label">
            {%- for n, said in [(0, t("saved.page.off", "Off")), (3, "3"), (5, "5"), (10, "10")] %}
            <button type="button" role="radio" aria-checked="false" data-recent="{{ n }}">{{ said }}</button>
            {%- endfor %}
          </span>
        </div>
        <div class="saved-choice saved-choice-row">
          <span class="saved-choice-what">
            <span class="saved-choice-name" id="playlist-label">{{ t("saved.page.playlist", "The playlist you're in") }}</span>
            <span class="note">{{ t("saved.page.playlist-says", "Every text in it") }}</span>
          </span>
          <button type="button" class="saved-switch" id="saved-playlist" role="switch" aria-checked="true" aria-labelledby="playlist-label"><span class="sw" aria-hidden="true"></span></button>
        </div>
        <div class="saved-choice">
          <span class="saved-choice-what">
            <span class="saved-choice-name" id="film-label">{{ t("saved.page.videos", "Videos") }}</span>
            <span class="note">{{ t("saved.page.videos-says", "The picture takes about six times the room") }}</span>
          </span>
          <span class="seg saved-segment" role="radiogroup" aria-labelledby="film-label">
            <button type="button" role="radio" aria-checked="true" data-film="1">{{ t("saved.page.with-picture", "With the picture") }}</button>
            <button type="button" role="radio" aria-checked="false" data-film="0">{{ t("saved.page.sound-and-text", "Sound and text") }}</button>
          </span>
        </div>
      </section>

      <section class="card saved-end" id="saved-end" hidden>
        <p class="note">{{ t("saved.page.stays", "Your words, your place in each text and your record stay in your account.") }}</p>
        <button type="button" class="btn ghost outline danger saved-all" id="saved-all"><svg viewBox="0 0 16 16" aria-hidden="true" focusable="false"><path d="M4.5 4.5l7 7M11.5 4.5l-7 7"/></svg>{{ t("saved.page.remove-all", "Remove all from this device") }}</button>
      </section>
    </div>
  </div>
</main>
{% include '_foot.html.j2' %}

<script>
window.TARGUM_KEY = "{{ token }}";
window.TARGUM_LANGUAGES = { {% for code, name in languages %}"{{ code }}": "{{ name }}"{% if not loop.last %}, {% endif %}{% endfor %} };
{% if strings %}window.TARGUM_STRINGS = {{ strings|tojson }};
{% endif %}</script>
<script>{{ asset('strings.js') }}</script>
<script>{{ asset('lang.js') }}</script>
<script>{{ asset('sync.js') }}</script>
{#- The account's corner asks `sync.js` who is signed in and `account.js` draws them, as
    on every desk page. Without it the corner said "Sign in" to a reader who was (board
    OffSavedDesk, 2026-10-09; the Tanakh map's bug, #677). -#}
<script>{{ asset('account.js') }}</script>
<script>{{ asset('saved.js') }}</script>
</body>
</html>
