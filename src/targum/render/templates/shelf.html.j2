<!doctype html>
<html lang="{{ page_language|default('en') }}">
<head>
{% include '_public_head.html.j2' %}
{{ styles('tokens.css', 'shared.css', 'reader.css', 'public.css') }}
{{ hebrew_face() }}
{{ script('keep.js') }}
</head>
<body class="public">
<main class="sheet">
  {#- One row on the sheet's own grid: the name at one corner, the door and the light
      switch at the other. The corner used to be pinned to the window's edge, which on a
      wide screen is nowhere near the page. -#}
  <div class="masthead">
    <a class="brand" href="/" aria-label="targum">
      <svg class="brand-mark" viewBox="20 12 56 72" aria-hidden="true" focusable="false">
        <rect x="20" y="12" width="22" height="62" rx="5" fill="currentColor"></rect>
        <rect x="54" y="22" width="22" height="62" rx="5" fill="var(--mark-accent)"></rect>
      </svg>
      <span>targum</span>
    </a>
    <div class="corner">
      <a class="enter" href="/account/signin">{{ t("shelf.page.sign-in", "Sign in") }}</a>
    </div>
  </div>

  <h1>{{ shelf_name }}</h1>
  <p class="lede">{{ shelf_blurb }}</p>

  {%- if rows %}
  <ul class="texts">
    {%- for row in rows %}
    {#- The name, the place and the blurb in the page's language where the catalogue has
        them, the way the text page draws them, and English where it has not
        (targum-internal#520). `lang` says which one is drawn. #}
    {%- set entry = row.entry %}
    {%- set script = entry.language if entry.language in ('arc', 'yi') else 'he' %}
    <li>
      <a href="/library/{{ entry.id }}">
        <bdi lang="{{ entry.language }}">{{ entry.title }}</bdi>
        {% if row.named %}<span class="english" lang="{{ row.named_lang }}" dir="ltr">{{ row.named }}</span>{% endif %}
      </a>
      {#- A byline or a blurb in Hebrew letters says so, with its own direction (design.md
          §14, line 3; Library QA, 2026-10-20): "אברהם מאפו, 1853" stood in an English run. -#}
      <span class="byline"{% if row.byline and 'א' <= row.byline[:1] <= 'ת' %} lang="{{ script }}" dir="auto"{% endif %}>{{ row.byline }}</span>
      <span class="blurb"{% if row.blurb and 'א' <= row.blurb[:1] <= 'ת' %} lang="{{ script }}" dir="auto"{% elif row.blurb and row.blurb_lang != page_language %} lang="{{ row.blurb_lang }}"{% endif %}>{{ row.blurb }}</span>
    </li>
    {%- endfor %}
  </ul>
  {%- else %}
  {#- Said plainly rather than dressed up. An empty shelf that pretends otherwise is
      worse than one that admits it, and this one fills up shortly. -#}
  <p class="empty">{{ t("shelf.page.nothing-here-yet", "Nothing here yet.") }}</p>
  {%- endif %}
</main>

{% include '_public_foot.html.j2' %}
</body>
</html>
