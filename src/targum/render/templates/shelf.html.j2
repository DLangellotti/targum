<!doctype html>
<html lang="en">
<head>
{% include '_public_head.html.j2' %}
<style>{{ asset('reader.css') }}{{ asset('public.css') }}</style>
{{ hebrew_face() }}
<script>{{ asset('theme.js') }}</script>
</head>
<body class="public">
<main class="sheet">
  {#- One row on the sheet's own grid: the name at one corner, the door and the light
      switch at the other. The corner used to be pinned to the window's edge, which on a
      wide screen is nowhere near the page. -#}
  <div class="masthead">
    <a class="brand" href="/" aria-label="targum">
      <svg class="brand-mark" viewBox="20 12 56 72" aria-hidden="true" focusable="false">
        <rect x="20" y="12" width="22" height="62" rx="5" fill="currentColor"></rect>
        <rect x="54" y="22" width="22" height="62" rx="5" fill="var(--mark-accent)"></rect>
      </svg>
      <span>targum</span>
    </a>
    <div class="corner">
      <a class="enter" href="/account/signin">Sign in</a>
      <button type="button" data-theme-toggle aria-label="Switch theme"></button>
    </div>
  </div>

  <h1>{{ shelf_name }}</h1>
  <p class="lede">{{ shelf_blurb }}</p>

  {%- if entries %}
  <ul class="texts">
    {%- for entry in entries %}
    <li>
      <a href="/library/{{ entry.id }}">
        <bdi lang="{{ entry.language }}">{{ entry.title }}</bdi>
        {% if entry.english %}<span class="english" lang="en" dir="ltr">{{ entry.english }}</span>{% endif %}
      </a>
      <span class="byline">{{ entry.author }}</span>
      <span class="blurb">{{ entry.blurb }}</span>
    </li>
    {%- endfor %}
  </ul>
  {%- else %}
  {#- Said plainly rather than dressed up. An empty shelf that pretends otherwise is
      worse than one that admits it, and this one fills up shortly. -#}
  <p class="empty">Nothing here yet.</p>
  {%- endif %}
</main>

{% include '_public_foot.html.j2' %}
</body>
</html>
