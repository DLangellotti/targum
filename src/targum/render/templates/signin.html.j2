<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>targum</title>
{% include '_icons.html.j2' %}
<style>{{ asset('reader.css') }}{{ asset('signin.css') }}</style>
<script>{{ asset('theme.js') }}</script>
</head>
<body class="signin">
<main class="gate">
  {#- The lockup alone. There is no navigation to offer someone who is not in yet, and
      a header with three dead links is worse than no header. -#}
  <a class="brand" href="/" aria-label="targum">
    <svg class="brand-mark" viewBox="20 12 56 72" aria-hidden="true" focusable="false">
      <rect x="20" y="12" width="22" height="62" rx="5" fill="currentColor"></rect>
      <rect x="54" y="22" width="22" height="62" rx="5" fill="var(--mark-accent)"></rect>
    </svg>
    <span>targum</span>
  </a>

  {% if landing %}
  {#- The link arrived. Nothing has been spent yet: a mail client that fetches this page
      to preview it has only read it, and the account is opened by the button below. -#}
  <h1>Sign in as {{ landing }}</h1>
  <p class="said">You asked for this link. Press the button and targum will remember
    you on this browser.</p>
  <form method="post" action="/account/enter">
    <input type="hidden" name="t" value="{{ token }}">
    <button class="go" type="submit">Sign in</button>
  </form>
  <p class="aside">Did not ask for it? Close this page and nothing happens.</p>

  {% elif expired %}
  <h1>That link has been used</h1>
  <p class="said">A link works once and lasts twenty minutes, which is what keeps an
    old email in an inbox from being a way in. Ask for another.</p>
  <form method="post" action="/account/sign-in" id="ask">
    <label for="email">Your email address</label>
    <input type="email" id="email" name="email" required autocomplete="email"
           autocapitalize="off" spellcheck="false" placeholder="you@example.com">
    <button class="go" type="submit">Email me a link</button>
  </form>

  {% else %}
  <h1>Read Hebrew with the translation beside it</h1>
  {#- One door. An address targum has not seen makes an account; one it has sends a
      link. Nobody has to work out which of two buttons they are. -#}
  <p class="said">Sign in, or make an account — they are the same thing. There is no
    password to invent: targum emails you a link.</p>
  <form method="post" action="/account/sign-in" id="ask">
    <label for="email">Your email address</label>
    <input type="email" id="email" name="email" required autocomplete="email"
           autocapitalize="off" spellcheck="false" placeholder="you@example.com">
    <button class="go" type="submit">Email me a link</button>
  </form>
  <p class="aside">Your words follow you to every browser you sign in on. Signed out,
    targum keeps them in the one you are reading in.</p>
  {% endif %}

  <p class="said sent" id="sent" role="status" hidden></p>
</main>
<script>{{ asset('signin.js') }}</script>
</body>
</html>
