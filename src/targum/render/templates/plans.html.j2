{#- The plans page (design.md §12, "The plans page is the one place money shows" and "Free
    and Plan, behind a switch", 2026-10-09; boards PlanPricing and PlanPricingPhone).

    Signed in only, and only while `TARGUM_PLANS` is on; linked from Your account, the
    panels a free reader meets and the foot inside the app, and from nowhere in front of
    the door. Every pay button is drawn and greyed until there is a payment provider. No
    script. Plan is paid monthly and nothing else (David, 2026-11-18). -#}
<!doctype html>
<html lang="{{ page_language|default('en') }}">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>{{ t("plans.page.title-tab", "Plans — targum") }}</title>
{% include '_icons.html.j2' %}
{{ styles('tokens.css', 'shared.css', 'chrome.css', 'words.css', 'plans.css') }}
{{ hebrew_face() }}
{{ script('keep.js') }}
<script>window.TARGUM_KEY = "{{ token }}";</script>
</head>
<body class="plans">
{% set here = 'plans' %}{% set title = t("plans.page.title", "Plans") %}
{% include '_nav.html.j2' %}
{{ script('building.js') }}
<main class="plans-main">
  <p class="plans-lede">{{ t("plans.page.lede", "Reading on targum is free. The plan is for audio and video.") }}</p>

  {%- set mine = plan.plan|default('free') %}
  <div class="plans-pair">
    {#- Free first at a desk; on a phone Plan comes first (PlanPricingPhone), by order. -#}
    <section class="card plan-card plan-free" aria-labelledby="plan-free-name">
      <div class="plan-top">
        <h2 class="plan-name" id="plan-free-name">{{ t("plans.page.free", "Free") }}</h2>
        {%- if mine == 'free' %}<span class="plan-yours">{{ t("plans.page.your-plan", "Your plan") }}</span>{% endif %}
      </div>
      <p class="plan-price"><span class="plan-figure">$0</span> <span class="plan-per">{{ t("plans.page.free-per", "for as long as you like") }}</span></p>
      <ul class="plan-lines is-checks">
        <li><b>{{ t("plans.page.free-credits", "{n} credits a month", n=free_credits) }}</b>{{ t("plans.page.free-credits-says", " ({hours} hour of audio or video)", hours=free_hours) }}</li>
        <li>{{ t("plans.page.free-library", "The whole library") }}</li>
        <li>{{ t("plans.page.free-words", "Save up to {n} words", n=free_words) }}</li>
        <li>{{ t("plans.page.free-upload", "Upload any text") }}</li>
        <li>{{ t("plans.page.free-subscribe", "Follow series and the news") }}</li>
        <li>{{ t("plans.page.free-talk", "Chat about what you read") }}</li>
      </ul>
    </section>

    <section class="card plan-card plan-paid" aria-labelledby="plan-paid-name">
      <div class="plan-top">
        <h2 class="plan-name" id="plan-paid-name">{{ t("plans.page.plan", "Plan") }}</h2>
        {%- if mine == 'plan' %}<span class="plan-yours">{{ t("plans.page.your-plan", "Your plan") }}</span>{% endif %}
      </div>
      <p class="plan-price"><span class="plan-figure">${{ price_month }}</span> <span class="plan-per">{{ t("plans.page.a-month", "a month") }}</span></p>
      <p class="plan-says">{{ t("plans.page.plan-says", "Everything in Free") }}</p>
      {%- if plan.comp %}
      <p class="plan-comp">{{ t("plans.page.comp", "Free for beta readers until {date}", date=plan.compSaid) }}</p>
      {%- endif %}
      <ul class="plan-lines is-pluses">
        <li><b>{{ t("plans.page.plan-credits", "{n} credits a month", n=plan_credits) }}</b>{{ t("plans.page.plan-hours", " ({hours} hours of audio or video)", hours=plan_hours) }}</li>
        <li>{{ t("plans.page.plan-upload", "Learn from YouTube videos and podcasts") }}</li>
        <li>{{ t("plans.page.plan-subscribe", "Subscribe to YouTube channels and podcasts") }}</li>
        <li>{{ t("plans.page.plan-words", "Save as many words as you like") }}</li>
        <li>{{ t("plans.page.plan-top-up", "Top up for ${price} an hour", price=top_up_hour) }}</li>
      </ul>
      {#- A beta reader comped to Plan still sees the press they will use once payments
          open, greyed like everybody's (targum-internal#59). Once Paddle is configured
          (`pay`), a reader not on Plan presses it for real: a plain form that the
          server answers with a 303 to Paddle's hosted checkout, so nothing of Paddle's
          is on this page (design.md §12, "Payments are Paddle's, by a hosted
          checkout", 2026-11-15). The comp keeps it greyed: that is David's to decide. -#}
      {%- if pay and mine != 'plan' %}
      <form class="plan-pay" id="plan-start-form" method="post" action="/plans/start">
        <input type="hidden" name="cadence" value="month">
        <button type="submit" class="btn plan-start">{{ t("plans.page.start", "Upgrade") }}</button>
        {%- if failed %}
        <span class="fault-fact" role="status">{{ t("plans.page.pay-failed", "The checkout didn't open. Try again in a minute.") }}</span>
        {%- endif %}
        <span class="plan-cancel-any">{{ t("plans.page.cancel-any-time", "Cancel any time") }}</span>
      </form>
      {%- elif mine != 'plan' or plan.comp %}
      <div class="plan-pay">
        {%- if mine != 'plan' %}
        <button type="button" class="btn soon plan-start" disabled>{{ t("plans.page.start", "Upgrade") }}</button>
        {%- endif %}
        <span class="fault-fact fault-soon"><svg class="fault-clock" viewBox="0 0 16 16" aria-hidden="true" focusable="false"><path d="M8 2.25a5.75 5.75 0 1 0 0 11.5a5.75 5.75 0 1 0 0-11.5z"/><path d="M8 5v3.2l2 1.3"/></svg>{{ t("fault.payments-soon", "Payments open soon") }}</span>
        <span class="plan-cancel-any">{{ t("plans.page.cancel-any-time", "Cancel any time") }}</span>
      </div>
      {%- endif %}
    </section>
  </div>

  <p class="plans-small">{{ t("plans.page.dollars", "Prices in US dollars.") }}</p>

  <div class="plans-more">
    <section class="card plans-far" aria-labelledby="plans-far-title">
      <h2 class="section-title" id="plans-far-title">{{ t("plans.page.how-far", "How far {n} credits go", n=plan_credits) }}</h2>
      <p class="plans-far-rate">{{ t("plans.page.rate", "1 credit is 1 minute of audio or video.") }}</p>
      <dl class="plans-far-rows">
        <div><dt>{{ t("plans.page.far-video", "A 4-minute YouTube video") }}</dt><dd>{{ tn("plans.page.credits", 4, "{n} credit", "{n} credits") }}</dd></div>
        <div><dt>{{ t("plans.page.far-podcast", "A 45-minute podcast") }}</dt><dd>{{ tn("plans.page.credits", 45, "{n} credit", "{n} credits") }}</dd></div>
        <div><dt>{{ t("plans.page.far-upload", "Text you upload") }}</dt><dd class="is-none">{{ t("plans.page.none", "none") }}</dd></div>
        <div><dt>{{ t("plans.page.far-library", "Anything in the library") }}</dt><dd class="is-none">{{ t("plans.page.none", "none") }}</dd></div>
      </dl>
    </section>

    <section class="plans-faq" aria-labelledby="plans-faq-title">
      <h2 class="section-title" id="plans-faq-title">{{ t("plans.page.questions", "Questions") }}</h2>
      <h3>{{ t("plans.page.q-run-out", "What if I run out of credits?") }}</h3>
      <p>{{ t("plans.page.a-run-out", "Reading still works. Audio and video wait until the 1st. On the plan, you can top up.") }}</p>
      <h3>{{ t("plans.page.q-carry", "Do credits roll over?") }}</h3>
      <p>{{ t("plans.page.a-carry", "Monthly credits don't. Top-ups do.") }}</p>
      <h3>{{ t("plans.page.q-cancel", "Can I cancel?") }}</h3>
      <p>{{ t("plans.page.a-cancel", "Yes, any time, from Your account. Your plan runs to the end of the month you paid for. You keep your words and everything you've read. Your channel and podcast subscriptions pause.") }}</p>
    </section>
  </div>
</main>
{%- if checkout %}
{#- The one view that opens Paddle's checkout (design.md §12, "/plans alone loads
    Paddle's checkout script", 2026-11-17): a transaction our server made for this
    account a moment ago. Paddle.js from Paddle's CDN, as Paddle requires, and the
    overlay opened on that transaction by `plans-checkout.js`. No other page, and no
    other view of this one, carries either. -#}
<div id="paddle-checkout" hidden data-transaction="{{ checkout.transaction }}" data-token="{{ checkout.token }}" data-environment="{{ checkout.environment }}" data-failed="{{ t("plans.page.pay-failed", "The checkout didn't open. Try again in a minute.") }}"></div>
<script src="{{ checkout.script }}"></script>
{{ script('plans-checkout.js') }}
{%- endif %}
{% include '_foot.html.j2' %}
<script>window.TARGUM_LANGUAGES = { {% for code, name in languages %}"{{ code }}": "{{ name }}"{% if not loop.last %}, {% endif %}{% endfor %} };</script>
{% if strings %}<script>window.TARGUM_STRINGS = {{ strings|tojson }};</script>
{% endif %}{{ script('strings.js') }}
{{ script('lang.js') }}
{{ script('sync.js') }}
{{ script('account.js') }}
</body>
</html>
