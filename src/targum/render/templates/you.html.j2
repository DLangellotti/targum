<!doctype html>
<html lang="{{ page_language|default('en') }}">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>{{ t("you.page.you-targum", "Your account — targum") }}</title>
{% include '_icons.html.j2' %}
{{ styles('tokens.css', 'shared.css', 'chrome.css', 'words.css', 'library.css', 'you.css') }}
{{ hebrew_face() }}
{{ script('keep.js') }}
{#- The key, before anything that reads it (targum-internal#343). `building.js`, and
    the conversation's pill, the followed series and the palette in the nav, each read `window.TARGUM_KEY`
    once as they load; it was set in a script at the foot of the body, so on a local serve
    they held an empty key for the life of the page and the bell, the followed series and
    the chat list were refused. The hosted box has no key and was never affected. -#}
<script>window.TARGUM_KEY = "{{ token }}";</script>
</head>
<body class="you">
{% set here = 'you' %}{% set title = t("you.page.title", "Your account") %}
{% include '_nav.html.j2' %}
{{ script('building.js') }}

<main class="account">
  {#- Signed out there is nothing here to show, and saying so beats an empty form. -#}
  <section class="card" id="stranger" hidden>
    <p class="note">{{ t("you.page.sign-in-to-see", "Sign in to see your account.") }}</p>
  </section>

  {#- The three answers that are not the account (targum-internal#469, B1 and B2): still
      asking, which is drawn at first paint and says more past three seconds; not reached;
      and offline. None of them says "sign in": the reader may well be signed in. -#}
  <section class="card" id="you-loading" role="status">
    <p class="note">{{ t("you.page.getting-your-account", "We're getting your account.") }}</p>
    <p class="note" id="you-slow" hidden>{{ t("you.page.taking-longer", "This is taking longer than usual.") }}
      <button type="button" class="btn ghost outline" id="you-slow-again">{{ t("fault.try-again", "Try again") }}</button></p>
  </section>
  <section class="card" id="you-unreachable" role="alert" hidden>
    <p class="note">{{ t("you.page.could-not-reach", "We couldn't reach your account just now.") }}</p>
    <p class="ending-row"><button type="button" class="btn tonal" id="you-reach-again">{{ t("fault.try-again", "Try again") }}</button></p>
  </section>
  <section class="card" id="you-offline" role="status" hidden>
    <p class="note">{{ t("you.page.offline", "You're offline. Your account needs a connection. Texts saved on this device still open.") }}</p>
    <p class="ending-row"><a class="btn tonal" href="/you/saved">{{ t("you.page.open-saved", "Open saved texts") }}</a></p>
  </section>

  {#- After Delete (targum-internal#469, B5): one card that says what happened, heard by a
      screen reader, and a way on. It replaces the others; nothing redirects on a timer. -#}
  <section class="card" id="you-closed" role="status" tabindex="-1" hidden>
    <h2 class="section-title">{{ t("you.page.closing-title", "Your account is closing") }}</h2>
    <p class="note" id="you-closed-said"></p>
    <p class="note">{{ t("you.page.closed-says", "Your connections, playlists, subscriptions and prompts have gone, and so has the Weekly News Digest. We'll delete the rest in {grace} days and email you when it's done. To change your mind before then, email hello@targum.page.", grace=grace) }}</p>
    <p class="ending-row"><a class="btn tonal" href="/">{{ t("you.page.go-to-targum", "Go to targum") }}</a></p>
  </section>

  {#- Your account as the boards draw it (AccountDesk, AccountPhone, PlanAccount, ConnYou;
      design.md §12, "Your account is the board's sections", 2026-10-09): Credits, Plan,
      Your languages, What's connected and Account, a card each in one column. -#}

  {#- Credits, first (AccountDesk): the balance in the serif, the rate and the day it
      comes back under it, and a meter of what is left. Filled by `account.js` from who is
      signed in; absent where there is no cap. -#}
  <section class="card credits" id="credits" aria-labelledby="credits-title" hidden>
    <h2 class="section-title" id="credits-title">{{ t("you.page.credits", "Credits") }}</h2>
    <p class="credits-big"><span class="credits-n" id="hours-line"></span> <span class="credits-unit">{{ t("you.page.left-this-month", "left this month") }}</span></p>
    <p class="credits-rate" id="credits-rate"></p>
    <span class="meter is-spent credits-meter" id="credits-meter" aria-hidden="true"><span></span></span>
    <p class="credits-low" id="credits-low" hidden></p>
    <p class="note">{{ t("you.page.credits-rate-reading", "One credit is a minute of audio or video. Reading uses none.") }}</p>
  </section>

  {#- Plan (PlanAccount): there is one plan while targum is in early access, and the pay
      buttons are drawn and greyed with "Payments open soon" beside them until there is
      somewhere to pay (design.md §12, "A refusal is drawn on one of five surfaces"). -#}
  <section class="card plan" id="plan" aria-labelledby="plan-title" hidden>
    <h2 class="section-title" id="plan-title">{{ t("you.page.plan", "Plan") }}</h2>
    <ul class="rows acct-rows">
      <li class="row">
        <span class="row-main">
          <b class="acct-name">{{ t("you.page.early-access", "Early access") }}</b>
          <span class="acct-says" id="plan-line">{{ t("you.page.early-access-says", "Every account has the same month of credits while targum is in early access") }}</span>
        </span>
      </li>
      <li class="row">
        <span class="row-main">
          <span class="acct-name">{{ t("you.page.top-up", "Top up") }}</span>
          <span class="acct-says">{{ t("you.page.top-up-says", "Credits you top up stay until you use them") }}</span>
        </span>
        <span class="acct-end">
          <button type="button" class="btn ghost outline" disabled aria-describedby="soon-plan">{{ t("you.page.top-up-60", "60 credits") }}</button>
          <button type="button" class="btn ghost outline" disabled aria-describedby="soon-plan">{{ t("you.page.top-up-180", "180 credits") }}</button>
        </span>
      </li>
    </ul>
    <p class="acct-soon" id="soon-plan"><svg viewBox="0 0 16 16" aria-hidden="true" focusable="false"><circle cx="8" cy="8" r="5.75"/><path d="M8 5v3.2l2 1.3"/></svg>{{ t("fault.payments-soon", "Payments open soon") }}</p>
  </section>

  {#- The plan, with plans on (board PlanAccount; design.md §12, "Free and Plan, behind a
      switch", 2026-10-09). Drawn by `you.js` from `/account/me`'s `plan` in place of the
      early-access card above, which is what every account sees while the switch is off.
      Free: what it holds, what a plan gives, and Start a plan greyed. Plan: the month,
      when the credits come back, Top up, Switch and Cancel, every one greyed until there
      is a payment provider. Receipts and a card are not drawn: there are none. -#}
  <section class="card plan plan-on" id="plan-on" aria-labelledby="plan-on-title" hidden>
    <div class="acct-head">
      <h2 class="section-title" id="plan-on-title">{{ t("you.page.plan", "Plan") }}</h2>
      <a class="acct-link" id="plan-see" href="/plans">{{ t("fault.see-plans", "See plans") }}</a>
    </div>
    <div id="plan-free" hidden>
      <ul class="rows acct-rows">
        <li class="row">
          <span class="row-main">
            <b class="acct-name">{{ t("you.page.plan-free", "Free") }}</b>
            <span class="acct-says" id="plan-free-says"></span>
          </span>
        </li>
        <li class="row" id="plan-words-row" hidden>
          <span class="row-main">
            <span class="acct-name">{{ t("you.page.plan-word-list", "Your word list") }}</span>
            <span class="acct-says" id="plan-words"></span>
          </span>
          <a class="acct-link acct-end" id="plan-words-more" href="/plans" hidden>{{ t("fault.see-plans", "See plans") }}</a>
        </li>
      </ul>
      <p class="plan-offer" id="plan-offer"></p>
      <p class="plan-pay-row">
        <button type="button" class="btn soon" disabled aria-describedby="soon-free">{{ t("fault.start-a-plan", "Start a plan") }}</button>
        <span class="acct-soon" id="soon-free"><svg viewBox="0 0 16 16" aria-hidden="true" focusable="false"><circle cx="8" cy="8" r="5.75"/><path d="M8 5v3.2l2 1.3"/></svg>{{ t("fault.payments-soon", "Payments open soon") }}</span>
      </p>
    </div>
    <div id="plan-paid" hidden>
      <ul class="rows acct-rows">
        <li class="row">
          <span class="row-main">
            <b class="acct-name">{{ t("you.page.plan-monthly", "Monthly plan") }}</b>
            <span class="acct-says" id="plan-paid-says"></span>
          </span>
        </li>
        <li class="row">
          <span class="row-main">
            <span class="acct-name" id="plan-back"></span>
            <span class="acct-says">{{ t("you.page.plan-back-says", "Monthly credits start fresh then, and don't carry over") }}</span>
          </span>
        </li>
        <li class="row acct-wrap">
          <span class="row-main">
            <span class="acct-name">{{ t("you.page.top-up", "Top up") }}</span>
            <span class="acct-says">{{ t("you.page.top-up-stays", "Credits you top up stay until you use them") }}</span>
          </span>
          <span class="acct-end">
            <span class="seg plan-top-ups" id="plan-top-ups"></span>
            <button type="button" class="btn soon" disabled aria-describedby="soon-paid">{{ t("you.page.top-up", "Top up") }}</button>
          </span>
        </li>
        <li class="row">
          <span class="row-main">
            <span class="acct-name">{{ t("you.page.plan-quarterly", "Pay every 3 months instead") }}</span>
            <span class="acct-says">{{ t("you.page.plan-quarterly-says", "From your next renewal") }}</span>
          </span>
          <span class="acct-end"><button type="button" class="btn ghost outline" disabled aria-describedby="soon-paid">{{ t("you.page.plan-switch", "Switch") }}</button></span>
        </li>
        <li class="row">
          <span class="row-main">
            <span class="acct-name">{{ t("you.page.plan-cancel", "Cancel your plan") }}</span>
            <span class="acct-says">{{ t("you.page.plan-cancel-says", "You move to Free when the time you've paid for ends. Your channel and podcast subscriptions pause, and you can start them again any time.") }}</span>
          </span>
          <span class="acct-end"><button type="button" class="btn ghost outline" disabled aria-describedby="soon-paid">{{ t("you.page.plan-cancel-press", "Cancel plan") }}</button></span>
        </li>
      </ul>
      <p class="acct-soon" id="soon-paid"><svg viewBox="0 0 16 16" aria-hidden="true" focusable="false"><circle cx="8" cy="8" r="5.75"/><path d="M8 5v3.2l2 1.3"/></svg>{{ t("fault.payments-soon", "Payments open soon") }}</p>
    </div>
  </section>

  {#- Your languages, as rows (AccountDesk): each one being learned with Remove, Start
      another from the rest, and the language meanings, translations and menus are in.
      Drawn by `you.js` from the lists below; the rung named on arrival is its last row. -#}
  <section class="card" id="languages" aria-labelledby="languages-title" hidden>
    <h2 class="section-title" id="languages-title">{{ t("you.page.your-languages", "Your languages") }}</h2>
    <ul class="rows acct-rows" id="you-learning"></ul>
    <ul class="rows acct-rows acct-more">
      <li class="row">
        <label class="row-main acct-name" for="you-start"><span class="acct-wide">{{ t("you.page.start-another", "Start another language") }}</span><span class="acct-narrow">{{ t("you.page.start-another-short", "Start another") }}</span></label>
        <select class="acct-pick" id="you-start"></select>
      </li>
      <li class="row">
        <label class="row-main" for="you-reads">
          <span class="acct-name">{{ t("you.page.translate-into", "Translate into") }}</span>
          <span class="acct-says">{{ t("you.page.translate-into-says", "Meanings and translations, and the menus and buttons too") }}</span>
        </label>
        <select class="acct-pick" id="you-reads"></select>
      </li>
      {#- The rung named on arrival (design.md §12, 2026-10-07). It seeds the first text,
          the Library's band and how hard the conversation writes; since 2026-10-12 it no
          longer draws any word as known. -#}
      <li class="row">
        <label class="row-main" for="you-level">
          <span class="acct-name">{{ t("you.page.your-hebrew", "Your Hebrew") }}</span>
          <span class="acct-says">{{ t("you.page.level-note", "Where the Library starts you, and how simple our Hebrew is in chat") }}</span>
        </label>
        <select class="acct-pick" id="you-level"></select>
      </li>
      {#- How the conversation says "you" in Hebrew (2026-09-14; a row again after #695,
          design.md §12). Every second person in Hebrew has a gender, and nikkud makes it
          visible. Shown only while Hebrew is being learned; `you.js` marks the one the
          account keeps and saves a press at `/account/address`. -#}
      <li class="row" id="you-address-row" hidden>
        <span class="row-main">
          <span class="acct-name" id="address-label">{{ t("you.page.address", "In Hebrew, we talk to you") }}</span>
          <span class="acct-says">{{ t("you.page.address-says", "Hebrew says “you” one way to a man and another to a woman") }}</span>
        </span>
        <span class="seg" id="you-address" role="radiogroup" aria-labelledby="address-label">
          <button type="button" role="radio" aria-checked="false" id="address-m">{{ t("you.page.address-m", "As a man") }}</button>
          <button type="button" role="radio" aria-checked="false" id="address-f">{{ t("you.page.address-f", "As a woman") }}</button>
        </span>
      </li>
    </ul>
    <p class="said" id="you-languages-said" role="status" hidden></p>
  </section>

  {#- What is connected, and the way to end it (targum-internal#80; board ConnYou): one
      row an app, what it may do, and Disconnect. Here because design.md §12 ("A scope is
      a press that lasts") rests on the grant being visible somewhere a reader can take it
      back. With nothing connected it says so in one quiet line, with "Connect an app"
      (targum-internal#469, polish 1). -#}
  <section class="card" id="connections" aria-labelledby="connections-title" hidden>
    <div class="acct-head">
      <h2 class="section-title" id="connections-title">{{ t("you.page.what-s-connected", "What's connected") }}</h2>
      <a class="acct-link" id="connect-link" href="/connect">{{ t("you.page.connect-another", "Connect another app") }}</a>
    </div>
    <p class="note" id="connections-none" hidden>{{ t("you.page.connections-none", "Nothing is connected yet. Connect Claude, ChatGPT or another app to use targum from inside it.") }}</p>
    <p class="note" id="connections-says">{{ t("you.page.connections-says", "Apps you've connected targum to, and what each one may do. Disconnecting takes effect at once.") }}</p>
    <ul class="acct-conns" id="connection-rows"></ul>
    <p class="said" id="connections-said" role="status" hidden></p>
  </section>

  {#- What a reader wrote for their connector to offer (targum-internal#80, note 17;
      board ConnYou's "Your prompts"). Shown only once something is connected. -#}
  <section class="card" id="prompts" aria-labelledby="prompts-title" hidden>
    <h2 class="section-title" id="prompts-title">{{ t("you.page.your-prompts", "Your prompts") }}</h2>
    <p class="note">{{ t("you.page.prompts-says", "Things you ask for often. Write one here and it appears in Claude or ChatGPT by name, next to ours.") }}</p>
    <ul class="rows acct-rows" id="prompt-rows"></ul>
    <label class="field">
      <span>{{ t("you.page.prompt-name", "What to call it") }}</span>
      <input type="text" id="prompt-name" maxlength="40" spellcheck="false" autocapitalize="off">
    </label>
    <label class="field">
      <span>{{ t("you.page.prompt-says", "What it should do") }}</span>
      <input type="text" id="prompt-says" maxlength="2000">
    </label>
    <p class="ending-row">
      <button type="button" class="btn filled" id="prompt-save">{{ t("you.page.prompt-save", "Save") }}</button>
    </p>
    <p class="said" id="prompts-said" role="status" hidden></p>
  </section>

  {#- Telegram (targum-internal#328): hidden unless the deployment has a bot. -#}
  <section class="card" id="telegram" aria-labelledby="telegram-title" hidden>
    <h2 class="section-title" id="telegram-title">{{ t("you.telegram.heading", "Telegram") }}</h2>
    <p class="note">{{ t("you.telegram.says", "Send our bot a voice note, a video, a picture, a PDF or some text, and we'll add it to Your targums. If you forward a message, we don't keep who it came from.") }}</p>
    <ul class="rows acct-rows" id="telegram-rows"></ul>
    <p class="ending-row">
      <button type="button" class="btn tonal" id="telegram-go">{{ t("you.telegram.link", "Link Telegram") }}</button>
    </p>
    <p class="said" id="telegram-said" role="status" hidden></p>
  </section>

  {#- Account (AccountDesk): the address, what is saved on this device, the export, the
      two switches that change what targum does with what you do, Sign out, and Delete,
      apart and in clay. -#}
  <section class="card" id="ending" aria-labelledby="ending-title" hidden>
    <h2 class="section-title" id="ending-title">{{ t("you.page.account", "Account") }}</h2>
    <ul class="rows acct-rows">
      <li class="row">
        <span class="row-main">
          <span class="acct-name">{{ t("you.page.email", "Email") }}</span>
          <span class="acct-says" id="you-email"></span>
        </span>
      </li>
      {#- What opens without a connection (design.md §12, 2026-10-09): this browser's,
          so a page of its own. -#}
      <li class="row">
        <span class="row-main">
          <span class="acct-name">{{ t("you.page.saved-on-device", "Saved on this device") }}</span>
          <span class="acct-says">{{ t("you.page.saved-on-device-says", "Texts that open without a connection") }}</span>
        </span>
        <a class="btn ghost outline acct-end" href="/you/saved">{{ t("you.page.open", "Open") }}</a>
      </li>
      <li class="row">
        <span class="row-main">
          <span class="acct-name">{{ t("you.page.export", "Export your data") }}</span>
          <span class="acct-says"><span class="acct-wide">{{ t("you.page.export-says", "Your word list, your chats and your reading record, in one file") }}</span><span class="acct-narrow">{{ t("you.page.export-says-short", "Word list, chats and reading record") }}</span></span>
        </span>
        <a class="btn ghost outline acct-end" id="you-export" href="/account/export" download>{{ t("you.page.download", "Download") }}</a>
      </li>
      {#- What is recorded of a sitting (targum-internal#127): drawn only where this box
          keeps such a record (`TARGUM_EVENTS`), with both controls beside it. -#}
      <li class="row acct-wrap" id="record" hidden>
        <span class="row-main">
          <span class="acct-name">{{ t("you.page.what-we-record", "What we record as you go") }}</span>
          <span class="acct-says">{{ t("you.page.record-short", "We note the words you look up and the sections you finish, so Your Progress can say how far you've come. We keep it as long as you keep your account.") }}</span>
          {#- What the account keeps with the words for "How you got here" (design.md §12,
              2026-10-30; Privacy Notice clause 3.2): not this record, so neither the switch
              nor Erase reaches it. -#}
          <span class="acct-says">{{ t("you.page.record-words", "With your word list we also keep the day each word became known, and the day you first met each word in a section you finished. They aren't part of this record, so they stay until you delete your account.") }}</span>
        </span>
        <span class="acct-end">
          <button type="button" class="btn ghost outline" id="record-switch" aria-pressed="true"></button>
          <button type="button" class="btn ghost outline danger" id="record-erase">{{ t("you.page.record-erase", "Erase what's recorded") }}</button>
        </span>
        <p class="said" id="record-said" role="status" hidden></p>
      </li>
      {#- Correcting a meaning (targum-internal#164, door 3): a thing agreed to once, so
          it is here and not in the reader. -#}
      <li class="row acct-wrap" id="correcting">
        <span class="row-main">
          <span class="acct-name">{{ t("you.page.correcting", "Correcting a meaning") }}</span>
          <span class="acct-says">{{ t("you.page.correcting-short", "Tell us from a word's card when its meaning is wrong. A person checks it before anything changes. You share your correction under our contribution grant.") }} <a class="acct-inline" href="https://github.com/DLangellotti/targum/blob/master/CONTRIBUTING.md#correcting-a-meaning-and-what-that-grants">{{ t("you.page.correcting-read", "Read the grant") }}</a></span>
        </span>
        <span class="acct-end">
          <button type="button" class="btn ghost outline" id="grant-go"></button>
        </span>
        <p class="said" id="grant-said" role="status" hidden></p>
      </li>
      <li class="row">
        <button type="button" class="btn ghost outline" id="you-out">{{ t("you.page.sign-out", "Sign out") }}</button>
      </li>
      <li class="row acct-wrap acct-delete">
        <span class="row-main">
          <span class="acct-name acct-clay">{{ t("you.page.delete-your-account", "Delete your account") }}</span>
          <span class="acct-says">{{ t("you.page.delete-says", "This deletes your texts and uploads, your word list, your chats and your record.") }}
            {{ t("you.page.we-wait-seven-days-before-deleting", "Your connections, playlists, subscriptions and prompts go at once, and so does the Weekly News Digest. We delete the rest after seven days and email you when it's done. To change your mind before then, email hello@targum.page.") }}
            {%- if legal_is_public() %} <a class="acct-inline" href="/deletion">{{ t("you.page.what-that-means", "What that means") }}</a>.{%- endif %}</span>
        </span>
        <span class="acct-end">
          <button type="button" class="btn ghost outline" id="you-keep" hidden>{{ t("you.page.keep-my-account", "Keep my account") }}</button>
          <button type="button" class="btn ghost outline danger" id="you-forget">{{ t("you.page.delete-account", "Delete account") }}</button>
        </span>
      </li>
    </ul>
    <p class="said" id="you-ending-said" role="status" hidden></p>
  </section>
</main>
{% include '_foot.html.j2' %}

<script>
window.TARGUM_KEY = "{{ token }}";
{#- The language menu stands in the bar here too, so the bar does not move between pages
    (2026-09-14). -#}
window.TARGUM_LANGUAGES = { {% for code, name in languages %}"{{ code }}": "{{ name }}"{% if not loop.last %}, {% endif %}{% endfor %} };
window.TARGUM_READING = {{ reading|tojson }};
window.TARGUM_INTO = {{ into|tojson }};
window.TARGUM_REQUIRED = {{ required|tojson }};
{% if strings %}window.TARGUM_STRINGS = {{ strings|tojson }};
{% endif %}</script>
{{ script('strings.js') }}
{{ script('lang.js') }}
{{ script('sync.js') }}
{{ script('account.js') }}
{{ script('you.js') }}
</body>
</html>
