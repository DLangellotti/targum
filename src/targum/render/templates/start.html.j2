<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>targum</title>
{% include '_icons.html.j2' %}
<style>{{ asset('reader.css') }}{{ asset('start.css') }}{{ asset('library.css') }}</style>
<script>{{ asset('theme.js') }}</script>
</head>
<body class="start">
{% set here = 'read' %}
{% include '_nav.html.j2' %}
<main class="start-main">
  <p class="lede">Read Hebrew with the translation beside it.</p>

  {% if no_key %}
  <p class="notice" role="status">{{ no_key }}</p>
  {% endif %}

  <section class="step">
    <h2>What do you want to read?</h2>

    <div class="drop" id="drop" tabindex="0">
      <p class="drop-label">Drop a book or an article here</p>
      <p class="drop-note">EPUB, plain text, or markdown</p>
      <input type="file" id="file" accept=".txt,.md,.markdown,.epub" hidden>
      <button type="button" id="choose">Choose a file</button>
      <button type="button" id="unchoose" class="unchoose" hidden>Use something else</button>
    </div>

    <p class="or">or paste a link</p>

    <label class="field">
      <input type="text" id="source" placeholder="https://…" spellcheck="false">
    </label>
    <p class="hint">A news story, an essay, a blog post, a Wikipedia article. Not
      something behind a login or a paywall, and not a PDF.</p>
    <p class="hint">Looking for a book? There are some
      <a class="to-library" href="/library">picked out for you</a>, ready to read.</p>
  </section>

  <section class="step">
    <h2>Which languages?</h2>
    <div class="options">
      <label class="field short">
        <span>I am reading</span>
        <select id="from">
          {% for code, name in languages %}<option value="{{ code }}"{% if code == 'he' %} selected{% endif %}>{{ name }}{% if code != 'he' %} (beta){% endif %}</option>{% endfor %}
          <option value="">work it out for me</option>
        </select>
      </label>
      <label class="field short">
        <span>Translate into</span>
        <select id="to">
          {% for code, name in languages %}<option value="{{ code }}"{% if code == 'en' %} selected{% endif %}>{{ name }}</option>{% endfor %}
        </select>
      </label>
    </div>
    <p class="hint" id="from-beta" hidden></p>
  </section>

  <button type="button" id="go" class="go">Read this</button>
  <p class="hint caps">Long books take longer to get ready. You will see roughly how
    long before it starts.</p>
  <div class="status" id="status" hidden></div>

</main>
{% include '_foot.html.j2' %}
<script>
window.TARGUM_KEY = "{{ token }}";
window.TARGUM_LIMIT = {{ limit }};
window.TARGUM_LANGUAGES = { {% for code, name in languages %}"{{ code }}": "{{ name }}"{% if not loop.last %}, {% endif %}{% endfor %} };
</script>
<script>{{ asset('lang.js') }}</script>
<script>{{ asset('sync.js') }}</script>
<script>{{ asset('account.js') }}</script>
<script>{{ asset('start.js') }}</script>
</body>
</html>
