<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>targum</title>
<style>{{ asset('reader.css') }}{{ asset('start.css') }}</style>
</head>
<body class="start">
<main class="start-main">
  <h1>targum</h1>
  <p class="lede">Read in the language you are learning, translation beside it.</p>

  <section class="step">
    <h2>What do you want to read?</h2>

    <div class="drop" id="drop" tabindex="0">
      <p class="drop-label">Drop a book or an article here</p>
      <p class="drop-note">EPUB, plain text, or markdown</p>
      <input type="file" id="file" accept=".txt,.md,.markdown,.epub" hidden>
      <button type="button" id="choose">Choose a file</button>
    </div>

    <p class="or">or paste a link</p>

    <label class="field">
      <input type="text" id="source" placeholder="https://www.bbc.com/news/articles/…" spellcheck="false">
    </label>
    <p class="hint">Any article, essay or wiki page. Not logins, paywalls or web apps.</p>
    <p class="hint">Also by name: <code>gutenberg:1342</code>,
      <code>wikisource:Walden</code>. No PDF.</p>
  </section>

  <section class="step">
    <h2>Which languages?</h2>
    <div class="options">
      <label class="field short">
        <span>I am learning</span>
        <select id="from">
          <option value="">detect it</option>
          {% for code, name in languages %}<option value="{{ code }}">{{ name }}</option>{% endfor %}
        </select>
      </label>
      <label class="field short">
        <span>My language</span>
        <select id="to">
          {% for code, name in languages %}<option value="{{ code }}"{% if code == 'en' %} selected{% endif %}>{{ name }}</option>{% endfor %}
        </select>
      </label>
    </div>
  </section>

  <button type="button" id="go" class="go">Read this</button>
  <div class="status" id="status" hidden></div>

  <section class="library" id="library" hidden>
    <div class="library-head">
      <h2>Your library</h2>
      <span class="library-sum" id="library-sum"></span>
      <span class="library-export" id="library-export"></span>
      <span class="library-note" id="library-note" hidden></span>
    </div>
    <ul id="library-list"></ul>
  </section>
</main>
<script>
window.TARGUM_KEY = "{{ token }}";
window.TARGUM_LIMIT = {{ limit }};
window.TARGUM_LANGUAGES = { {% for code, name in languages %}"{{ code }}": "{{ name }}"{% if not loop.last %}, {% endif %}{% endfor %} };
</script>
<script>{{ asset('start.js') }}</script>
</body>
</html>
