<!doctype html>
<html lang="en">
<head>
{#- Its own head rather than `_public_head.html.j2`. That one is written for the pages a
    search engine sees — canonical, og:title, JSON-LD — and every one of those is wrong
    here. This page wants the opposite: no index, no follow, no archive, and nothing
    that would put an account address in a preview card if the address were ever
    pasted. -#}
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="robots" content="noindex, nofollow, noarchive">
<meta name="referrer" content="no-referrer">
<title>back office</title>
{% include '_icons.html.j2' %}
{{ styles('tokens.css', 'shared.css', 'reader.css', 'public.css') }}
{#- Carried because a `name` on an account is whatever the person typed, and on this box
    that is as likely to be Hebrew as not. Without it the page falls back to whatever the
    machine has, which for Hebrew on a stock Mac is a font with no accents in it. -#}
{{ hebrew_face() }}
{{ script('keep.js') }}
<style>
  .bo { max-inline-size: 60rem; margin: 0 auto; padding: 2rem 1rem 4rem; }
  .bo h1 { font-size: 1.75rem; margin: 0 0 0.25rem; }
  .bo .taken { font-size: 0.8125rem; color: var(--ink-soft); margin: 0 0 2rem; }
  .bo h2 { font-size: 1.0625rem; margin: 2rem 0 0.75rem; }
  .bo table { inline-size: 100%; border-collapse: collapse; font-size: 0.9375rem; }
  .bo th, .bo td { text-align: start; padding: 0.4rem 0.6rem; border-block-end: 1px solid var(--rule); }
  .bo th { font-size: 0.8125rem; color: var(--ink-soft); font-weight: 600; }
  /* Every number on this page is a count of a real thing, so they are set the way the
     ledger sets its counts: serif, tabular, still as they change (design.md §5). */
  .bo .n { font-variant-numeric: tabular-nums; text-align: end; }
  .bo .quiet { color: var(--ink-soft); }
  /* A day somebody read on. A mark rather than a word, and drawn rather than typed:
     §7 wants no emoji anywhere, and a tick pasted into a cell is one. */
  .bo .read { display: inline-block; inline-size: 0.5rem; block-size: 0.5rem;
              border-radius: 50%; background: var(--leaf); }
  .bo .nothing { color: var(--ink-soft); }
  .bo tr.empty td { color: var(--ink-soft); }
  .bo .note { font-size: 0.8125rem; color: var(--ink-soft); margin-block-start: 2rem; }
  .bo .decide { display: flex; flex-wrap: wrap; gap: 0.3rem; align-items: center; }
  .bo .decide select, .bo .decide input, .bo .decide button {
    font: inherit; font-size: 0.8125rem; padding: 0.25rem 0.5rem;
    border: 1px solid var(--rule); border-radius: 4px; background: var(--paper); color: var(--ink);
  }
  .bo .decide button { cursor: pointer; }
  .bo .trace pre { font-size: 0.75rem; white-space: pre-wrap; margin: 0.4rem 0 0; color: var(--ink-soft); }
  .bo a.topup { font-size: 0.8125rem; font-weight: 600; white-space: nowrap; }
  /* The visitors' days, drawn as bars. Sized by attribute rather than by style,
     because the page's policy names its style blocks by hash and admits no other. */
  .bo .days { inline-size: 100%; block-size: 4rem; display: block; margin: 0 0 0.5rem; }
  .bo .days rect { fill: var(--leaf); }
  .bo .days rect.part { fill: var(--rule); }
  .bo .tallies { display: grid; grid-template-columns: repeat(auto-fit, minmax(18rem, 1fr)); gap: 0 2rem; margin-block-end: 1.5rem; }
  /* A long address wraps in its own cell. Unbroken, a reader's percent-encoded path
     widened its table past the grid's column and its counts stood under the next
     heading (2026-09-28). */
  .bo .tallies table { table-layout: fixed; }
  .bo .tallies td:first-child { overflow-wrap: anywhere; }
  .bo .tallies td.n { inline-size: 4rem; }
  .bo .tallies h3 { font-size: 0.875rem; margin: 1rem 0 0.25rem; }
  /* The tabs: a row of names with the open one underlined in ink, the way a page's
     own sections are marked; nothing to learn. */
  .bo .bo-tabs { display: flex; flex-wrap: wrap; gap: 0.25rem 1.5rem; margin: 0 0 1.5rem;
                 border-block-end: 1px solid var(--rule); }
  .bo .bo-tabs a { padding: 0.5rem 0 0.6rem; margin-block-end: -1px; color: var(--ink-soft);
                   font-weight: 600; text-decoration: none; border-block-end: 2px solid transparent; }
  .bo .bo-tabs a:hover { color: var(--ink); }
  .bo .bo-tabs a[aria-selected="true"] { color: var(--ink); border-block-end-color: var(--ink); }
  .bo .tab-panel > h2:first-child, .bo .tab-panel > p:first-child { margin-block-start: 0; }
  /* The readers' days, one row each (2026-10-15). Thirty cells fit at desk width and
     scroll in their own box on a phone, never the page. */
  .bo .strip-wrap { overflow-x: auto; }
  .bo .strip th, .bo .strip td { padding: 0.3rem 0.15rem; }
  .bo .strip td:first-child, .bo .strip th:first-child { padding-inline-end: 0.6rem; white-space: nowrap; }
  .bo .strip .d { text-align: center; inline-size: 1.1rem; font-size: 0.6875rem; }
  .bo .strip .on, .bo .strip .off { display: inline-block; inline-size: 0.6rem; block-size: 0.6rem; border-radius: 2px; }
  .bo .strip .on { background: var(--leaf); }
  .bo .strip .off { background: var(--rule); }
  .bo .reach td:first-child { inline-size: 70%; }
  .bo details.let-in { margin-block-start: 1rem; }
  .bo details.let-in summary { cursor: pointer; color: var(--ink-soft); font-weight: 600; }
  .bo a.write { font-size: 0.8125rem; font-weight: 600; }
  .bo .told .said-text { margin: 0; white-space: pre-wrap; overflow-wrap: anywhere; }
  .bo .told .told-where { margin: 0.25rem 0 0; font-size: 0.8125rem; overflow-wrap: anywhere; }
  /* A list longer than a page (targum-internal#542): a search, an order and the way to
     the next fifty, as a GET form and plain links. */
  .bo .find { margin: 0 0 0.75rem; }
  .bo .find input[type="search"] { min-inline-size: 12rem; flex: 1 1 12rem; max-inline-size: 22rem; }
  .bo .pager { display: flex; flex-wrap: wrap; gap: 0.25rem 1rem; align-items: baseline;
               margin: 0.75rem 0 0; font-size: 0.875rem; }
  .bo .pager a { font-weight: 600; }
  .bo p.count { font-size: 0.8125rem; margin: 0 0 0.5rem; }
  /* A sign-up's flags under its address (targum-internal#544): ink-soft like every
     other aside here; the count in ink so a row with three reads at a glance. */
  .bo p.flags { margin: 0.2rem 0 0; font-size: 0.75rem; color: var(--ink-soft); }
  .bo p.flags .flag-count { color: var(--ink); font-weight: 600; }
  .bo label.fake { font-size: 0.8125rem; display: inline-flex; gap: 0.3rem; align-items: center; }
  .bo .decide button[value="accept"] { background: var(--ink); color: var(--paper); border-color: var(--ink); font-weight: 600; }
</style>
</head>
<body class="public">
<main class="bo">
  <h1>back office</h1>
  {#- The four numbers that say whether anything needs doing, above the tabs so they
      are the first thing read whichever tab is open (2026-09-28). -#}
  <p class="taken">{{ survey.waiting_for_a_way_in }} waiting to be let in &middot;
    {% if visits and visits.any() %}{{ '%.1f'|format(visits.a_day()) }} visitors a day this week &middot; {% endif %}
    {%- set account_count = survey.accounts_total or survey.accounts|length %}
    {{ account_count }} account{{ '' if account_count == 1 else 's' }},
    {{ survey.active() }} active in the last {{ days }} days &middot;
    {{ told_open }} message{{ '' if told_open == 1 else 's' }} waiting on us &middot;
    {{ incidents|length }} incident{{ '' if incidents|length == 1 else 's' }} &middot; taken {{ survey.taken }}</p>

  {#- Four tabs on one page (David, 2026-09-28: "so much going on now"), switched in
      place by the script at the foot, which also keeps the open one in the address so
      a reload and a form's answer land where they left. Without the script the tabs
      are links to their panels and every panel shows, which is what this page was. -#}
  {#- What the last press said — the door's count, a decision on the shelf — above
      the tabs, so it is read whichever one the answer opens. -#}
  {% if said %}<p class="note said">{{ said }}</p>{% endif %}
  <nav class="bo-tabs" role="tablist" aria-label="Back office">
    <a href="#people" role="tab" aria-controls="tab-people">People</a>
    <a href="#traffic" role="tab" aria-controls="tab-traffic">Traffic</a>
    <a href="#shelf" role="tab" aria-controls="tab-shelf">Shelf</a>
    <a href="#operations" role="tab" aria-controls="tab-operations">Operations</a>
  </nav>

  <section class="tab-panel" id="tab-people" role="tabpanel" aria-label="People">
  {#- One account's credits, at `?who=<id>` (targum-internal#543): this month and all
      time by kind, and the latest jobs by date, kind, credits, cost and stage. Never a
      title or a source (clause 3.14). A conversation is counted in seconds. -#}
  {%- if reader %}
  <h2>{{ reader.email }}{% if reader.name %} <span class="quiet">{{ reader.name }}</span>{% endif %}</h2>
  <p class="taken">Joined {{ reader.joined }} &middot;
    {{ credits(reader.used) }}{% if reader.allowance is not none %} of {{ credits(reader.allowance) }}{% endif %} credits this month &middot;
    ${{ '%.2f'|format(reader.spent) }} this month &middot;
    <a href="{{ bo_url() }}">Back to accounts</a></p>
  {%- macro used(one) %}{% if one.kind == 'chat' %}{{ '%.0f'|format(one.seconds) }} s{% else %}{{ credits(one.seconds) }}{% endif %}{% endmacro %}
  <div class="strip-wrap"><table class="credits">
    <thead>
      <tr><th>Kind</th><th class="n">Jobs this month</th><th class="n">Credits</th><th class="n">Cost</th>
        <th class="n">Jobs, all time</th><th class="n">Credits</th><th class="n">Cost</th></tr>
    </thead>
    <tbody>
      {%- for month in reader.month %}{% set ever = reader.ever[loop.index0] %}
      <tr{% if not ever.jobs %} class="empty"{% endif %}>
        <td>{{ month.kind }}</td>
        <td class="n">{{ month.jobs }}</td><td class="n">{{ used(month) }}</td><td class="n">${{ '%.2f'|format(month.spent) }}</td>
        <td class="n">{{ ever.jobs }}</td><td class="n">{{ used(ever) }}</td><td class="n">${{ '%.2f'|format(ever.spent) }}</td>
      </tr>
      {%- endfor %}
    </tbody>
  </table></div>
  <p class="quiet count">A gift is targum's to pay and takes none of the month: its credits are what it was quoted at.</p>
  <h3>Latest jobs</h3>
  {%- if reader.recent %}
  <table class="credits">
    <thead><tr><th>Day</th><th>Kind</th><th class="n">Credits</th><th class="n">Cost</th><th>Stage</th></tr></thead>
    <tbody>
      {%- for one in reader.recent %}
      <tr><td class="quiet">{{ one.day or '—' }}</td><td>{{ one.kind }}</td><td class="n">{{ used(one) }}</td>
        <td class="n">${{ '%.2f'|format(one.spent) }}</td><td class="quiet">{{ one.stage }}</td></tr>
      {%- endfor %}
    </tbody>
  </table>
  {%- else %}
  <p class="quiet">No jobs yet.</p>
  {%- endif %}
  {%- endif %}
  {#- First what to do, then how the weeks went, then where readers get to (2026-10-15).
      The follow-up list names people, from what clause 3.2 already holds; the two
      tables below it name nobody. -#}
  <h2>Follow up</h2>
  {%- if survey.follow_up %}
  <table class="follow">
    <thead><tr><th>Address</th><th>Why</th><th></th></tr></thead>
    <tbody>
      {% for who in survey.follow_up %}
      <tr>
        <td>{{ who.email }}</td>
        <td class="quiet">{{ who.why }}</td>
        <td>
          {%- if who.action == 'resend' %}
          <form method="post" action="/back-office/resend" class="decide">
            <input type="hidden" name="email" value="{{ who.email }}">
            <button type="submit" aria-label="Send {{ who.email }} the invitation again">Send again</button>
          </form>
          {%- else %}
          {#- From the operator's own mail, so a reply comes back to a person. -#}
          <a class="write" href="mailto:{{ who.email|urlencode }}?subject=targum">Write</a>
          {%- endif %}
        </td>
      </tr>
      {% endfor %}
    </tbody>
  </table>
  {%- if survey.follow_up_total > survey.follow_up|length %}
  <p class="quiet count">The oldest {{ survey.follow_up|length }} of {{ survey.follow_up_total }}.</p>
  {%- endif %}
  {%- else %}
  <p class="quiet">Nobody to follow up with today.</p>
  {%- endif %}

  {#- What readers wrote to us through Tell us (targum-internal#456, clause 3.14): the
      one place this page holds words somebody wrote, because they wrote them to us.
      Open and asked first; fixed and won't fold away, and go a year after closing. -#}
  <h2 id="told">Tell us</h2>
  {%- set waiting_on_us = told|selectattr('state', 'in', ['open', 'asked'])|list %}
  {%- set settled = told|rejectattr('state', 'in', ['open', 'asked'])|list %}
  {%- macro told_rows(rows) %}
  <table class="told">
    <thead><tr><th>When</th><th>From</th><th>What they said</th><th>State</th></tr></thead>
    <tbody>
      {% for one in rows %}
      <tr>
        <td class="quiet">{{ one.when }}</td>
        <td>{% if one.email %}{{ one.email }}<br><a class="write" href="mailto:{{ one.email|urlencode }}?subject=targum">Write</a>{% else %}<span class="quiet">no account</span>{% endif %}</td>
        <td><p class="said-text" dir="auto">{{ one.said }}</p>
          <p class="quiet told-where">{{ one.page or 'no page' }} &middot; {{ one.viewport or 'no window' }} &middot; {{ one.language or 'no language' }} &middot; {{ one.build or 'no build' }}</p></td>
        <td>
          <form method="post" action="/back-office/told" class="decide">
            <input type="hidden" name="id" value="{{ one.id }}">
            <select name="state" aria-label="State of message {{ one.id }}">
              {% for state in told_states %}<option value="{{ state }}"{% if one.state == state %} selected{% endif %}>{{ state }}</option>{% endfor %}
            </select>
            <button type="submit">Save</button>
          </form>
        </td>
      </tr>
      {% endfor %}
    </tbody>
  </table>
  {%- endmacro %}
  {%- if waiting_on_us %}
  {{ told_rows(waiting_on_us) }}
  {%- else %}
  <p class="quiet">Nothing waiting on us.</p>
  {%- endif %}
  {%- if settled %}
  <details class="let-in">
    <summary>Closed ({{ settled|length }})</summary>
    {{ told_rows(settled) }}
  </details>
  {%- endif %}

  {%- if survey.batches %}
  <h2>Each week's readers</h2>
  <div class="strip-wrap"><table>
    <thead>
      <tr>
        <th>Let in the week of</th><th class="n">Let in</th><th class="n">Signed in</th>
        <th class="n">Opened a text</th><th class="n">Kept a word</th><th class="n">Came back</th>
        <th class="n">A second text</th><th class="n">Week 1</th><th class="n">Week 4</th>
      </tr>
    </thead>
    <tbody>
      {% for week in survey.batches %}
      <tr>
        <td>{{ week.week }}</td>
        <td class="n">{{ week.let_in }}</td>
        <td class="n">{{ week.signed_in }}</td>
        <td class="n">{{ week.opened }}</td>
        <td class="n">{{ week.kept }}</td>
        {#- Out of those who have had the chance, never out of everyone: a week let in
            yesterday reads "too soon", not nought. -#}
        {%- for n, over in [(week.came_back, week.old_enough), (week.second_text, week.old_enough), (week.week_one, week.week_one_over), (week.week_four, week.week_four_over)] %}
        <td class="n">{% if over %}{{ n }} of {{ over }}{% else %}<span class="quiet">too soon</span>{% endif %}</td>
        {%- endfor %}
      </tr>
      {% endfor %}
    </tbody>
  </table></div>
  {%- endif %}

  {%- if survey.readers %}
  <h2>How far readers get</h2>
  <table class="reach">
    <tbody>
      {% for part in survey.reach %}
      <tr{% if not part.people %} class="empty"{% endif %}>
        <td>{{ part.part }}</td>
        {#- A count of a count, never a percentage: with a few readers, one person is a
            swing of twenty points. -#}
        <td class="n">{{ part.people }} of {{ survey.readers }}</td>
      </tr>
      {% endfor %}
    </tbody>
  </table>
  <p class="quiet note">Your own addresses are not counted anywhere on this page.</p>
  {%- endif %}

  {#- The front door's list (targum-internal#69). Three numbers, no addresses: the rest
      of this page names nobody either. `on` is the number that matters — an address
      that answered its confirmation — and `pending` is how many have not yet. -#}
  {%- if survey.waiting %}
  <p class="taken">{{ survey.waiting.on }} confirmed their email &middot;
    {{ survey.waiting.pending }} not yet confirmed &middot;
    {{ survey.waiting.off }} left the list &middot;
    {{ survey.waiting_let_in or survey.waiting_list|selectattr('invited')|list|length }} let in
    {%- if survey.possibly_fake %} &middot; {{ survey.possibly_fake }} possibly fake{% endif %}</p>
  {#- Which page each joined through (targum-internal#388): `/aliyah` beside the front
      door is only worth keeping if somebody comes in by it. -#}
  {%- if survey.waiting_by_page %}
  <p class="taken">Joined from
    {%- for page, n in survey.waiting_by_page.items() %} {{ page or 'unknown' }} {{ n }}{% if not loop.last %} &middot;{% endif %}{% endfor %}</p>
  {%- endif %}
  {%- endif %}

  {#- Who is waiting, oldest first, which is the order they would be let in. The counts
      above answer "how many", which is the one question the operator does not have.
      Those already let in fold away beneath (2026-10-15): with the door open, they were
      most of the list, and the few still waiting were the rows to find. -#}
  {#- Paging (targum-internal#542). Each list draws fifty rows; the links keep the other
      list's search and page, and a search starts its own list from the first page. -#}
  {%- macro pager(listing, key, label) %}
  {%- if listing.pages() > 1 %}
  <nav class="pager" aria-label="{{ label }}">
    {%- if listing.page > 1 %}<a rel="prev" href="{{ bo_url(**{key: listing.page - 1}) }}">Previous</a>{% endif %}
    <span class="quiet">{{ listing.first_row() }}–{{ listing.last_row() }} of {{ listing.matches }}</span>
    {%- if listing.page < listing.pages() %}<a rel="next" href="{{ bo_url(**{key: listing.page + 1}) }}">Next</a>{% endif %}
  </nav>
  {%- endif %}
  {%- endmacro %}
  {%- macro carry(names) %}
    {%- for key, value in bo_kept() if key in names %}
    <input type="hidden" name="{{ key }}" value="{{ value }}">
    {%- endfor %}
  {%- endmacro %}
  {#- What might make a sign-up fake (targum-internal#544): each flag a plain reason, from
      what the store already holds. A reason to look, never a verdict. -#}
  {%- macro flagged(reasons) %}
    {%- if reasons %}<p class="flags"><span class="flag-count">{{ reasons|length }} flag{{ '' if reasons|length == 1 else 's' }}:</span> {{ reasons|join(' · ') }}</p>{% endif %}
  {%- endmacro %}
  {%- macro waiting_row(who) %}
      <tr>
        <td>{{ who.email }}{{ flagged(who.flags) }}</td>
        <td class="quiet">{{ who.asked }}</td>
        <td class="quiet">{{ who.joined or '—' }}</td>
        {#- What the state means, not what the column stores: `on` read as "let in" and it
            only ever meant the address answered its confirmation mail (2026-09-28). -#}
        <td class="quiet">{% if who.turned_off and who.state == 'off' %}Turned off{% else %}{{ {'on': 'Confirmed their email', 'pending': 'Not confirmed yet', 'off': 'Left the list'}.get(who.state, who.state) }}{% endif %}</td>
        <td>
          {%- if who.invited %}<span class="quiet">{{ who.invited }}</span>
          {%- elif who.state == 'on' %}
          {#- One person at a time, the operator's choice (David, 2026-09-28): the same door
              as the batch below, for this address only (`doorway.let_in`). -#}
          <form method="post" action="/back-office/let-in" class="decide">
            <input type="hidden" name="email" value="{{ who.email }}">
            <button type="submit" value="accept" aria-label="Let {{ who.email }} in">Let in</button>
          </form>
          {%- elif not (who.flags and who.state != 'off') and not who.turned_off %}<span class="quiet">—</span>{% endif %}
          {#- Turn off (David, 2026-10-27): a flagged address still waiting is set off, never
              deleted, and nobody is written to; Undo puts back the state it was in. -#}
          {%- if who.turned_off and who.state == 'off' %}
          <form method="post" action="/back-office/turn-on" class="decide">
            <input type="hidden" name="email" value="{{ who.email }}">
            <button type="submit" aria-label="Undo turning {{ who.email }} off">Undo</button>
          </form>
          {%- elif who.flags and not who.invited and who.state != 'off' %}
          <form method="post" action="/back-office/turn-off" class="decide">
            <input type="hidden" name="email" value="{{ who.email }}">
            <button type="submit" aria-label="Turn {{ who.email }} off">Turn off</button>
          </form>
          {%- endif %}
        </td>
        <td class="quiet">{{ who.language or 'en' }}</td>
        <td class="quiet">{{ who.page or '—' }}{% if who.link %}<br><a href="{{ who.link }}" rel="noopener noreferrer" target="_blank">{{ who.link|truncate(48, true, '…') }}</a>{% endif %}</td>
      </tr>
  {%- endmacro %}
  {%- macro waiting_head() %}
    <thead>
      <tr><th>Address</th><th>Asked</th><th>Confirmed</th><th>State</th><th>Let in</th><th>Reads</th><th>From</th></tr>
    </thead>
  {%- endmacro %}
  {%- if survey.waiting_list or waiting_listing.q or survey.waiting_let_in %}
  {%- set still = survey.waiting_list|rejectattr('invited')|list %}
  {%- set done = survey.waiting_list|selectattr('invited')|list %}
  <h2>The waitlist</h2>
  <form method="get" action="/back-office#people" class="decide find" role="search">
    <input type="search" name="wq" value="{{ waiting_listing.q }}" maxlength="100"
           placeholder="Address" aria-label="Search the waitlist by address">
    <select name="wsort" aria-label="Order of the waitlist">
      {% for key, name in waiting_sorts.items() %}<option value="{{ key }}"{% if key == waiting_listing.sort %} selected{% endif %}>{{ name }}</option>{% endfor %}
    </select>
    <label class="fake"><input type="checkbox" name="wfake" value="1"{% if waiting_listing.fake %} checked{% endif %}> Possibly fake (2+)</label>
    {{- carry(('q', 'sort', 'fake', 'page')) }}
    <button type="submit">Search</button>
  </form>
  {%- if still %}
  <table>
    {{ waiting_head() }}
    <tbody>
      {% for who in still %}{{ waiting_row(who) }}{% endfor %}
    </tbody>
  </table>
  {{ pager(waiting_listing, 'wpage', 'Waitlist pages') }}
  {%- elif waiting_listing.q %}
  <p class="quiet">Nobody still waiting matches “{{ waiting_listing.q }}”.</p>
  {%- else %}
  <p class="quiet">Everybody who joined has been let in.</p>
  {%- endif %}
  {%- if done %}
  {#- Open when it is being paged through, or holds the only rows a search found. -#}
  <details class="let-in"{% if let_in_listing.page > 1 or (waiting_listing.q and not still) %} open{% endif %}>
    <summary>Let in ({{ let_in_listing.matches if waiting_listing.q else (survey.waiting_let_in or done|length) }})</summary>
    <table>
      {{ waiting_head() }}
      <tbody>
        {% for who in done %}{{ waiting_row(who) }}{% endfor %}
      </tbody>
    </table>
    {{ pager(let_in_listing, 'ipage', 'Let in pages') }}
  </details>
  {%- endif %}
  {#- The press that keeps the front door's promise (targum-internal#292): the oldest
      confirmed addresses that have not been let in yet, each put on the guest list and
      each written to in the language they joined in. Safe to press again — an address
      already stamped is never picked twice. -#}
  {%- if survey.waiting_for_a_way_in %}
  <form method="post" action="/back-office/open-the-door" class="door">
    <label for="count">Let in, oldest first</label>
    <input type="number" id="count" name="count" value="5" min="1" max="25" step="1">
    <button type="submit">Open the door</button>
    <span class="quiet">{{ survey.waiting_for_a_way_in }} waiting who have not been let in</span>
  </form>
  {%- endif %}
  {%- endif %}

  <h2>Accounts</h2>
  {#- Fifty at a time, newest first unless asked otherwise (targum-internal#542). -#}
  <form method="get" action="/back-office#people" class="decide find" role="search">
    <input type="search" name="q" value="{{ accounts_listing.q }}" maxlength="100"
           placeholder="Address or name" aria-label="Search accounts by address or name">
    <select name="sort" aria-label="Order of the accounts">
      {% for key, name in account_sorts.items() %}<option value="{{ key }}"{% if key == accounts_listing.sort %} selected{% endif %}>{{ name }}</option>{% endfor %}
    </select>
    <label class="fake"><input type="checkbox" name="fake" value="1"{% if accounts_listing.fake %} checked{% endif %}> Possibly fake (2+)</label>
    {{- carry(('wq', 'wsort', 'wfake', 'wpage', 'ipage')) }}
    <button type="submit">Search</button>
  </form>
  {%- if accounts_listing.q and not survey.accounts %}
  <p class="quiet">No account matches “{{ accounts_listing.q }}”.</p>
  {%- else %}
  <table>
    <thead>
      <tr>
        <th>Account</th><th>Joined</th><th>Last active</th>
        <th class="n">Words</th><th class="n">Learned</th><th class="n">Phrases</th>
        <th class="n">Texts</th><th class="n">Finished</th><th class="n">Days</th>
        <th class="n">Credits this month</th>
      </tr>
    </thead>
    <tbody>
      {% for who in survey.accounts %}
      <tr>
        <td><a href="{{ bo_url(who=who.id) }}">{{ who.email }}</a>{% if who.name %} <span class="quiet">{{ who.name }}</span>{% endif %}{{ flagged(who.flags) }}
          {%- if who.leaving %} <span class="quiet">leaving {{ who.leaving }}</span>{% endif %}</td>
        <td class="quiet">{{ who.joined }}</td>
        <td class="quiet">{{ who.last_active or '—' }}</td>
        <td class="n">{{ who.words }}</td>
        <td class="n">{{ who.learned }}</td>
        <td class="n">{{ who.phrases }}</td>
        <td class="n">{{ who.texts_opened }}</td>
        <td class="n">{{ who.targums_finished }}</td>
        <td class="n">{{ who.days_read }}</td>
        {#- Of their month, and what it cost in model spend (targum-internal#543). -#}
        <td class="n">{{ credits(who.used) }}{% if who.allowance is not none %} of {{ credits(who.allowance) }}{% endif %}
          <br><span class="quiet">${{ '%.2f'|format(who.spent) }}</span></td>
      </tr>
      {% endfor %}
    </tbody>
  </table>
  {{ pager(accounts_listing, 'page', 'Account pages') }}
  {%- endif %}

  <h2>The last {{ days }} days</h2>
  {%- if accounts_listing.pages() > 1 or accounts_listing.q %}
  <p class="quiet count">The accounts on this page of Accounts.</p>
  {%- endif %}
  {#- One row a reader and one cell a day, oldest on the left (2026-10-15). It was a
      column a reader, which stopped fitting at ten. A filled cell is a day they kept a
      word, opened a text or read; its title says which. Most recently active first. -#}
  {%- set columns = survey.days|reverse|list %}
  <div class="strip-wrap">
  <table class="strip">
    <thead>
      <tr>
        <th>Reader</th>
        {% for day in columns %}<th class="d" title="{{ day.day }}">{{ day.day[8:]|int }}</th>{% endfor %}
      </tr>
    </thead>
    <tbody>
      {% for who in survey.accounts|sort(attribute='last_active', reverse=True) %}
      <tr>
        <td>{{ who.email.split('@')[0] }}</td>
        {% for day in columns -%}
          {%- set words = day.words.get(who.id, 0) -%}
          {%- set opened = day.opened.get(who.id, 0) -%}
          {%- if words or opened or who.id in day.read -%}
          <td class="d"><span class="on" title="{{ day.day }}: {% if words %}{{ words }} word{{ '' if words == 1 else 's' }}{% endif %}{% if words and opened %} · {% endif %}{% if opened %}{{ opened }} text{{ '' if opened == 1 else 's' }}{% endif %}{% if not words and not opened %}read{% endif %}"></span></td>
          {%- else -%}
          <td class="d"><span class="off"></span></td>
          {%- endif -%}
        {%- endfor %}
      </tr>
      {% endfor %}
    </tbody>
  </table>
  </div>

  </section>

  <section class="tab-panel" id="tab-traffic" role="tabpanel" aria-label="Traffic">
  {#- Who came to the front door (`visits.py`): counted each hour off the proxy's
      access log by `targum roll-visits`. No script, no cookie, nothing sent anywhere.
      A visitor is an address and browser within one day, so the window's figure is a
      sum of days, not a count of people. -#}
  <h2 id="visitors">Visitors</h2>
  {#- What came in through the chat connector (targum-internal#408), off the job and
      playlist rows. Readers who use it are signed in, so the visitor count below never
      sees them. -#}
  {%- if survey.connector and (survey.connector.quoted or survey.connector.sets) %}
  <p class="taken">Through the connector, last {{ days }} days: {{ survey.connector.quoted }} texts offered &middot;
    {{ survey.connector.pressed }} confirmed &middot; {{ survey.connector.finished }} ready &middot;
    {{ survey.connector.sets }} playlists</p>
  {%- endif %}
  {%- if not visits or not visits.any() %}
  <p class="nothing">Nothing counted yet. The roll-up runs hourly on the box.</p>
  {%- else %}
  {%- set tallest = visits.days|map(attribute='visitors')|max or 1 %}
  <p class="taken">About {{ '%.1f'|format(visits.a_day()) }} visitors a day this week &middot;
    {{ visits.views }} pages in the last {{ days }} days</p>
  <svg class="days" viewBox="0 0 {{ days * 10 }} 40" preserveAspectRatio="none" role="img"
       aria-label="Visitors a day, oldest on the left">
    {%- for day in visits.days|reverse %}
    {%- set high = (day.visitors / tallest * 38)|round(1) %}
    <rect x="{{ loop.index0 * 10 + 1 }}" y="{{ 40 - high }}" width="8" height="{{ high }}"
          {%- if day.views and not day.whole %} class="part"{% endif %}><title>{{ day.day }}: {{ day.visitors }}</title></rect>
    {%- endfor %}
  </svg>
  <div class="tallies">
    {%- for kind, heading in (('page', 'Pages'), ('referrer', 'Came from'), ('campaign', 'Campaigns'), ('country', 'Countries')) %}
    <div>
      <h3>{{ heading }}</h3>
      {%- if visits.top.get(kind) %}
      <table>
        <tbody>
          {%- for key, n in visits.top[kind] %}
          <tr><td>{{ key }}</td><td class="n">{{ n }}</td></tr>
          {%- endfor %}
        </tbody>
      </table>
      {%- elif kind == 'country' and not visits.has_countries %}
      <p class="nothing">No country file yet.</p>
      {%- else %}
      <p class="nothing">None.</p>
      {%- endif %}
    </div>
    {%- endfor %}
  </div>
  <table>
    <thead><tr><th>Day</th><th class="n">Visitors</th><th class="n">Pages</th><th class="n">Waitlist</th></tr></thead>
    <tbody>
      {%- for day in visits.days if day.views or asked.get(day.day) %}
      <tr>
        <td>{{ day.day }}{% if not day.whole %} <span class="quiet">partial</span>{% endif %}</td>
        <td class="n">{{ day.visitors }}</td>
        <td class="n">{{ day.views }}</td>
        <td class="n">{{ asked.get(day.day, 0) or '·' }}</td>
      </tr>
      {%- endfor %}
    </tbody>
  </table>
  <p class="note">A visitor is a browser opening a public page while signed out: no
    scripts, no framed readers, no accounts. Pages and referring sites are counted in pages;
    campaigns and countries in visitors. Campaigns are <code>?utm_source=</code> on the link. Countries:
    <a href="https://db-ip.com">IP Geolocation by DB-IP</a>, CC BY 4.0.</p>
  {%- endif %}

  </section>

  <section class="tab-panel" id="tab-shelf" role="tabpanel" aria-label="Shelf">
  {#- A reader's build offered to the shelf. The licence has already been read by
      `promote.py` — nothing here may enter the catalogue unless its standing allows a
      public copy — so what is left for a person is the record: is this a text, is the
      register right, who is it by. Accept is a form post to the same origin; the page
      carries no script. -#}
  <h2>Proposed for the shelf</h2>
  {% if not proposed %}
  <p class="nothing">Nothing waiting.</p>
  {% else %}
  <table>
    <thead>
      <tr><th>Text</th><th>Source</th><th>Licence</th><th class="n">Words</th><th class="n">Looked up</th><th>Decide</th></tr>
    </thead>
    <tbody>
      {% for one in proposed %}
      <tr>
        <td><bdi lang="{{ one.language }}">{{ one.title }}</bdi>{% if one.author %} <span class="quiet">{{ one.author }}</span>{% endif %}</td>
        <td class="quiet"><code>{{ one.source[:60] }}</code></td>
        <td class="quiet">{{ one.licence or 'unknown' }} <span class="quiet">({{ one.standing }}{% if one.corpus_ok %}, exportable{% endif %})</span></td>
        <td class="n">{{ one.words }}</td>
        <td class="n">{{ one.difficulty or '—' }}</td>
        <td>
          <form method="post" action="/back-office/promote" class="decide">
            <input type="hidden" name="id" value="{{ one.id }}">
            <select name="register" aria-label="Register">
              {% for r in registers %}<option value="{{ r }}"{% if r == one.register %} selected{% endif %}>{{ r }}</option>{% endfor %}
            </select>
            <select name="kind" aria-label="Kind">
              {% for k in kinds %}<option value="{{ k }}"{% if k == one.kind %} selected{% endif %}>{{ k }}</option>{% endfor %}
            </select>
            {% if one.standing == 'owed' %}<input type="text" name="credit" placeholder="Credit" aria-label="Credit" required>{% endif %}
            <button type="submit" name="action" value="accept">Accept</button>
            <button type="submit" name="action" value="decline" formnovalidate>Decline</button>
          </form>
        </td>
      </tr>
      {% endfor %}
    </tbody>
  </table>
  {% endif %}

  {#- What readers asked for and the shelf could not give. Counts, never who. -#}
  <h2>Wanted</h2>
  {% if not wanted %}
  <p class="nothing">Nothing asked for that the shelf lacks.</p>
  {% else %}
  <table>
    <thead><tr><th>Asked</th><th>Link</th><th>Licence</th><th class="n">Times</th></tr></thead>
    <tbody>
      {% for one in wanted %}
      <tr>
        <td>{{ one.query or '—' }}</td>
        <td class="quiet"><code>{{ one.source[:70] }}</code></td>
        <td class="quiet">{{ one.standing or '—' }}</td>
        <td class="n">{{ one.count }}</td>
      </tr>
      {% endfor %}
    </tbody>
  </table>
  {% endif %}

  </section>

  <section class="tab-panel" id="tab-operations" role="tabpanel" aria-label="Operations">
  {#- The paid APIs, what each console last said was left, and the way to its billing
      page (`services.py`). The balance is typed in below, because most of these say it
      only to an admin key; the date beside it is how old the figure is, so it is never
      shown without one. -#}
  <h2 id="services">Services</h2>
  <table class="services">
    <thead>
      <tr><th>Service</th><th>Used for</th><th>Key</th><th>Balance</th><th>Read</th><th></th></tr>
    </thead>
    <tbody>
      {% for one in services %}
      <tr>
        <td>{{ one.name }}</td>
        <td class="quiet">{{ one.used_for }}</td>
        <td class="quiet">{{ 'set' if one.configured else 'not set' }}</td>
        <td>
          <form method="post" action="/back-office/balance" class="decide">
            <input type="hidden" name="service" value="{{ one.id }}">
            <input type="text" name="said" value="{{ one.said }}" maxlength="{{ said_max }}"
                   size="12" aria-label="{{ one.name }} balance" placeholder="not read yet">
            <button type="submit">Save</button>
          </form>
        </td>
        <td class="quiet">{{ one.as_of or '—' }}</td>
        <td><a class="topup" href="{{ one.console }}" target="_blank" rel="noopener noreferrer">Top up</a></td>
      </tr>
      {% endfor %}
    </tbody>
  </table>

  {#- What broke in readers' browsers (targum-internal#457, clause 3.14), counted by
      message and page over thirty days: how often, for how many accounts, and where in
      the script. A message reported five times in an hour has mailed the operator. Fixed
      marks a message settled on every page and folds it away; a report after the fix
      brings it back. -#}
  <h2 id="faults">Broken in browsers</h2>
  {%- set broken = faults|rejectattr('since', 'equalto', 0)|list %}
  {%- set mended = faults|selectattr('since', 'equalto', 0)|list %}
  {%- macro fault_rows(rows) %}
  <table>
    <thead><tr><th>Last</th><th>Page</th><th>What</th><th class="n">Times</th><th class="n">Accounts</th><th></th></tr></thead>
    <tbody>
      {% for one in rows %}
      <tr>
        <td class="quiet">{{ one.when }}</td>
        <td>{{ one.page or 'not said' }}</td>
        <td>{{ one.message }}
          {%- if one.fixed_on and one.since %}<p class="quiet">Back after the fix on {{ one.fixed_on }}: {{ one.since }} since.</p>{% endif %}
          {%- if one.place or one.build %}<details class="trace"><summary class="quiet">Where</summary><pre>{{ one.place or 'not said' }}{% if one.build %} &middot; {{ one.build }}{% endif %}</pre></details>{% endif %}</td>
        <td class="n">{{ one.count }}</td>
        <td class="n">{{ one.people }}</td>
        <td>
          {%- if one.since %}
          <form method="post" action="/back-office/fault" class="decide">
            <input type="hidden" name="message" value="{{ one.message }}">
            <button type="submit" aria-label="Mark {{ one.message|truncate(60) }} fixed on every page">Fixed</button>
          </form>
          {%- else %}<span class="quiet">Fixed {{ one.fixed_on }}</span>{% endif %}
        </td>
      </tr>
      {% endfor %}
    </tbody>
  </table>
  {%- endmacro %}
  {%- if broken %}
  {{ fault_rows(broken) }}
  {%- elif mended %}
  <p class="nothing">Nothing has broken since the last fix.</p>
  {%- else %}
  <p class="nothing">No page has broken in a browser lately.</p>
  {%- endif %}
  {%- if mended %}
  <details class="let-in">
    <summary>Fixed ({{ mended|length }})</summary>
    {{ fault_rows(mended) }}
  </details>
  {%- endif %}

  <h2>Incidents</h2>
  {#- What went wrong, other than in the journal (targum-internal#24): a request that
      raised, a build that died, a look-up that failed. The type and the message, the
      route or the stage, and the traceback's tail behind a disclosure — no script on
      this page, so `details` is the toggle. Never a reader's text or an address: the
      recorder cuts those out before writing. -#}
  {% if not incidents %}
  <p class="nothing">Nothing has gone wrong lately.</p>
  {% else %}
  <table>
    <thead><tr><th>When</th><th>Where</th><th>What</th></tr></thead>
    <tbody>
      {% for one in incidents %}
      <tr>
        <td class="quiet">{{ one.at }}</td>
        <td>{{ one.where }}{% if one.job %} <span class="quiet">{{ one.job }}</span>{% endif %}</td>
        <td>{% if one.kind %}<b>{{ one.kind }}</b> {% endif %}{{ one.message }}
          {%- if one.trace %}<details class="trace"><summary class="quiet">Traceback</summary><pre>{{ one.trace }}</pre></details>{% endif %}</td>
      </tr>
      {% endfor %}
    </tbody>
  </table>
  {% endif %}

  </section>

  <p class="note">Counts only. This page holds no words, no texts and no notes, save the
    messages readers write to us through Tell us. See <code>backoffice.py</code> for why
    that is a rule rather than a first version, and why those are the exception.</p>
</main>
{{ script('backoffice.js') }}
</body>
</html>
