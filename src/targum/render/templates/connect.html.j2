{%- macro mark() -%}
<svg class="mark" viewBox="20 12 56 72" aria-hidden="true" focusable="false"><rect x="20" y="12" width="22" height="62" rx="5" fill="currentColor"></rect><rect x="54" y="22" width="22" height="62" rx="5" fill="var(--mark-accent)"></rect></svg>
{%- endmacro -%}
{%- macro copyable(text, label) -%}
<span class="copyable">
  <code>{{ text }}</code>
  <button class="copy" type="button" data-copy="{{ text }}" hidden>
    <svg viewBox="0 0 16 16" aria-hidden="true"><rect x="5.5" y="5.5" width="8" height="8" rx="1.5" fill="none" stroke="currentColor" stroke-width="1.4"/><path d="M10.5 5.5v-2a1 1 0 0 0-1-1h-6a1 1 0 0 0-1 1v6a1 1 0 0 0 1 1h2" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/></svg>
    <span>{{ label }}</span>
  </button>
</span>
{%- endmacro -%}
<!doctype html>
<html lang="{{ page_language|default('en') }}">
<head>
{% include '_public_head.html.j2' %}
<style>{{ asset('landing.css') }}{{ asset('connect.css') }}</style>
{{ hebrew_face() }}
{{ chrome_face() }}
</head>
<body class="landing connect">
<header class="bar">
  <div class="col">
    <a class="brand" href="/" aria-label="targum">
      <svg class="brand-mark" viewBox="20 12 56 72" aria-hidden="true" focusable="false">
        <rect x="20" y="12" width="22" height="62" rx="5" fill="currentColor"></rect>
        <rect x="54" y="22" width="22" height="62" rx="5" fill="var(--mark-accent)"></rect>
      </svg>
      targum
    </a>
    <nav class="places" aria-label="{{ t("connect.page.on-this-page", "On this page") }}">
      <a href="#how">{{ t("connect.page.how-it-works", "How it works") }}</a>
      <a href="#why">{{ t("connect.page.what-you-get", "What you get") }}</a>
      <a href="#install">{{ t("connect.page.set-it-up", "Set it up") }}</a>
      <a href="#questions">{{ t("connect.page.faq", "FAQ") }}</a>
    </nav>
    <div class="end">
      <p class="tongue">
        {%- if page_language == 'ru' %}<a href="/connect?lang=en" hreflang="en">EN</a><span>/</span><b>RU</b>
        {%- else %}<b>EN</b><span>/</span><a href="/connect?lang=ru" hreflang="ru">RU</a>{% endif %}
      </p>
      <a class="signin" href="/account/signin">{{ t("connect.page.sign-in", "Sign in") }}</a>
      <a class="btn cta small" href="#install">{{ t("connect.page.connect-targum", "Connect targum") }}</a>
    </div>
  </div>
</header>

<main id="top">
  {#- The hero: what it is in one line, and the conversation it makes, playing. -#}
  <div class="col">
    <div class="hero c-hero">
      <div class="headline">
        <p class="kicker">{{ mark() }}<span>targum Connect</span></p>
        {#- The app's name turns over, one each couple of seconds, because the whole
            claim is "the one you already use", and each reader uses a different one.
            Without JavaScript it stands still on the first. Only apps the steps below
            cover are named: a name here is a promise that there is a tab for it. -#}
        <h1><span class="first">{{ t("connect.page.learn-hebrew", "Learn Hebrew") }}</span>
          <span class="inside">{{ t("connect.page.in-your-app", "in") }}
            <span class="rotor" id="rotor"><span class="rotor-name">{{ logo('claude') }}<span>Claude</span></span></span></span></h1>
        <p class="lede">{{ t("connect.page.connect-targum-to-the-ai-you-already-use", "Connect targum to the AI you already use, and it talks to you in Hebrew built from the words you know. When you slip, it shows you the fix and why. Every new word goes on your list.") }}</p>
        <div class="actions">
          <a class="btn cta" href="#install">{{ t("connect.page.connect-targum", "Connect targum") }}</a>
          <button class="btn tonal" type="button" id="replay" hidden>
            <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M5 3.5v9l7-4.5z" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round"/></svg>
            {{ t("connect.page.watch-it-work", "Watch it work") }}
          </button>
        </div>
        <ul class="facts">
          <li>{{ t("connect.page.free-to-connect", "Free to connect") }}</li>
          <li>{{ t("connect.page.set-up-in-two-minutes", "Set up in two minutes") }}</li>
          <li>{{ t("connect.page.you-choose-what-it-sees", "You choose what it sees") }}</li>
        </ul>
      </div>

      <figure class="demo" id="demo" aria-label="{{ t("connect.page.example-a-conversation-with-targum-connected", "Example: a conversation with targum connected") }}">
        <div class="demo-top">
          <span class="demo-host" id="demoHost">{{ logo('claude') }}<span>Claude</span></span>
          <span class="demo-linked"><i></i>{{ t("connect.page.targum-connected", "targum connected") }}</span>
        </div>
        {#- With JavaScript off this is the first example, drawn still. `connect.js`
            replaces it and plays all three. -#}
        <div class="demo-thread" id="demoThread">
          <div class="msg you"><p>{{ t("connect.demo.find-me-something-short-to-read-about-food", "Find me something short to read about food. Nothing too hard.") }}</p></div>
          <div class="tool done"><span class="tool-glyph">{{ mark() }}</span><span>{{ t("connect.demo.found-three-at-your-level", "Found three at your level") }}</span></div>
          <div class="msg them">
            <p>{{ t("connect.demo.here-are-three-you-ll-mostly-understand", "Here are three you’ll mostly understand:") }}</p>
            <div class="finds">
              <div class="find"><span class="t">{{ t("connect.demo.shakshuka-in-ten-minutes", "Shakshuka in ten minutes") }}</span><span class="k">{{ t("connect.demo.video-you-know-80", "Video · you know 80%") }}</span><span class="meter"><i class="p80"></i></span></div>
              <div class="find"><span class="t">{{ t("connect.demo.this-week-s-news-easy", "This week’s news · easy") }}</span><span class="k">{{ t("connect.demo.article-you-know-90", "Article · you know 90%") }}</span><span class="meter"><i class="p90"></i></span></div>
            </div>
          </div>
        </div>
        <div class="demo-compose" id="demoCompose" aria-hidden="true" hidden>
          <span class="demo-field" id="demoField" data-empty="{{ t("connect.demo.write-in-hebrew-or-english", "Write in Hebrew or English") }}"></span>
          <span class="demo-send"><svg viewBox="0 0 16 16"><path d="M8 13V3.5M3.8 7.5 8 3.3l4.2 4.2" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg></span>
        </div>
        <div class="scenes" role="group" aria-label="{{ t("connect.page.examples", "Examples") }}" id="scenes" hidden>
          <button class="scene" type="button" data-scene="0" aria-pressed="true"><span>{{ t("connect.page.find-something-to-read", "Find something to read") }}</span><i></i></button>
          <button class="scene" type="button" data-scene="1" aria-pressed="false"><span>{{ t("connect.page.get-corrected", "Get corrected") }}</span><i></i></button>
          <button class="scene" type="button" data-scene="2" aria-pressed="false"><span>{{ t("connect.page.pick-up-where-you-left-off", "Pick up where you left off") }}</span><i></i></button>
        </div>
      </figure>
    </div>

    <div class="works">
      <p class="label">{{ t("connect.page.works-with", "Works with") }}</p>
      <ul class="logos">
        <li>{{ logo('claude') }}<span>Claude</span></li>
        <li>{{ logo('openai') }}<span>ChatGPT</span></li>
        <li>{{ logo('claude') }}<span>Claude Code</span></li>
        <li>{{ logo('vscode') }}<span>VS Code</span></li>
        <li>{{ logo('gemini') }}<span>Gemini CLI</span></li>
        <li>{{ logo('openai') }}<span>Codex</span></li>
      </ul>
    </div>
  </div>

  {#- The page's one inverted block (§9): what passes between the three of them. -#}
  <section class="part" id="how">
    <div class="col">
      <div class="media flow-band">
        <div class="part-head">
          <p class="label">{{ t("connect.page.how-it-works", "How it works") }}</p>
          <h2>{{ t("connect.page.ask-your-usual-ai-it-checks-your-targum-list-first", "Ask your usual AI. It checks your targum list first.") }}</h2>
          <p>{{ t("connect.page.when-you-ask-about-hebrew", "When you ask about Hebrew, your AI looks up the words you know and what you’re working on, then answers at your level.") }}</p>
        </div>
        <div class="flow" aria-hidden="true">
          <div class="node">
            <span class="node-glyph"><svg viewBox="0 0 16 16"><circle cx="8" cy="5.2" r="2.6" fill="none" stroke="currentColor" stroke-width="1.4"/><path d="M2.8 14c.6-2.9 2.7-4.4 5.2-4.4s4.6 1.5 5.2 4.4" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/></svg></span>
            <span class="node-name">{{ t("connect.page.you", "You") }}</span>
            <span class="node-note">{{ t("connect.page.ask-in-english-or-hebrew", "Ask in English or Hebrew") }}</span>
          </div>
          <div class="wire"><i class="go"></i><i class="back"></i></div>
          <div class="node">
            <span class="node-glyph stack">{{ logo('claude') }}{{ logo('openai') }}{{ logo('gemini') }}</span>
            <span class="node-name">{{ t("connect.page.your-assistant", "Your assistant") }}</span>
            <span class="node-note">{{ t("connect.page.claude-chatgpt-and-others", "Claude, ChatGPT and others") }}</span>
          </div>
          <div class="wire"><i class="go"></i><i class="back"></i></div>
          <div class="node home">
            <span class="node-glyph">{{ mark() }}</span>
            <span class="node-name">targum</span>
            <span class="node-note">{{ t("connect.page.your-word-list-and-the-library", "Your word list and the library") }}</span>
          </div>
        </div>
        <ol class="flow-steps">
          <li><span class="how-n">1</span><p>{{ t("connect.page.write-in-hebrew-or-english-or-ask-for-something-to-read", "Write in Hebrew or English, or ask for something to read.") }}</p></li>
          <li><span class="how-n">2</span><p>{{ t("connect.page.your-ai-checks-your-word-list-and-the-library", "Your AI checks your word list and the library.") }}</p></li>
          <li><span class="how-n">3</span><p>{{ t("connect.page.it-answers-at-your-level-and-new-words-go-on-your-list", "It answers at your level, and new words go on your list.") }}</p></li>
        </ol>
      </div>
    </div>
  </section>

  {#- For somebody who has never heard of targum: what it is, then what connecting it
      adds. The six tiles are the tools, said as what they do for a person. -#}
  <section class="part" id="why">
    <div class="col">
      <div class="part-head">
        <p class="label">{{ t("connect.page.what-you-get", "What you get") }}</p>
        <h2>{{ t("connect.page.every-chat-starts-from-what-you-know", "Every chat starts from what you know.") }}</h2>
        <p>{{ t("connect.page.without-targum-your-ai-forgets-you", "Without targum, your AI forgets you between chats. With it, your AI knows your words and the mistakes you keep making.") }}</p>
      </div>

      <aside class="new-here">
        <span class="new-mark">{{ mark() }}</span>
        <div>
          <h3>{{ t("connect.page.new-to-targum", "New to targum?") }}</h3>
          <p>{{ t("connect.page.targum-is-where-you-learn-hebrew", "targum is where you learn Hebrew from videos, podcasts and books, with vowels on every word and English beside every line. Tap a word you don’t know and it goes onto your list.") }} <a href="/">{{ t("connect.page.see-targum", "See targum") }}</a></p>
        </div>
      </aside>

      <div class="usps">
        <div class="tile">
          <h3>{{ t("connect.page.hebrew-at-your-level", "Hebrew at your level") }}</h3>
          <p>{{ t("connect.page.short-replies-in-simple-hebrew", "Short replies in simple Hebrew, built from words you know. The English is there when you want it.") }}</p>
          <div class="spec">
            <span class="he">מָה בִּשַּׁלְתָּ הַיּוֹם?</span>
            <span class="gl">{{ t("connect.page.what-did-you-cook-today", "What did you cook today?") }}</span>
          </div>
        </div>
        <div class="tile">
          <h3>{{ t("connect.page.the-fix-and-why", "The fix, and why") }}</h3>
          <p>{{ t("connect.page.write-in-hebrew-and-see-the-fix", "Write in Hebrew and see what to change and why. The mistake goes on your list to practise.") }}</p>
          <div class="spec">
            <span class="he"><s>הָיָה</s> <b class="fix">הָיְתָה</b> טְעִימָה</span>
            <span class="gl">{{ t("connect.page.shakshuka-is-feminine", "shakshuka is feminine, so the verb is too") }}</span>
          </div>
        </div>
        <div class="tile">
          <h3>{{ t("connect.page.picks-up-where-you-left-off", "Picks up where you left off") }}</h3>
          <p>{{ t("connect.page.your-list-lives-in-targum", "Your list lives in targum, so ChatGPT knows what you learned in Claude.") }}</p>
          <div class="spec row">
            <span><b class="tnum">2,140</b> {{ t("connect.page.words-known", "words known") }}</span>
            <span><b class="tnum">18</b> {{ t("connect.page.mistakes-to-practise", "mistakes to practise") }}</span>
          </div>
        </div>
        <div class="tile">
          <h3>{{ t("connect.page.something-to-read-next", "Something to read next") }}</h3>
          <p>{{ t("connect.page.nearly-500-free-texts-and-videos-sorted-by-the-words-you-know", "Nearly 500 free texts and videos, sorted by the words you know. Or paste a link to your own.") }}</p>
          <div class="spec">
            <span class="t">{{ t("connect.demo.shakshuka-in-ten-minutes", "Shakshuka in ten minutes") }}</span>
            <span class="meter"><i class="p80"></i></span>
          </div>
        </div>
        <div class="tile">
          <h3>{{ t("connect.page.words-where-you-met-them", "Words where you met them") }}</h3>
          <p>{{ t("connect.page.ask-about-a-word-and-see-it-in-the-sentence-you-read-it-in", "Ask about a word and see it in the sentence you read it in.") }}</p>
          <div class="spec">
            <span class="he">שָׂמִים שֶׁמֶן <b class="fix">בַּמַּחֲבַת</b></span>
            <span class="gl">{{ t("connect.page.shakshuka-in-ten-minutes-at-2-10", "Shakshuka in ten minutes, at 2:10") }}</span>
          </div>
        </div>
        <div class="tile">
          <h3>{{ t("connect.page.you-decide-what-it-sees", "You decide what it sees") }}</h3>
          <p>{{ t("connect.page.pick-what-your-ai-can-read", "Pick what your AI can read when you connect. It can’t start a text for you: it sends a link, and you open it.") }}</p>
          <div class="spec row">
            <span class="tick">{{ t("connect.page.the-library", "The library") }}</span>
            <span class="tick">{{ t("connect.page.your-words", "Your words") }}</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  {#- The steps. One tab an app, with its own steps and its own moving picture; with
      JavaScript off, every app's block stands in order and the tabs are not drawn. -#}
  <section class="part" id="install">
    <div class="col">
      <div class="part-head">
        <p class="label">{{ t("connect.page.set-it-up", "Set it up") }}</p>
        <h2>{{ t("connect.page.connect-in-two-minutes", "Connect in two minutes.") }}</h2>
        <p>{{ t("connect.page.pick-your-app-they-all-use-this-address", "Pick your app. They all use this address:") }}</p>
      </div>
      <div class="address-card">
        {{ copyable(mcp, t("connect.page.copy", "Copy")) }}
      </div>

      <div class="plats" role="tablist" aria-label="{{ t("connect.page.your-app", "Your app") }}" id="plats" hidden>
        <button class="plat" role="tab" type="button" id="tab-claude" aria-controls="p-claude" aria-selected="true">{{ logo('claude') }}<span>Claude</span></button>
        <button class="plat" role="tab" type="button" id="tab-chatgpt" aria-controls="p-chatgpt" aria-selected="false" tabindex="-1">{{ logo('openai') }}<span>ChatGPT</span></button>
        <button class="plat" role="tab" type="button" id="tab-code" aria-controls="p-code" aria-selected="false" tabindex="-1">{{ logo('claude') }}<span>Claude Code</span></button>
        <button class="plat" role="tab" type="button" id="tab-vscode" aria-controls="p-vscode" aria-selected="false" tabindex="-1">{{ logo('vscode') }}<span>VS Code</span></button>
        <button class="plat" role="tab" type="button" id="tab-gemini" aria-controls="p-gemini" aria-selected="false" tabindex="-1">{{ logo('gemini') }}<span>Gemini CLI</span></button>
        <button class="plat" role="tab" type="button" id="tab-codex" aria-controls="p-codex" aria-selected="false" tabindex="-1">{{ logo('openai') }}<span>Codex</span></button>
        <button class="plat" role="tab" type="button" id="tab-other" aria-controls="p-other" aria-selected="false" tabindex="-1">{{ logo('other') }}<span>{{ t("connect.page.another-app", "Another app") }}</span></button>
      </div>

      <div class="panels">
        <div class="panel" id="p-claude" role="tabpanel" aria-labelledby="tab-claude" data-plat="claude">
          <div class="how-to">
            <h3>{{ logo('claude') }}{{ t("connect.page.in-claude", "In Claude") }}</h3>
            <ol class="steps">
              <li>{{ t("connect.page.claude-open-settings-then-connectors", "Open Settings, then Connectors.") }}</li>
              <li>{{ t("connect.page.claude-choose-add-custom-connector", "Choose Add custom connector.") }}</li>
              <li>{{ t("connect.page.claude-name-it-and-paste", "Name it targum, paste the address and choose Add.") }}</li>
              <li>{{ t("connect.page.claude-sign-in-then-choose-what-it-can-see", "Sign in to targum when asked, then choose what it can see.") }}</li>
            </ol>
            <p class="quiet">{{ t("connect.page.claude-once-and-on-your-phone", "Add it once on the web or the desktop app and it’s on your phone too.") }}</p>
          </div>
          <div class="screen" hidden></div>
        </div>

        <div class="panel" id="p-chatgpt" role="tabpanel" aria-labelledby="tab-chatgpt" data-plat="chatgpt">
          <div class="how-to">
            <h3>{{ logo('openai') }}{{ t("connect.page.in-chatgpt", "In ChatGPT") }}</h3>
            <ol class="steps">
              <li>{{ t("connect.page.chatgpt-open-settings-then-apps", "Open Settings, then Apps & Connectors.") }}</li>
              <li>{{ t("connect.page.chatgpt-turn-on-developer-mode", "Under Advanced settings, turn on Developer mode.") }}</li>
              <li>{{ t("connect.page.chatgpt-create-and-paste", "Choose Create, name it targum and paste the address.") }}</li>
              <li>{{ t("connect.page.chatgpt-choose-oauth-then-sign-in", "Choose OAuth, then sign in to targum and choose what it can see.") }}</li>
            </ol>
            <p class="quiet">{{ t("connect.page.chatgpt-menus-move", "Developer mode is on ChatGPT’s paid plans. Its menus move now and then: if yours differ, look for Connectors or Apps.") }}</p>
          </div>
          <div class="screen" hidden></div>
        </div>

        <div class="panel" id="p-code" role="tabpanel" aria-labelledby="tab-code" data-plat="code">
          <div class="how-to">
            <h3>{{ logo('claude') }}{{ t("connect.page.in-claude-code", "In Claude Code") }}</h3>
            <ol class="steps">
              <li>{{ t("connect.page.code-run-this-in-your-terminal", "Run this in your terminal:") }}
                {{ copyable("claude mcp add --transport http targum " ~ mcp, t("connect.page.copy", "Copy")) }}</li>
              <li>{{ t("connect.page.code-start-and-type-mcp", "Start Claude Code and type /mcp.") }}</li>
              <li>{{ t("connect.page.code-choose-targum-and-sign-in", "Choose targum, then Authenticate, and sign in to targum in your browser.") }}</li>
            </ol>
          </div>
          <div class="screen" hidden></div>
        </div>

        <div class="panel" id="p-vscode" role="tabpanel" aria-labelledby="tab-vscode" data-plat="vscode">
          <div class="how-to">
            <h3>{{ logo('vscode') }}{{ t("connect.page.in-vs-code", "In VS Code") }}</h3>
            <ol class="steps">
              <li>{{ t("connect.page.vscode-run-add-server", "Open the Command Palette and run MCP: Add Server.") }}</li>
              <li>{{ t("connect.page.vscode-choose-http-and-paste", "Choose HTTP, paste the address and name it targum.") }}</li>
              <li>{{ t("connect.page.vscode-sign-in", "Sign in to targum when VS Code asks.") }}</li>
              <li>{{ t("connect.page.vscode-agent-mode", "Open Copilot Chat in Agent mode and ask away.") }}</li>
            </ol>
          </div>
          <div class="screen" hidden></div>
        </div>

        <div class="panel" id="p-gemini" role="tabpanel" aria-labelledby="tab-gemini" data-plat="gemini">
          <div class="how-to">
            <h3>{{ logo('gemini') }}{{ t("connect.page.in-gemini-cli", "In Gemini CLI") }}</h3>
            <ol class="steps">
              <li>{{ t("connect.page.code-run-this-in-your-terminal", "Run this in your terminal:") }}
                {{ copyable("gemini mcp add --transport http targum " ~ mcp, t("connect.page.copy", "Copy")) }}</li>
              <li>{{ t("connect.page.gemini-start-and-auth", "Start Gemini CLI and type /mcp auth targum.") }}</li>
              <li>{{ t("connect.page.sign-in-in-your-browser-and-choose", "Sign in to targum in your browser and choose what it can see.") }}</li>
            </ol>
          </div>
          <div class="screen" hidden></div>
        </div>

        <div class="panel" id="p-codex" role="tabpanel" aria-labelledby="tab-codex" data-plat="codex">
          <div class="how-to">
            <h3>{{ logo('openai') }}{{ t("connect.page.in-codex", "In Codex") }}</h3>
            <ol class="steps">
              <li>{{ t("connect.page.code-run-this-in-your-terminal", "Run this in your terminal:") }}
                {{ copyable("codex mcp add targum --url " ~ mcp, t("connect.page.copy", "Copy")) }}</li>
              <li>{{ t("connect.page.codex-then-sign-in", "Then run this, to sign in:") }}
                {{ copyable("codex mcp login targum", t("connect.page.copy", "Copy")) }}</li>
              <li>{{ t("connect.page.sign-in-in-your-browser-and-choose", "Sign in to targum in your browser and choose what it can see.") }}</li>
            </ol>
          </div>
          <div class="screen" hidden></div>
        </div>

        <div class="panel" id="p-other" role="tabpanel" aria-labelledby="tab-other" data-plat="other">
          <div class="how-to">
            <h3>{{ logo('other') }}{{ t("connect.page.in-another-app", "In another app") }}</h3>
            <ol class="steps">
              <li>{{ t("connect.page.other-find-where", "Find where your app adds a remote MCP server. Some call it a connector or an integration.") }}</li>
              <li>{{ t("connect.page.other-paste-the-address", "Paste the address. If it asks how to connect, choose HTTP.") }}</li>
              <li>{{ t("connect.page.other-choose-oauth", "If it asks how to sign in, choose OAuth. It opens targum, and you sign in there.") }}</li>
            </ol>
            <p class="quiet">{{ t("connect.page.other-no-key-to-copy", "There’s no key to copy. The address is all you need.") }}</p>
          </div>
          <div class="screen" hidden></div>
        </div>
      </div>
    </div>
  </section>

  {#- What it may see. The three scopes are the approval page's own words, through the
      same keys, so this page cannot promise something the approval page does not ask. -#}
  <section class="part" id="sees">
    <div class="col split">
      <div class="part-head">
        <p class="label">{{ t("connect.page.what-it-sees", "What it sees") }}</p>
        <h2>{{ t("connect.page.you-decide-what-it-sees-and-can-change-your-mind", "You decide what it sees, and you can change your mind.") }}</h2>
        <p>{{ t("connect.page.when-you-connect-we-ask", "When you connect, we ask what your AI may do. Tick what you want, and change it from your account at any time.") }}</p>
        <ul class="points">
          <li>{{ t("connect.page.it-cant-start-a-text-for-you", "It can’t start a text for you. It sends a link, and you open it on targum.") }}</li>
          <li>{{ t("connect.page.we-only-see-what-your-ai-asks-for", "We only see what your AI asks us for: a search, a word, a line to check.") }}</li>
          <li>{{ t("connect.page.nothing-from-targums-chat-goes-to-your-ai", "Nothing you say in targum’s own chat is sent to your AI.") }}</li>
        </ul>
      </div>
      <figure class="grant" id="grant" aria-label="{{ t("connect.page.example-the-page-you-approve-on", "Example: the page you approve on") }}">
        <p class="grant-brand">{{ mark() }}<span>targum</span></p>
        <p class="grant-title">{{ t("connect.page.connect-to-targum", "Connect {client} to targum", client="Claude") }}</p>
        <ul class="grant-list">
          <li class="on"><span class="box"></span><span>{{ t("connect.scope.library", "Search the library and look up what is at a link") }}</span></li>
          <li class="on"><span class="box"></span><span>{{ t("connect.scope.record", "Read your words, your mistakes and your progress") }}</span></li>
          <li class="on"><span class="box"></span><span>{{ t("connect.scope.chat", "Read what you write in the language you're learning, keep the lines we correct, get texts and playlists ready for you to confirm, and add a language you practise") }}<small>{{ t("connect.page.checking-uses-credits", "Checking what you write uses your credits") }}</small></span></li>
        </ul>
        <p class="grant-press"><span class="btn cta small">{{ t("connect.page.connect", "Connect") }}</span><span class="btn ghost small">{{ t("connect.page.not-now", "Not now") }}</span></p>
      </figure>
    </div>
  </section>

  <section class="part" id="questions">
    <div class="col">
      <div class="part-head">
        <p class="label">{{ t("connect.page.questions", "Questions") }}</p>
        <h2>{{ t("connect.page.before-you-connect", "Before you connect.") }}</h2>
      </div>
      <div class="faq">
        <details><summary>{{ t("connect.page.q-do-i-need-an-account", "Do I need a targum account?") }}</summary><p>{{ t("connect.page.a-do-i-need-an-account", "Yes. Your words and your progress live in it, and that’s what your assistant reads. We’re opening in small groups, so join the waitlist and we’ll email you when it’s your turn.") }}</p></details>
        <details><summary>{{ t("connect.page.q-what-does-it-cost", "What does it cost?") }}</summary><p>{{ t("connect.page.a-what-does-it-cost", "Connecting is free, and so is searching the library and your word list. Checking what you write uses a few seconds of your credits a message, and only if you allow it when you connect.") }}</p></details>
        <details><summary>{{ t("connect.page.q-which-apps", "Which apps does it work with?") }}</summary><p>{{ t("connect.page.a-which-apps", "Claude, ChatGPT, Claude Code, VS Code, Gemini CLI and Codex, and any other app that can add a remote MCP server and sign in with OAuth.") }}</p></details>
        <details><summary>{{ t("connect.page.q-will-it-speak-hebrew", "Will it talk to me in Hebrew?") }}</summary><p>{{ t("connect.page.a-will-it-speak-hebrew", "Yes. We give your AI the rules our own chat follows: short replies in simple Hebrew, built from the words you know, with the English when you ask.") }}</p></details>
        <details><summary>{{ t("connect.page.q-can-it-spend-on-its-own", "Can it start anything on its own?") }}</summary><p>{{ t("connect.page.a-can-it-spend-on-its-own", "No. When you ask for a text, it tells you how long it’ll take and sends you a link. Nothing starts until you press Start on targum.") }}</p></details>
        <details><summary>{{ t("connect.page.q-how-do-i-disconnect", "How do I disconnect?") }}</summary><p>{{ t("connect.page.a-how-do-i-disconnect", "From your targum account, where every connected app is listed, or by removing it in the app.") }}</p></details>
        <details><summary>{{ t("connect.page.q-what-is-mcp", "Why do the steps say MCP?") }}</summary><p>{{ t("connect.page.mcp-is-what-the-menu-is-called", "Some apps call this an MCP server. That is the same thing.") }}</p></details>
      </div>
    </div>
  </section>

  <div class="col close">
    <h2>{{ t("connect.page.learn-hebrew-in-the-chat-you-already-use", "Learn Hebrew in the chat you already use.") }}</h2>
    <form class="join-form" method="post" action="/waitlist">
      <label class="field">
        <input type="email" name="email" required inputmode="email" autocapitalize="off" spellcheck="false" autocomplete="email" placeholder="{{ t("connect.page.you-example-com", "you@example.com") }}" aria-label="{{ t("connect.page.your-email", "Your email") }}">
        <button class="btn cta" type="submit">{{ t("connect.page.join-the-waitlist", "Join the waitlist") }}</button>
      </label>
      <p class="join-note">{{ t("connect.page.we-re-opening-in-small-groups", "You’ll need a targum account. We’re opening in small groups, and we’ll email you when your turn comes.") }}</p>
    </form>
  </div>
</main>

{% with signin = true %}{% include '_public_foot.html.j2' %}{% endwith %}

{% if strings %}<script>window.TARGUM_STRINGS = {{ strings|tojson }};</script>
{% endif %}<script>{{ asset('strings.js') }}</script>
<script>{{ asset('connect.js') }}</script>
</body>
</html>
