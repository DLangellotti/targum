<!doctype html>
<html lang="{{ page_language|default('en') }}">
<head>
{% include '_public_head.html.j2' %}
{{ styles('tokens.css', 'shared.css', 'reader.css', 'public.css') }}
{{ hebrew_face() }}
{{ script('keep.js') }}
</head>
<body class="public">
{#- A page about a text, not a page about targum. Somebody arriving here searched for
    the book, not for a reading tool, and the first thing they should meet is the book. -#}
<main class="sheet">
  {#- One row on the sheet's own grid: the name at one corner, the door and the light
      switch at the other. The corner used to be pinned to the window's edge, which on a
      wide screen is nowhere near the page. -#}
  <div class="masthead">
    <a class="brand" href="/" aria-label="targum">
      <svg class="brand-mark" viewBox="20 12 56 72" aria-hidden="true" focusable="false">
        <rect x="20" y="12" width="22" height="62" rx="5" fill="currentColor"></rect>
        <rect x="54" y="22" width="22" height="62" rx="5" fill="var(--mark-accent)"></rect>
      </svg>
      <span>targum</span>
    </a>
    <div class="corner">
      <a class="enter" href="{{ door }}">{{ t("text.page.sign-in", "Sign in") }}</a>
    </div>
  </div>

  <p class="where"><a href="/library">{{ shelf_name }}</a></p>
  <h1 lang="{{ entry.language }}" dir="{{ direction }}"><bdi>{{ entry.title }}</bdi></h1>
  {#- The name and the blurb in whatever language this page speaks, with `lang` saying so:
      a Russian sentence marked `lang="en"` is read aloud in an English voice and indexed
      as English, which is the opposite of what this page is for (targum-internal#188). -#}
  {% if named %}<p class="english" lang="{{ page_language }}" dir="ltr">{{ named }}</p>{% endif %}
  <p class="byline">{{ entry.author }}</p>
  <p class="lede" lang="{{ page_language }}" dir="ltr">{{ lede }}</p>

  {%- if sample %}
  {#- The reason this page is worth indexing at all: real text, in both languages, laid
      out the way the reader itself lays it out. A page of description would rank for
      nothing and tell a visitor nothing. -#}
  <section class="sample">
    <h2>{{ t("text.page.the-opening", "The opening") }}</h2>
    {%- for line in sample %}
    <div class="pair">
      <p class="source" lang="{{ entry.language }}" dir="{{ direction }}">{{ line.source }}</p>
      <p class="target" lang="{{ sample_language|default('en') }}" dir="ltr">{{ line.target }}</p>
    </div>
    {%- endfor %}
  </section>
  {%- endif %}

  {%- if credit.renderings or credit.ours %}
  {#- Who made the translation, and under what. A reader deciding whether to trust an
      English Tanakh decides on this, so it is body text rather than a footnote.

      Only the translation this page shows (targum-internal#521): a Russian page credited
      Metsudah's English under an English heading, beside Russian lines that were not
      Metsudah's. `translation_credit` makes the pick; this draws it. -#}
  <section class="provenance" lang="{{ page_language }}">
    <h2>{{ t("text.page.translations", "Translations") if credit.renderings | length > 1 else t("text.page.translation", "Translation") }}</h2>
    <ul>
      {%- for rendering in credit.renderings %}
      <li lang="{{ rendering.language }}">
        <b>{{ rendering.name }}</b>
        {%- if rendering.publisher %}<span class="publisher">{{ rendering.publisher }}</span>{% endif %}
        {%- if rendering.note %}<span class="note">{{ rendering.note }}</span>{% endif %}
        {%- if rendering.licence %}<span class="licence">{% if rendering.licence_url %}<a href="{{ rendering.licence_url }}" rel="noopener">{{ rendering.licence }}</a>{% else %}{{ rendering.licence }}{% endif %}</span>{% endif %}
      </li>
      {%- endfor %}
      {%- if credit.ours == "lines" %}
      <li class="ours">{{ t("text.page.we-translated-these-lines-from-the-english", "We translated these lines from the English.") }}</li>
      {%- elif credit.ours == "text" %}
      <li class="ours">{{ t("text.page.we-translated-this-text", "We translated this text.") }}</li>
      {%- endif %}
    </ul>
  </section>
  {%- endif %}

  <p class="facts">{{ t("text.page.facts", "{words} words, about {minutes} minutes of reading.", words=entry.words | int, minutes=minutes) }}</p>

  <p class="door">
    <a class="go" href="{{ door }}">{{ t("text.page.read-it", "Read it") }}</a>
    <span class="free">{{ t("text.page.someone-has-already-translated-this-one", "Someone has already translated this one.") }}</span>
  </p>
</main>

{% set back = shelf_name %}
{% include '_public_foot.html.j2' %}
</body>
</html>
