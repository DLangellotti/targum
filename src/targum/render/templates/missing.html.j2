<!doctype html>
<html lang="{{ page_language|default('en') }}">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>{{ t("holding.page.not-found", "Not found") }} — targum</title>
{% include '_icons.html.j2' %}
<style>{{ asset('tokens.css') }}{{ asset('shared.css') }}{{ asset('chrome.css') }}</style>
{{ hebrew_face() }}
<script>{{ asset('keep.js') }}</script>
<script>window.TARGUM_KEY = "{{ token }}";</script>
</head>
<body class="missing">
{#- A whole page (design.md §12, "A refusal is drawn on one of five surfaces",
    2026-10-09): the top bar stays, so whoever followed an old link is still somewhere,
    and under it a heading, one sentence and one button. It stood in the holding page's
    frame until then, the mark alone on the ground. -#}
{% set here = 'missing' %}
{% include '_nav.html.j2' %}
<script>{{ asset('building.js') }}</script>

<main class="fault-page">
  {#- The board's line icon (NotFound): a page with its corner turned, in the well's
      grey, drawn as §7 draws a glyph. -#}
  <svg class="fault-icon" viewBox="0 0 16 16" aria-hidden="true" focusable="false"><path d="M4 1.75h5.25L12.5 5v9.25H4zM9.25 1.75V5h3.25M6 8.25h4.5M6 10.5h3"/></svg>
  <h1>{{ t("holding.page.we-can-t-find-that-page", "We can't find that page") }}</h1>
  <p>{{ t("holding.page.it-may-have-moved-or-the-link", "There's nothing at this address.") }}</p>
  <a class="fault-go" href="/library">{{ t("holding.page.go-to-the-library", "Go to the library") }}</a>
</main>
{% include '_foot.html.j2' %}

<script>window.TARGUM_LANGUAGES = { {% for code, name in languages %}"{{ code }}": "{{ name }}"{% if not loop.last %}, {% endif %}{% endfor %} };</script>
{% if strings %}<script>window.TARGUM_STRINGS = {{ strings|tojson }};</script>
{% endif %}<script>{{ asset('strings.js') }}</script>
<script>{{ asset('lang.js') }}</script>
<script>{{ asset('sync.js') }}</script>
<script>{{ asset('account.js') }}</script>
</body>
</html>
