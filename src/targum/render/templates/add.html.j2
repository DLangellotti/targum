<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Add — targum</title>
{% include '_icons.html.j2' %}
<style>{{ asset('reader.css') }}{{ asset('chrome.css') }}{{ asset('add.css') }}</style>
{{ hebrew_face() }}
<script>{{ asset('theme.js') }}</script>
</head>
<body class="add">
{% set here = 'add' %}
{% include '_nav.html.j2' %}
<script>{{ asset('building.js') }}</script>
<main class="add-main">
  {#- This page used to be the front door and opened by saying what targum is. Reached
      from the nav by somebody who already has an account and a shelf, that reads as a
      stranger's greeting to a regular. It says what it is for instead. -#}
  <h1 class="lede">Add</h1>
  {#- Worth a look before waiting for a build, and no more than that: the catalogue is a
      few hundred texts, not most of what anybody wants. -#}
  <p class="hint">It may already be in
    <a class="to-library" href="/library">Library</a>.</p>

  {% if no_key %}
  <p class="notice" role="status">{{ no_key }}</p>
  {% endif %}

  {#- Two columns, so the whole of it is one screen. It was a column of five stacked
      sections and the button that starts a build was below the fold on a laptop: what
      the page asks for is small, and asking for it in single file made it look long. -#}
  <div class="add-grid">
    <section class="step">
      <h2>Your content</h2>

      <div class="drop" id="drop" tabindex="0">
        <p class="drop-label">Drop a book, an article, or a recording</p>
        <p class="drop-note">EPUB, plain text, markdown, audio, or video</p>
        <input type="file" id="file"
               accept=".txt,.md,.markdown,.epub,.mp3,.m4a,.m4b,.aac,.ogg,.opus,.flac,.wav,.mp4,.m4v,.mov,.webm,.mkv" hidden>
        <button type="button" id="choose">Choose file</button>
        <button type="button" id="unchoose" class="unchoose" hidden>Something else</button>
      </div>

      {#- The other two ways in, labelled rather than announced: three "or" lines between
          three boxes was three lines of chrome for no information. -#}
      <label class="field">
        <input type="text" id="source" placeholder="Or paste a link" spellcheck="false">
      </label>
      <label class="field">
        <textarea id="pasted" rows="4" spellcheck="false"
                  placeholder="Or paste the text"></textarea>
      </label>
      <p class="hint">Articles, wiki pages, podcast episodes, and YouTube videos. A pasted
        text takes its title from its first line.</p>
      {#- The refusals, named before they are met: a reader who tries a PDF or a Spotify
          link learns the limit from a sentence here rather than from a failed attempt. -#}
      <p class="hint">Not PDF, protected audiobooks (.aax), or Spotify. Nothing behind a
        login. A video counts against your hours, like a recording.</p>

      {#- Only when the file is a recording. A transcript with its own timings makes the
          import free of transcription; without one, targum writes down what is said,
          part by part, as each part is asked for. -#}
      <section class="step" id="audio-extra" hidden>
        <h2>Transcript</h2>
        <div class="segmented" id="spoken-how" role="group" aria-label="Where the transcript comes from">
          <button type="button" class="segment" data-spoken="make" aria-pressed="true">Transcribe</button>
          <button type="button" class="segment" data-spoken="mine" aria-pressed="false">I have one</button>
        </div>
        <p class="hint" id="spoken-note">targum writes down what is said, part by part.</p>
        <div id="have-transcript" hidden>
          <div class="drop small" id="drop-transcript" tabindex="0">
            <p class="drop-label">Drop the transcript</p>
            <p class="drop-note">SRT or VTT, timings kept</p>
            <input type="file" id="transcript" accept=".srt,.vtt" hidden>
            <button type="button" id="choose-transcript">Choose file</button>
            <button type="button" id="unchoose-transcript" class="unchoose" hidden>Something else</button>
          </div>
        </div>
      </section>
    </section>

    <div class="beside">
      {#- A translation the reader already has is a translation nobody has to make. The
          aligner lines it up sentence by sentence, the same way the catalogue's published
          translations are lined up. -#}
      <section class="step">
        <h2>Translation</h2>
        <div class="segmented" id="how" role="group" aria-label="Where the translation comes from">
          <button type="button" class="segment" data-how="make" aria-pressed="true">Make one</button>
          <button type="button" class="segment" data-how="mine" aria-pressed="false">I have one</button>
        </div>
        <p class="hint" id="how-note">targum translates it, sentence by sentence.</p>

        <div id="have-translation" hidden>
          <div class="drop small" id="drop-translation" tabindex="0">
            <p class="drop-label">Drop the translation</p>
            <p class="drop-note">Plain text or markdown, in reading order</p>
            <input type="file" id="translation" accept=".txt,.md,.markdown,.epub" hidden>
            <button type="button" id="choose-translation">Choose file</button>
            <button type="button" id="unchoose-translation" class="unchoose" hidden>Something else</button>
          </div>
          <label class="field">
            <textarea id="pasted-translation" rows="3" spellcheck="false"
                      placeholder="Or paste the translation"></textarea>
          </label>
        </div>
      </section>

      <section class="step">
        <h2>Languages</h2>
        <div class="options">
          {#- Three in and two out, each one saying how far along it is. Narrower than
              what the rest of the app can show: these are the pairs an upload has been
              taken end to end in. -#}
          <label class="field short">
            <span>I am reading</span>
            <select id="from">
              {% for one in reading %}<option value="{{ one.code }}"{% if loop.first %} selected{% endif %}>{{ one.name }} ({{ one.label }})</option>{% endfor %}
            </select>
          </label>
          <label class="field short">
            <span>Translate into</span>
            {# No `selected` here: which language you read into is a choice you have
               already made, and `add.js` restores it. Marking the first one selected made
               the page forget it on every visit, which for anyone who reads into anything
               but English was a wrong answer waiting to be submitted. -#}
            <select id="to">
              {% for one in into %}<option value="{{ one.code }}">{{ one.name }} ({{ one.label }})</option>{% endfor %}
            </select>
          </label>
        </div>
        <p class="hint" id="from-beta" hidden></p>
      </section>

      <button type="button" id="go" class="go">Read this</button>
      <p class="hint caps">You will see how long first.</p>
    </div>
  </div>

  <div class="status" id="status" hidden></div>

</main>
{% include '_foot.html.j2' %}
<script>
window.TARGUM_KEY = "{{ token }}";
window.TARGUM_LANGUAGES = { {% for code, name in languages %}"{{ code }}": "{{ name }}"{% if not loop.last %}, {% endif %}{% endfor %} };
{#- `tojson` rather than quoting these by hand: an ampersand written into a script block
    comes out as `&amp;`, and "R&D" stopped matching itself. -#}
window.TARGUM_READING = {{ reading|tojson }};
window.TARGUM_INTO = {{ into|tojson }};
</script>
<script>{{ asset('lang.js') }}</script>
<script>{{ asset('sync.js') }}</script>
<script>{{ asset('account.js') }}</script>
<script>{{ asset('add.js') }}</script>
</body>
</html>
