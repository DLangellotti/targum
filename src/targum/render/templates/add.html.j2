<!doctype html>
<html lang="{{ page_language|default('en') }}">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>{{ t("add.page.upload-targum", "Upload — targum") }}</title>
{% include '_icons.html.j2' %}
<style>{{ asset('tokens.css') }}{{ asset('shared.css') }}{{ asset('chrome.css') }}{{ asset('add.css') }}</style>
{{ hebrew_face() }}
<script>{{ asset('keep.js') }}</script>
{#- The key, before anything that reads it (targum-internal#343). `building.js`, and
    the conversation's pill, the followed series and the palette in the nav, each read `window.TARGUM_KEY`
    once as they load; it was set in a script at the foot of the body, so on a local serve
    they held an empty key for the life of the page and the bell, the followed series and
    the chat list were refused. The hosted box has no key and was never affected. -#}
<script>window.TARGUM_KEY = "{{ token }}";</script>
</head>
<body class="add">
{% set here = 'add' %}{% set title = t("add.page.upload", "Upload") %}
{% include '_nav.html.j2' %}
<script>{{ asset('building.js') }}</script>
<main class="add-main">
  {#- The board's two columns (UploadDesk; design.md §12, "Upload is the board's", 2026-10-09):
      the box and what works on the left, and on the right the card a link or a file is
      priced on. On a phone they are one column and the card comes after the box. -#}
  <div class="add-grid">
  <div class="add-left">

  {% if no_key %}
  <p class="notice card" role="status">{{ no_key }}</p>
  {% endif %}

  {#- One box, for any medium (design.md §12, 2026-09-13, targum-internal#249), drawn as
      the board draws it (2026-10-09): a field for a link or a text, a dashed place to drop
      a file, the language the text is in, and Upload. The line under it says what targum
      thinks it was given; every other choice is behind Change. -#}
  {% include '_glyphs.html.j2' %}
  <section class="card bring" id="bring-box" aria-label="{{ t("add.page.what-to-add", "What to add") }}">
    <div class="given-field" id="given-field">
      <label class="given-label" for="given">{{ t("add.page.paste-a-link", "Paste a link") }}</label>
      <div class="given-well" id="given-well">
        <textarea id="given" rows="1" dir="auto" spellcheck="false" aria-describedby="understood"
                  placeholder="{{ t("add.page.link-placeholder.say", "An article, a video, a podcast, or say what you want") }}"></textarea>
      </div>
    </div>
    {#- The whole card takes a dropped file; this is where it says so, and where what was
        dropped is held, one chip a file. -#}
    <div class="drop" id="drop">
      <ul class="given-files" id="given-files" hidden></ul>
      <div class="drop-say" id="drop-say" role="button" tabindex="0" aria-controls="file">
        <svg class="drop-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M12 15V4M7.5 8.5 12 4l4.5 4.5M4.5 14.5v4.5h15v-4.5"/></svg>
        <svg class="drop-icon drop-icon-phone" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M4 8h3l1.5-2h7L17 8h3v10.5H4z"/><circle cx="12" cy="13" r="3.2"/></svg>
        <p class="drop-line">
          <span class="drop-line-desk">{{ t("add.page.drop-here", "Drop a file, a photo of a page, or a post here") }}</span>
          <span class="drop-line-phone">{{ t("add.page.choose-or-photo", "Choose a file or take a photo of a page") }}</span>
        </p>
      </div>
      <div class="drop-row">
        <button type="button" id="choose" class="btn ghost outline bring-choose">{{ t("add.page.choose-a-file", "Choose a file") }}</button>
        {#- Something the reader records themselves (targum-internal#254; back on the board's
            card since 2026-10-10, design.md §12). Hidden until the script says this browser
            can record, so the page never offers what it cannot do — the composer's Speak
            follows the same rule. The clip is a file like a dropped one. -#}
        <button type="button" id="record" class="btn ghost outline bring-record" hidden
                aria-pressed="false" aria-label="{{ t("add.page.record", "Record") }}" title="{{ t("add.page.record", "Record") }}"><svg class="glyph" aria-hidden="true" focusable="false"><use class="glyph-use" href="#glyph-mic"/></svg><span id="record-word">{{ t("add.page.record", "Record") }}</span></button>
        {#- A post from a platform targum does not fetch from, or will not today: the
            reader brings it by hand (targum-internal#158). The board draws a post as a
            thing dropped here; a post typed in by hand stays a press of its own. -#}
        <button type="button" id="post-open" class="btn text small bring-post" aria-expanded="false" aria-controls="post-form">{{ t("add.page.bring-a-post", "Bring a post") }}</button>
      </div>
    </div>
    <input type="file" id="file" multiple
           accept=".txt,.md,.markdown,.epub,.pdf,.srt,.vtt,.png,.jpg,.jpeg,.webp,.heic,.heif,.mp3,.m4a,.m4b,.aac,.ogg,.opus,.flac,.wav,.mp4,.m4v,.mov,.webm,.mkv" hidden>
    <p class="understood" id="understood" aria-live="polite"></p>
    <div class="bring-row">
      {#- Which language the text is in: the nav's language menu is the same choice
          (2026-09-13), and the board puts it here, beside Upload. -#}
      <label class="from-field" for="from">
        <span>{{ t("add.page.the-text-is-in", "The text is in") }}</span>
        <select id="from">
          {% for one in reading %}<option value="{{ one.code }}"{% if loop.first %} selected{% endif %}>{{ one.name }}</option>{% endfor %}
        </select>
      </label>
      {#- Paused where nothing new can be made (2026-09-14): the notice above said so and
          the button went on offering, and a press only repeated the notice. -#}
      <button type="button" id="go" class="btn filled go"{% if no_key %} disabled{% endif %}>{{ t("add.page.upload", "Upload") }}</button>
    </div>
    <p class="hint" id="from-beta" hidden></p>
  </section>

  {#- A post, brought by hand (targum-internal#158; design.md §12, "A post keeps its
      shape", amended 2026-09-27). For the post targum cannot fetch — X while its door is
      shut, a post behind a login, one saved on a phone — the reader types who posted it
      and what it says and adds its pictures or its video, and it arrives as the pasted
      ones do: its head, its pictures in their order, its words the text. It takes the
      box's place while it is open, so the page still has one filled button. Nothing is
      fetched, and the pictures' words are read only if the reader presses for it. -#}
  <section class="card post-form" id="post-form" aria-labelledby="post-form-title" hidden>
    <h2 class="post-form-title" id="post-form-title">{{ t("add.page.bring-a-post", "Bring a post") }}</h2>
    <p class="hint">{{ t("add.page.post-what", "Type in a post we can't fetch, and upload its pictures or video. Only you will see it.") }}</p>
    <div class="post-where">
      <span class="post-label" id="post-where-label">{{ t("add.page.post-posted-on", "Posted on") }}</span>
      <div class="seg" id="post-where" role="group" aria-labelledby="post-where-label">
        <button type="button" class="segment" data-platform="instagram" aria-pressed="true">Instagram</button>
        <button type="button" class="segment" data-platform="tiktok" aria-pressed="false">TikTok</button>
        <button type="button" class="segment" data-platform="x" aria-pressed="false">X</button>
      </div>
    </div>
    <div class="post-who">
      <label class="field">
        <span>{{ t("add.page.post-handle", "Handle") }}</span>
        <input type="text" id="post-handle" dir="ltr" autocomplete="off" autocapitalize="none" spellcheck="false" maxlength="31" placeholder="@">
      </label>
      <label class="field">
        <span>{{ t("add.page.post-name", "Name, if it shows one") }}</span>
        <input type="text" id="post-name" dir="auto" autocomplete="off" maxlength="80">
      </label>
    </div>
    <label class="field">
      <span>{{ t("add.page.post-words", "What it says") }}</span>
      <textarea id="post-words" rows="4" dir="auto" spellcheck="false"></textarea>
    </label>
    <div class="post-media">
      <span class="post-label">{{ t("add.page.post-media", "Its pictures or video") }}</span>
      <ul class="given-files" id="post-files" hidden></ul>
      <input type="file" id="post-file" multiple accept=".png,.jpg,.jpeg,.webp,.heic,.heif,.mp4,.m4v,.mov,.webm,.mkv" hidden>
      <div class="bring-row">
        <button type="button" id="post-choose" class="btn tonal bring-choose"><svg class="glyph" aria-hidden="true" focusable="false"><use href="#glyph-file"/></svg><span>{{ t("add.page.choose-files", "Choose files") }}</span></button>
        <p class="hint">{{ t("add.page.post-media-note", "In the post's order. We don't read the words in them unless you ask.") }}</p>
      </div>
    </div>
    <label class="field">
      <span>{{ t("add.page.post-link", "Its link, if you have it") }}</span>
      <input type="url" id="post-link" dir="ltr" autocomplete="off" spellcheck="false" inputmode="url">
    </label>
    <div class="bring-row">
      <button type="button" id="post-back" class="btn ghost">{{ t("add.page.post-back", "Back") }}</button>
      <button type="button" id="post-go" class="btn filled go"{% if no_key %} disabled{% endif %}>{{ t("add.page.continue", "Continue") }}</button>
    </div>
  </section>

  {#- What the box understood, and every choice on one line. -#}
  <div class="card summary" id="summary" hidden>
    <p class="summary-line" id="summary-line"></p>
    <button type="button" id="change" class="btn text change" aria-expanded="false" aria-controls="options">{{ t("add.page.change", "Change") }}</button>
  </div>

  {#- The manual page: the controls the form had, with the ids they had, so a reader who
      knows exactly what they brought is never asked to trust a guess. Rows that do not
      apply to what is in the box are hidden. -#}
  <section class="card options" id="options" aria-label="{{ t("add.page.choices", "Choices") }}" hidden>
    <div class="option-row">
      <h2>{{ t("add.page.translations-in", "Translations in") }}</h2>
      <div class="option-body">
        <div class="pickers">
          {#- Three in and two out, each one saying how far along it is. Narrower than
              what the rest of the app can show: these are the pairs an upload has been
              taken end to end in. -#}
          <label class="field short">
            <span>{{ t("add.page.translations-in", "Translations in") }}</span>
            {# No `selected` here: which language you read into is a choice you have
               already made, and `add.js` restores it. Marking the first one selected made
               the page forget it on every visit, which for anyone who reads into anything
               but English was a wrong answer waiting to be submitted. -#}
            <select id="to">
              {% for one in into %}<option value="{{ one.code }}">{{ one.name }} ({{ one.label }})</option>{% endfor %}
            </select>
          </label>
        </div>
      </div>
    </div>

    {#- A translation the reader already has is a translation nobody has to make. The
        aligner lines it up sentence by sentence, the same way the catalogue's published
        translations are lined up. -#}
    <div class="option-row" id="translation-row">
      <h2>{{ t("add.page.translation", "Translation") }}</h2>
      <div class="option-body">
        <div class="seg" id="how" role="group" aria-label="{{ t("add.page.where-the-translation-comes-from", "Where the translation comes from") }}">
          <button type="button" class="segment" data-how="make" aria-pressed="true">{{ t("add.page.we-ll-make-one", "We'll make one") }}</button>
          <button type="button" class="segment" data-how="mine" aria-pressed="false">{{ t("add.page.i-have-one", "I have one") }}</button>
        </div>
        <p class="hint" id="how-note">{{ t("add.page.we-ll-translate-it-sentence-by-sentence", "We'll translate it, sentence by sentence.") }}</p>
        <div id="have-translation" hidden>
          <div class="drop small" id="drop-translation" tabindex="0">
            <p class="drop-label">{{ t("add.page.drop-the-translation", "Drop the translation") }}</p>
            <p class="drop-note">{{ t("add.page.plain-text-or-markdown-in-reading-order", "A text file or an ebook, in reading order") }}</p>
            <input type="file" id="translation" accept=".txt,.md,.markdown,.epub" hidden>
            <button type="button" id="choose-translation">{{ t("add.page.choose-file", "Choose file") }}</button>
            <button type="button" id="unchoose-translation" class="unchoose" hidden>{{ t("add.page.something-else", "Remove file") }}</button>
          </div>
          <label class="field">
            <textarea id="pasted-translation" class="well" rows="3" dir="auto" spellcheck="false"
                      placeholder="{{ t("add.page.or-paste-the-translation", "Or paste the translation") }}"></textarea>
          </label>
        </div>
      </div>
    </div>

    {#- Only when the box holds a recording. A transcript with its own timings makes the
        import free of transcription; without one, targum writes down what is said, part
        by part, as each part is asked for. -#}
    <div class="option-row" id="audio-extra" hidden>
      <h2>{{ t("add.page.transcript", "Transcript") }}</h2>
      <div class="option-body">
        <div class="seg" id="spoken-how" role="group" aria-label="{{ t("add.page.where-the-transcript-comes-from", "Where the transcript comes from") }}">
          <button type="button" class="segment" data-spoken="make" aria-pressed="true">{{ t("add.page.we-ll-write-one", "We'll write one") }}</button>
          <button type="button" class="segment" data-spoken="mine" aria-pressed="false">{{ t("add.page.i-have-one", "I have one") }}</button>
        </div>
        <p class="hint" id="spoken-note">{{ t("add.page.we-ll-write-down-what-s-said", "We'll write down what's said, part by part.") }}</p>
        <div id="have-transcript" hidden>
          <div class="drop small" id="drop-transcript" tabindex="0">
            <p class="drop-label">{{ t("add.page.drop-the-transcript", "Drop the transcript") }}</p>
            <p class="drop-note">{{ t("add.page.srt-or-vtt-timings-kept", "A subtitle file (SRT or VTT)") }}</p>
            <input type="file" id="transcript" accept=".srt,.vtt" hidden>
            <button type="button" id="choose-transcript">{{ t("add.page.choose-file", "Choose file") }}</button>
            <button type="button" id="unchoose-transcript" class="unchoose" hidden>{{ t("add.page.something-else", "Remove file") }}</button>
          </div>
        </div>
      </div>
    </div>
  </section>

  {#- The library answering while the box is typed in (targum-internal#251): a text
      already here is said before Continue, not after a price for making a second copy
      of it. Drawn by `add.js`; empty and out of the way until it has something. -#}
  <div class="card already" id="already" hidden></div>

  {#- Where a month's credits are spent, the panel that says so stands here: Top up,
      greyed until there is somewhere to pay, and what still works (design.md §12,
      2026-10-09). Otherwise the balance is said on the card a press is priced on, with
      its rate, and nowhere else on the page. -#}
  <p class="hint hours" id="hours" hidden></p>

  {#- What works, as the board lists it, in place of the paragraph of refusals named in
      advance (gone since targum-internal#252): each refusal is said where it happens,
      with the way on. -#}
  <section class="works" aria-labelledby="works-title">
    <h2 class="works-title" id="works-title">{{ t("add.page.what-works", "What works") }}</h2>
    <ul class="works-list">
      <li><svg viewBox="0 0 16 16" aria-hidden="true" focusable="false"><path d="M4 2.5h8v11H4zM6 5.5h4M6 8h4M6 10.5h2.5"/></svg>{{ t("add.page.works-articles", "Articles from any news site or blog") }}</li>
      <li><svg viewBox="0 0 16 16" aria-hidden="true" focusable="false"><rect x="2" y="3.5" width="12" height="9" rx="1.5"/><path d="M7 6.3v3.4L9.8 8z"/></svg>{{ t("add.page.works-videos", "YouTube, Instagram and TikTok videos") }}</li>
      <li><svg viewBox="0 0 16 16" aria-hidden="true" focusable="false"><rect x="6" y="1.5" width="4" height="8" rx="2"/><path d="M4 7.5a4 4 0 0 0 8 0M8 11.5v2.5M5.5 14h5"/></svg>{{ t("add.page.works-podcasts", "Podcast episodes") }}</li>
      <li><svg viewBox="0 0 16 16" aria-hidden="true" focusable="false"><path d="M4 2.5h5l3 3v8H4zM9 2.5v3h3"/></svg>{{ t("add.page.works-pdfs", "PDFs") }}</li>
      <li><svg viewBox="0 0 16 16" aria-hidden="true" focusable="false"><path d="M2.5 5h2.5l1.2-1.5h3.6L11 5h2.5v7.5h-11z"/><circle cx="8" cy="8.7" r="2.2"/></svg>{{ t("add.page.works-photos", "Photos of a page, up to 30 pages") }}</li>
      <li><svg viewBox="0 0 16 16" aria-hidden="true" focusable="false"><path d="M3.5 2.5h8.5v11H3.5zM5.5 2.5v11"/></svg>{{ t("add.page.works-ebooks", "An e-book") }}</li>
    </ul>
  </section>
  </div>

  {#- The card a link or a file is priced on, refused on, or built from: the board's
      preview, beside the box at a desk and under it on a phone. -#}
  <div class="add-right">
    <div class="card status" id="status" hidden></div>
  </div>
  </div>

</main>
{% include '_foot.html.j2' %}
<script>
window.TARGUM_KEY = "{{ token }}";
window.TARGUM_LANGUAGES = { {% for code, name in languages %}"{{ code }}": "{{ name }}"{% if not loop.last %}, {% endif %}{% endfor %} };
{#- `tojson` rather than quoting these by hand: an ampersand written into a script block
    comes out as `&amp;`, and "R&D" stopped matching itself. -#}
window.TARGUM_READING = {{ reading|tojson }};
window.TARGUM_INTO = {{ into|tojson }};
{% if strings %}window.TARGUM_STRINGS = {{ strings|tojson }};
{% endif %}</script>
<script>{{ asset('strings.js') }}</script>
<script>{{ asset('lang.js') }}</script>
<script>{{ asset('sync.js') }}</script>
<script>{{ asset('account.js') }}</script>
<script>{{ asset('bring.js') }}</script>
{#- The recorder the composer's Speak uses, so a voice note can be made here rather than
    only brought (targum-internal#254). Before `add.js`, which asks it whether this
    browser can record before drawing Record. -#}
<script>{{ asset('speak.js') }}</script>
<script>{{ asset('add.js') }}</script>
</body>
</html>
