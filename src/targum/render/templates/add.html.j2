<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Add a text — targum</title>
{% include '_icons.html.j2' %}
<style>{{ asset('reader.css') }}{{ asset('chrome.css') }}{{ asset('add.css') }}</style>
<script>{{ asset('theme.js') }}</script>
</head>
<body class="add">
{% set here = 'add' %}
{% include '_nav.html.j2' %}
<main class="add-main">
  {#- This page used to be the front door and opened by saying what targum is. Reached
      from the nav by somebody who already has an account and a shelf, that reads as a
      stranger's greeting to a regular. It says what it is for instead. -#}
  <h1 class="lede">Add a text</h1>
  {#- Said before anything is priced. Most of what anybody wants is already on a shelf,
      and finding that out after paying is the wrong order round. -#}
  <p class="hint">Most things are already in the
    <a class="to-library" href="/library">Library</a>, translated and free.</p>

  {% if no_key %}
  <p class="notice" role="status">{{ no_key }}</p>
  {% endif %}

  <section class="step">
    <h2>The text</h2>

    <div class="drop" id="drop" tabindex="0">
      <p class="drop-label">Drop a book or an article here</p>
      <p class="drop-note">EPUB, plain text, or markdown</p>
      <input type="file" id="file" accept=".txt,.md,.markdown,.epub" hidden>
      <button type="button" id="choose">Choose file</button>
      <button type="button" id="unchoose" class="unchoose" hidden>Something else</button>
    </div>

    <p class="or">or paste a link</p>

    <label class="field">
      <input type="text" id="source" placeholder="https://…" spellcheck="false">
    </label>
    <p class="hint">Articles and wiki pages. No logins, paywalls or PDFs.</p>
  </section>

  <section class="step">
    <h2>Languages</h2>
    <div class="options">
      <label class="field short">
        <span>I am reading</span>
        <select id="from">
          {% for code, name in languages %}<option value="{{ code }}"{% if code == 'he' %} selected{% endif %}>{{ name }}{% if code != 'he' %} (beta){% endif %}</option>{% endfor %}
          <option value="">work it out for me</option>
        </select>
      </label>
      <label class="field short">
        <span>Translate into</span>
        <select id="to">
          {% for code, name in languages %}<option value="{{ code }}"{% if code == 'en' %} selected{% endif %}>{{ name }}</option>{% endfor %}
        </select>
      </label>
    </div>
    <p class="hint" id="from-beta" hidden></p>
  </section>

  <button type="button" id="go" class="go">Read this</button>
  <p class="hint caps">You will see how long first.</p>
  <div class="status" id="status" hidden></div>

</main>
{% include '_foot.html.j2' %}
<script>
window.TARGUM_KEY = "{{ token }}";
window.TARGUM_LANGUAGES = { {% for code, name in languages %}"{{ code }}": "{{ name }}"{% if not loop.last %}, {% endif %}{% endfor %} };
</script>
<script>{{ asset('lang.js') }}</script>
<script>{{ asset('sync.js') }}</script>
<script>{{ asset('account.js') }}</script>
<script>{{ asset('add.js') }}</script>
</body>
</html>
