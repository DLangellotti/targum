<!doctype html>
<html lang="{{ page_language|default('en') }}">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>{{ t("playlists.page.title-targum", "Your playlists — targum") }}</title>
{% include '_icons.html.j2' %}
<style>{{ asset('tokens.css') }}{{ asset('shared.css') }}{{ asset('chrome.css') }}{{ asset('words.css') }}{{ asset('library.css') }}{{ asset('you.css') }}{{ asset('playlists.css') }}</style>
{{ hebrew_face() }}
<script>{{ asset('keep.js') }}</script>
<script>window.TARGUM_KEY = "{{ token }}";</script>
</head>
<body class="playlists">
{#- Playlists is Your targums' third tab (design.md §12, 2026-09-26): the nav lights Your
    targums, the heading is its, and the same strip stands at the top with Playlists
    chosen, so the three read as one place though this is a page of its own. -#}
{% set here = 'texts' %}{% set title = t("yours.page.your-targums", "Your targums") %}
{% include '_nav.html.j2' %}
<script>{{ asset('building.js') }}</script>

{#- A playlist is the reader's (targum-internal#364; design.md §12, "A playlist is swiped,
    and one press takes the set", 2026-09-23): texts kept in an order, to go through one
    after another. This page keeps them; the swipe that goes through them is #366. -#}
<main>
  {#- The tab, and one playlist on its own page (targum-internal#434, boards PlaylistsTab
      and PlaylistDetail): `/playlists` is the tab, `/playlists/<id>` the one, and the
      script decides which from the address. -#}
  <div class="pl-tabs-row" id="tabs-row">
    {% set tab = 'playlists' %}{% include '_yours_tabs.html.j2' %}
    <button type="button" class="pl-new-press" id="new-press" hidden>{{ t("playlists.page.new-playlist", "New playlist") }}</button>
  </div>
  <section class="panel" id="stranger" hidden>
    <p class="note">{{ t("playlists.page.sign-in", "Sign in to see your playlists.") }}</p>
  </section>

  {#- Reached from a shelf row or a reader's ⋯ menu with `?add=<name>&title=<title>`: the
      one sheet both doors open. Every playlist is a button, and a new one is a name. The
      name field is also what New playlist opens. -#}
  {#- On the dim, as a small window at a desk and a sheet on a phone (board
      PlaylistMake), with a way to put it away that does not add anything. -#}
  <div class="scrim pl-scrim" id="adding-scrim" hidden></div>
  <section class="panel pl-sheet" id="adding" hidden role="dialog" aria-modal="true" aria-labelledby="adding-head">
    <div class="pl-sheet-top">
      <h2 id="adding-head"></h2>
      <button type="button" class="pl-sheet-shut" id="adding-shut" aria-label="{{ t("playlists.page.close", "Close") }}">×</button>
    </div>
    <ul class="choose" id="choose"></ul>
    <form class="new-list" id="new-list">
      <label class="field">
        <span id="new-label">{{ t("playlists.page.new-playlist", "New playlist") }}</span>
        <input type="text" id="new-name" maxlength="80" dir="auto" autocomplete="off"
               placeholder="{{ t("playlists.page.name-it", "Name") }}">
      </label>
      <button type="submit" class="btn filled">{{ t("playlists.page.make-it", "Confirm") }}</button>
    </form>
    {#- A refusal of the name stands under its field (review §3.11). -#}
    <p class="said" id="adding-said" role="status" hidden></p>
  </section>

  <section class="pl-lists" id="lists" hidden aria-label="{{ t("playlists.page.title", "Your playlists") }}">
    <p class="note" id="none" hidden>{{ t("playlists.page.none-yet", "No playlists yet. Use Add to playlist on any text to start one.") }}</p>
    <div class="pl-grid" id="playlists"></div>
    <p class="said" id="lists-said" role="status" hidden></p>
  </section>

  {#- targum's own playlists (targum-internal#368): built once on the shared shelf, and
      opened as a playlist of the reader's own for nothing. Shown only when this box has
      one with something built in it. -#}
  <section class="pl-from-targum" id="from-targum" hidden aria-labelledby="from-targum-head">
    <div class="pl-section-head">
      <h2 class="section-title" id="from-targum-head">{{ t("playlists.page.from-targum", "From targum") }}</h2>
      <p class="note">{{ t("playlists.page.from-targum-note", "Short videos and texts. Opening them uses no credits.") }}</p>
    </div>
    <ul class="pl-targum" id="targum-sets"></ul>
    <p class="said" id="targum-said" role="status" hidden></p>
  </section>

  {#- One playlist (board PlaylistDetail): its cover, whose it is, what it adds up to,
      where to pick it up, and its texts in order, moved by a drag or Alt+↑/↓. -#}
  <section class="pl-one" id="one" hidden aria-labelledby="one-name">
    <a class="pl-back" id="back" href="/playlists">{{ t("playlists.page.back", "Playlists") }}</a>
    <div id="one-body"></div>
    <p class="said" id="one-said" role="status" hidden></p>
  </section>
</main>
{% include '_foot.html.j2' %}

<script>
window.TARGUM_KEY = "{{ token }}";
window.TARGUM_LANGUAGES = { {% for code, name in languages %}"{{ code }}": "{{ name }}"{% if not loop.last %}, {% endif %}{% endfor %} };
{% if strings %}window.TARGUM_STRINGS = {{ strings|tojson }};
{% endif %}</script>
<script>{{ asset('strings.js') }}</script>
<script>{{ asset('lang.js') }}</script>
<script>{{ asset('sync.js') }}</script>
<script>{{ asset('account.js') }}</script>
<script>{{ asset('playlists.js') }}</script>
</body>
</html>
