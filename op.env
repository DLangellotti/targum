# The laptop's keys, as references into 1Password (targum-internal#326). Nothing here is
# a secret: each line names an item in the `targum` vault, and `op run` swaps the value in
# for the life of one command and no longer.
#
#   op run --env-file op.env -- .venv/bin/python ...
#
# The laptop has its own Anthropic and OpenAI keys, not the box's — two keys, so a
# console's usage says which machine spent it. The box's list is deploy/box.env.op.
ANTHROPIC_API_KEY=op://targum/Anthropic laptop/credential
OPENAI_API_KEY=op://targum/OpenAI laptop/credential
TARGUM_TTS_KEY=op://targum/Gemini/credential
TYPESAFE_API_KEY=op://targum/Typesafe/credential
TARGUM_VERTEX_TTS_KEY=op://targum/Google Cloud TTS/credential

# YouTube Data API v3 key for `targum video discover` (targum-internal#382)
TARGUM_YOUTUBE_API_KEY=op://targum/YouTube Data API v3/credential
