# /etc/systemd/system/targum-tables.service — installed by deploy.sh, started by
# targum-tables.timer at 02:30 UTC (targum-internal#587, David approved 2026-10-30).
#
# The language tables' nightly sweep: counts the words, phrases and verb roots of every
# public text on the shelf whose annotation has no current count yet, into the corpus
# ledger (TARGUM_LEDGER, from targum.env). It catches what the laptop built and shipped,
# since a shipped folder never ran the box's pipeline. It reads the annotation.json files
# already written and runs no annotator: `tables sweep` refuses to import a model package
# at all (`tables.no_models`), so it can never load a second DICTA beside the service's.
# A reader's home is skipped, whatever it holds. Nothing is fetched and nothing is spent.
# Run again, it counts only what is new, so a missed night costs nothing.
#
# News is not counted here (targum-internal#582): that needs DICTA, which this unit
# refuses to load, so the service counts the feeds itself at 01:30 UTC with the copy it
# already holds (`tables.news`), and the snapshot below takes those counts in.
#
# With TARGUM_IMPORT_COUNTS=1 in targum.env (David, 2026-11-01; off until the privacy
# notice's sentence is live), the same run pools what readers brought into the `imports`
# register: the homes of every account that has not turned counting off, read from
# targum.db (--store), counts only, a row only where ten readers' material holds it, and
# made again from nothing each night, so a reader who turns it off is out by morning.
# With the switch off the pool is deleted.
#
# With --store, the same run also folds the discovery pool's public finds into the tables
# (David, 2026-11-01; `tables.finds`): each kept find's lemma counts, never its words,
# into video, news, or by a web find's host, whatever TARGUM_IMPORT_COUNTS says, since a
# find is web material targum found itself. A news item the 01:30 feed count holds is not
# counted again.
#
# Before the backup at 04:00, so the night's rows are in the night's copy of corpus.db.
#
# Then `tables snapshot` (targum-internal#579): the yardsticks "How much Hebrew you
# understand" measures readers against, one JSON file per register in
# /var/lib/targum/tables. It writes a register's list only when it has none yet or the
# month has turned, so on most nights it reads the files' dates and does nothing; the
# monthly snapshot rides the nightly unit rather than a timer of its own. It runs after
# the sweep has succeeded, and a failed sweep leaves last month's lists standing.
#
#   systemctl start targum-tables      # one now, by hand
#   journalctl -u targum-tables -n 20

[Unit]
Description=targum language tables sweep and yardsticks
# The ledger is a file the service writes too; SQLite's lock keeps the two apart.
After=targum.service

[Service]
Type=oneshot
# As targum, never as root: a root-owned corpus.db, or a root-owned __pycache__ in the
# tool's tree, breaks the service's writes and the next deploy.
User=targum
Group=targum
Environment=HOME=/srv/targum
EnvironmentFile=/etc/targum/targum.env
ExecStart=/usr/local/bin/targum tables sweep --library /var/lib/targum/targums --store /var/lib/targum/targum.db
ExecStart=/usr/local/bin/targum tables snapshot --out /var/lib/targum/tables
# Out of the way of readers: a count can wait, a page cannot.
Nice=19
CPUSchedulingPolicy=idle
IOSchedulingClass=idle
# A cap of its own, so a sweep that grows is killed inside its own cgroup and never
# pushes the service out of memory. The largest annotation on the laptop (42 MB) folds
# in under 300 MB; MemoryHigh throttles well before the hard cap, and no swap, so it
# cannot crowd the service's pages out to disk either.
MemoryHigh=600M
MemoryMax=1G
MemorySwapMax=0
OOMPolicy=kill
TimeoutStartSec=2h
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/targum
# It talks to nothing.
PrivateNetwork=true
