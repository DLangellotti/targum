# /etc/caddy/Caddyfile
#
# Caddy gets a certificate from Let's Encrypt on its own and renews it on its own.
# The only prerequisite is that targum.page's A record already points here.
#
#   caddy validate --config /etc/caddy/Caddyfile && systemctl reload caddy

www.targum.page {
	# One canonical address. `hosts_for()` in serve.py admits www as well, because a
	# registrar's redirect is not always in place on the first day and a reader who
	# types it should not meet a 403.
	redir https://targum.page{uri} permanent
}

targum.page {
	encode zstd gzip

	# A targum is a self-contained HTML file and readers are dropped in whole, so the
	# ceiling here has to clear serve.py's MAX_UPLOAD of 32 MB plus base64's third.
	request_body {
		max_size 48MB
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}
	# Deliberately no Content-Security-Policy here. targum builds its own per page,
	# naming that page's inline blocks by hash, and a blanket header from the proxy
	# would either be redundant or quietly break every page it did not know about.

	reverse_proxy 127.0.0.1:8420 {
		# A build runs for minutes and streams progress. The default would cut it off
		# mid-translation, after the money had been spent.
		transport http {
			response_header_timeout 5m
			read_timeout 10m
		}
	}

	log {
		output file /var/log/caddy/targum.log
		# The sign-in link is a bearer token in a query string. Do not write it down.
		format filter {
			request>uri query {
				delete t
				delete k
			}
		}
	}
}

# The back office. A front door: it forwards everything to targum.page/back-office,
# which is where the page is actually served.
#
# There is no password here, and that is the design rather than an omission. The door is
# an admin session in the app, and the session cookie is host-only — `Path=/`, no
# `Domain` — so a session made on targum.page is never sent to a subdomain. Putting a
# `basic_auth` here as well would have meant two passwords for one page; widening the
# cookie to `.targum.page` would hand every future subdomain every reader's session.
# Serving the page from the origin the session already belongs to is the cheap answer,
# and this name stays as the thing a person types.
#
# It still needs its own A record, or an ALIAS/CNAME to targum.page. Caddy will not get
# a certificate for a name that does not resolve to it, and the failure is a timeout
# rather than a message.
bo.targum.page {
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options nosniff
		X-Robots-Tag "noindex, nofollow, noarchive"
		Referrer-Policy no-referrer
		-Server
	}

	reverse_proxy 127.0.0.1:8420

	log {
		output file /var/log/caddy/back-office.log
	}
}
