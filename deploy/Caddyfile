# /etc/caddy/Caddyfile
#
# Caddy gets a certificate from Let's Encrypt on its own and renews it on its own.
# The only prerequisite is that targum.page's A record already points here.
#
#   caddy validate --config /etc/caddy/Caddyfile && systemctl reload caddy

www.targum.page {
	# One canonical address. `hosts_for()` in serve.py admits www as well, because a
	# registrar's redirect is not always in place on the first day and a reader who
	# types it should not meet a 403.
	redir https://targum.page{uri} permanent
}

targum.page {
	encode zstd gzip

	# A targum is a self-contained HTML file and readers are dropped in whole, so the
	# ceiling here has to clear serve.py's MAX_UPLOAD of 32 MB plus base64's third.
	request_body {
		max_size 48MB
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}
	# Deliberately no Content-Security-Policy here. targum builds its own per page,
	# naming that page's inline blocks by hash, and a blanket header from the proxy
	# would either be redundant or quietly break every page it did not know about.

	reverse_proxy 127.0.0.1:8420 {
		# A build runs for minutes and streams progress. The default would cut it off
		# mid-translation, after the money had been spent.
		transport http {
			response_header_timeout 5m
			read_timeout 10m
		}
	}

	log {
		output file /var/log/caddy/targum.log
		# The sign-in link is a bearer token in a query string. Do not write it down.
		format filter {
			request>uri query {
				delete t
				delete k
			}
		}
	}
}

# The back office. Its own name, so that no path on targum.page reaches it however the
# product's routing changes, and so the door can be a password on the vhost rather than
# a second kind of session inside the app.
#
# The hash goes here and the password goes nowhere: generate it with
#
#   caddy hash-password
#
# and paste the output below. bcrypt, so the file is not worth much to anybody who reads
# it — but this file is on the box and not in the repository for the same reason
# /etc/targum/targum.env is not.
#
# One prerequisite beyond the certificate: bo.targum.page needs its own A record, or an
# ALIAS/CNAME to targum.page. Caddy will not get a certificate for a name that does not
# resolve to it, and the failure is a timeout rather than a message.
bo.targum.page {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options nosniff
		# Nothing here should ever be framed, linked out of, or indexed. The page says
		# noindex itself; this says it to anything that never reads the page.
		X-Frame-Options DENY
		X-Robots-Tag "noindex, nofollow, noarchive"
		Referrer-Policy no-referrer
		-Server
	}

	basic_auth {
		# david <bcrypt hash from `caddy hash-password`>
	}

	reverse_proxy 127.0.0.1:8420

	log {
		output file /var/log/caddy/back-office.log
	}
}
