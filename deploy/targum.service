# /etc/systemd/system/targum.service
#
# targum behind Caddy. It binds loopback and always has — Caddy terminates TLS and
# forwards, so nothing here is reachable from outside except through the proxy.
#
#   systemctl daemon-reload && systemctl enable --now targum
#   journalctl -u targum -f

[Unit]
Description=targum
Documentation=https://github.com/dlangellotti/targum
After=network-online.target
Wants=network-online.target
# Give up after five failures in five minutes rather than restarting into the same
# broken environment forever. `systemctl reset-failed targum` clears it.
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
User=targum
Group=targum
WorkingDirectory=/srv/targum
EnvironmentFile=/etc/targum/targum.env
# Stanza fetches its models through the Hugging Face hub, which caches under $HOME —
# and ProtectHome below makes /srv/targum read-only. Point it at the one writable tree.
Environment=HF_HOME=/var/lib/targum/models/huggingface

# The gate. A deployment fails either here, in the journal, or at somebody's first
# sign-in — and there is only one alpha reader to spend on the second. Non-zero exit
# stops the start, so a missing TARGUM_PUBLIC_ADDRESS never reaches a reader as a
# sign-in link pointing at the server's own loopback address. A missing API key is a
# warning rather than a failure and does not block: the catalogue still works.
ExecStartPre=/usr/local/bin/targum preflight --no-connect \
  --store /var/lib/targum/targum.db --out /var/lib/targum/targums

ExecStart=/usr/local/bin/targum serve --no-open --port 8420 --budget 50 \
  --store /var/lib/targum/targum.db --out /var/lib/targum/targums

Restart=always
RestartSec=10
# Give up after five failures in five minutes rather than restarting into the same
# broken environment forever. `systemctl reset-failed targum` clears it.

# The default is 1024, and each SQLite connection costs two: the file and its WAL.
# Every request thread closes its own now, but a ceiling this low turned one reader's
# afternoon on the shelves into an hour of 502s, and the fix for the next leak should
# be a line in the journal rather than a box that cannot open a template.
LimitNOFILE=65536

# Stanza and LaBSE are large, and a build is a long-running request. Let it finish.
TimeoutStopSec=90
KillSignal=SIGINT

# --- hardening -------------------------------------------------------------
# It parses documents from the open internet and runs somebody else's uploads through
# a model pipeline, so it should be able to reach very little of the box.
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
ProtectClock=true
RestrictSUIDSGID=true
RestrictRealtime=true
RestrictNamespaces=true
LockPersonality=true
MemoryDenyWriteExecute=false
ReadWritePaths=/var/lib/targum
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

[Install]
WantedBy=multi-user.target
