# /etc/systemd/system/targum-finds-web.service — installed by deploy.sh, started by
# targum-finds-web.timer at 00:10 UTC (targum-internal#622, David 2026-11-03).
#
# The nightly round of open-web finds: one Anthropic web search (ANTHROPIC_API_KEY,
# Claude Haiku 4.5 and the search tool) for each of the forty topics' fixed Hebrew
# phrases, then Russian's, while each language's allowance lasts: at most $1 for Hebrew
# and its own $0.50 for Russian (David 2026-11-06), counted from the API's own usage and
# paced inside TARGUM_FINDS_BUDGET_USD, Hebrew first. Each page is fetched direct, never
# through the proxy, after its robots.txt says yes; its words are scored and let go. The
# pool in targum.db keeps the address, title, outlet, day and lemma counts. Each search's
# cost and each find are written as they happen, so a killed run keeps what it found.
#
# Before the search, where TARGUM_FINDS_WIKI=1, Hebrew Wikipedia and Wikivoyage are
# searched on the same phrases through the MediaWiki API, free and with no key, and their
# pages are read as text through it (CC BY-SA 4.0, credited to the wikis' contributors).
# Five pages a host a night is counted across both.
#
# It does nothing until TARGUM_FINDS_WEB=1 or TARGUM_FINDS_WIKI=1 is in targum.env: the
# timer runs every night and the command says what is off.
#
#   systemctl start targum-finds-web      # one now, by hand
#   journalctl -u targum-finds-web -n 20

[Unit]
Description=targum open-web finds, nightly
After=network-online.target targum.service
Wants=network-online.target

[Service]
Type=oneshot
# As targum, never as root: a root-owned targum.db or __pycache__ breaks the service.
User=targum
Group=targum
Environment=HOME=/srv/targum
WorkingDirectory=/srv/targum
EnvironmentFile=/etc/targum/targum.env
ExecStart=/usr/local/bin/targum finds web --store /var/lib/targum/targum.db
Nice=10
MemoryHigh=400M
MemoryMax=800M
TimeoutStartSec=50min
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/targum
