# The box's secrets, as references into 1Password (targum-internal#326). deploy.sh
# resolves these on the laptop with `op inject` and writes the lines into
# /etc/targum/targum.env on every deploy, replacing whatever those names held and
# leaving every other setting in the file as it was.
#
# To add or rotate a key: change it in the vault, add its line here if it is new, deploy.
# A reference the vault cannot resolve stops the deploy before anything is built, by name.
ANTHROPIC_API_KEY=op://targum/Anthropic/credential
OPENAI_API_KEY=op://targum/OpenAI/credential
TARGUM_TTS_KEY=op://targum/Gemini/credential
TARGUM_SMTP_PASSWORD=op://targum/SMTP/credential
TARGUM_YTDLP_PROXY=op://targum/DataImpulse/credential
