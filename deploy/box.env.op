# The box's secrets, as references into 1Password (targum-internal#326). deploy.sh
# resolves these on the laptop with `op inject` and writes the lines into
# /etc/targum/targum.env on every deploy, replacing whatever those names held and
# leaving every other setting in the file as it was.
#
# To add or rotate a key: change it in the vault, add its line here if it is new, deploy.
# A reference the vault cannot resolve stops the deploy before anything is built, by name.
ANTHROPIC_API_KEY=op://targum/Anthropic/credential
OPENAI_API_KEY=op://targum/OpenAI/credential
TARGUM_TTS_KEY=op://targum/Gemini/credential
TARGUM_SMTP_PASSWORD=op://targum/SMTP/credential
TARGUM_YTDLP_PROXY=op://targum/DataImpulse/credential
TARGUM_VERTEX_TTS_KEY=op://targum/Google Cloud TTS/credential
#
# Telegram (targum-internal#328) adds two lines here once the bot exists, naming the
# vault item's token and webhook-secret fields: TARGUM_TELEGRAM_TOKEN and
# TARGUM_TELEGRAM_SECRET. Not before — a reference the vault cannot resolve stops the
# deploy — and never as a commented reference, which `op inject` would still try.
#
#
# The off-box backup (targum-internal#16): the B2 application key `targum-box`, restricted
# to bucket targum-backups-7e2d20 with no right to delete. The item is `Backblaze` in the
# targum vault, named here by its id because an archived item of the same name made the
# name resolve to the wrong one (2026-09-28). Its settings are not secrets and go in
# targum.env on the box (targum.env.example, "backups and alerts"); the age private key
# goes nowhere near it.
RCLONE_CONFIG_BACKBLAZE_ACCOUNT=op://targum/xg467xcx4f3s4hf2own7pzemuy/keyID
RCLONE_CONFIG_BACKBLAZE_KEY=op://targum/xg467xcx4f3s4hf2own7pzemuy/applicationKey
