# Copy to /etc/targum/targum.env, fill in, `chmod 600`, and never commit it.
# Secrets live here and nowhere else — not in the repo, not in the vault, not in a
# shell history.

# --- hosted mode -----------------------------------------------------------
# These two are what turn `targum serve` from the local server into the public one.
# There is no separate program and no flag to remember.
TARGUM_REQUIRE_ACCOUNT=1
TARGUM_PUBLIC_ADDRESS=https://targum.page

# --- email, through Resend -------------------------------------------------
# targum sends exactly one email — a sign-in link — and it is the whole product at
# the door. A link that does not arrive means nobody can get in at all.
TARGUM_SMTP_HOST=smtp.resend.com
TARGUM_SMTP_PORT=587
TARGUM_SMTP_USER=resend
TARGUM_SMTP_PASSWORD=
TARGUM_SMTP_FROM=targum <hello@mail.targum.page>

# --- translation -----------------------------------------------------------
ANTHROPIC_API_KEY=

# --- cover pictures, optional ----------------------------------------------
# The one thing targum asks somebody other than Anthropic for: Claude reads pictures
# and does not draw them. Leave this empty and nothing breaks — the shelf draws each
# text's own first letter, which is the ordinary state rather than a fault, and the
# page never offers to draw one. Filled in, a cover is drawn once and shared by every
# reader of that text.
OPENAI_API_KEY=

# Transcribes imported recordings — audiobooks and podcast episodes a reader brings.
# Scribe's Hebrew is the strongest of the hosted engines, so it is preferred when both
# keys are present; OPENAI_API_KEY above is the fallback (whisper-1). Leave both empty
# and audio without a transcript is off: the page says so, nothing breaks. ffmpeg must
# be installed either way (`apt-get install ffmpeg`); `targum preflight` checks both.
ELEVENLABS_API_KEY=

# --- where things live -----------------------------------------------------
# Models are hundreds of megabytes and want the roomy disk, not the home directory.
TARGUM_MODEL_DIR=/var/lib/targum/models
TARGUM_CACHE_DIR=/var/lib/targum/cache

# The catalogue file, private data the deploy copies beside this one. Read from here
# by default; name another path to point elsewhere.
# TARGUM_CATALOGUE=/etc/targum/catalogue.json

# The recordings and the written dialogues — content, carried by ship-audio.sh, which
# writes these two lines itself if they are missing. Without them the service looks for
# both under its working directory, finds nothing, and every reader is silent with no
# error anywhere to say why.
TARGUM_RECORDING_DIR=/var/lib/targum/recordings
TARGUM_DIALOGUE_DIR=/var/lib/targum/dialogues

# Where the weekly's issues live. The server works this out from its own --out, but a
# standalone `targum build weekly:…` — how a library row builds an edition for one
# person — does not, and falls back to the working directory. ship-weekly.sh writes
# this line itself if it is missing.
TARGUM_WEEKLY_DIR=/var/lib/targum/targums/weekly

# Where the parasha corpus lives, for the same reason and with the same fallback: the
# server would otherwise look under /srv/targum and serve a 404 for every portion while
# the readers sit in /var/lib. ship-parasha.sh writes this line itself if it is missing.
TARGUM_PARASHA_DIR=/var/lib/targum/targums/parasha

# Whether search engines are invited to the portions. Off, deliberately: a portion's page
# is the same page every year, so whatever ranks for its name ranks for a long time, and
# the reading, the audio and the shelf should settle first. While this is unset every
# parasha response says X-Robots-Tag: noindex and the sitemap does not name them.
# TARGUM_INDEX_PARASHA=1

# The same, for the daily learning cycles — /mishna-yomi and its three siblings. Its own
# switch rather than the parasha's on purpose: that corpus is finished and is the same
# fifty-four every year, while these four change every night, so they become ready to be
# found at different times. While this is unset every daily response says
# X-Robots-Tag: noindex and the sitemap does not name them.
# TARGUM_INDEX_DAILY=1

# --- YouTube -------------------------------------------------------------
# Measured on this box on 2026-09-04, in this order, all of it on targum.page
# (Hetzner AS24940, Falkenstein):
#
#   * the same video answered on a laptop and came back "Sign in to confirm you're
#     not a bot" here, so it is the address, not the video and not the binary;
#   * a JavaScript runtime (deno) and a proof-of-origin minter were both installed,
#     and neither helped, together or apart;
#   * every player client failed — tv, tv_simply, web_safari, mweb, web_embedded,
#     android, ios — and so did "Me at the zoo", a 2005 video with no restrictions
#     of any kind, which is the control that rules out anything about the video;
#   * -4 and -6 both failed, so it is the whole address.
#
# YouTube has flagged the range. Nothing that runs *on* the box answers that: the
# fetch has to leave from somewhere else, and this is where that somewhere is named.
# Anything yt-dlp understands works — socks5://127.0.0.1:1080 for a tunnel to a
# machine YouTube already trusts, http://user:pass@host:port for a residential proxy.
#
# Not cookies. Those would be a Google session living on the box, refreshed by hand,
# fetching on behalf of strangers, with a ban as the failure mode. A proxy is an
# egress and nothing else: no account, no identity, nothing to suspend.
#
# Unset on a laptop, whose own address YouTube trusts. Unset on the box means every
# YouTube paste fails at the button, and `targum preflight` says so.
# TARGUM_YTDLP_PROXY=socks5://127.0.0.1:1080

# The proof-of-origin minter (bgutil-pot.service, installed by provision.sh). It does
# not answer the block above and was never going to — a PO token answers "PO token
# required", and the extractor never reaches that stage on a flagged address. Kept
# because it costs nothing and is the right thing to have once an egress exists.
TARGUM_POT_PROVIDER=http://127.0.0.1:4416

# yt-dlp runs deno for YouTube extraction now, and ProtectSystem=strict leaves
# /var/lib/targum as the only writable tree, so the runtime cache cannot live under
# $HOME. Without this it fails in a build rather than at the deploy.
DENO_DIR=/var/lib/targum/cache/deno
